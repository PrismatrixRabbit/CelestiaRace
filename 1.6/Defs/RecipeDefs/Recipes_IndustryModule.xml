<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- ═══ 批 4（一类生产）测试配方：验证效率因子链（Phase 2 T2.1-T2.7）
         workTableSpeedStat 走默认（RecipeDef.cs:490 = WorkTableWorkSpeedFactor）零配置；
         数值占位（B4 模板预设：12 钢→1 零部件 5000 work）═══ -->
    <RecipeDef>
        <defName>Celes_TestRecipe_Component</defName>
        <label>测试组装零部件</label>
        <description>带宽工业系统效率因子测试配方。</description>
        <jobString>正在组装零部件</jobString>
        <workAmount>5000</workAmount>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>12</count>
            </li>
        </ingredients>
        <products>
            <ComponentIndustrial>1</ComponentIndustrial>
        </products>
        <recipeUsers>
            <li>Celes_LabNanoForge</li>
        </recipeUsers>
    </RecipeDef>

    <!-- ═══ 批 5（二类生产）a 模型配方族（视觉修订批 2026-09-30 重构：父类+内容物 ext）═══
         父类承载：jobString/workAmount/soundWorking（培育器同款工作段音）+ 默认内容物（CelesIM_FormingGraphicExt——
         内容物=配方侧定义，本批裁决：父类默认图而非自动显示产物）；li 跨继承追加，消费侧 last-wins=子配方可覆盖；
         均省略 gestationCycles（=0 单周期——布线补丁失效时降级裸 Bill_Autonomous，裁决 R3）；
         无 workSkill（自主产线——品质产物由 PostProcessProduct prefix 品质闸兜底，D1）；
         由 Celes_TestAutoProducer 建筑侧 <recipes> 单侧链接（配方不写 recipeUsers——AllRecipes 两源合并会重复） -->
    <RecipeDef Name="Celes_AutoRecipe_Base" Abstract="True">
        <jobString>正在操作自动生产线</jobString>
        <workAmount>1800</workAmount>
        <soundWorking MayRequire="Ludeon.RimWorld.Biotech">MechGestatorCycle_Initiating</soundWorking>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_FormingGraphicExt">
                <graphic>
                    <texPath>Celes/Building/ShaperNanoForge/ShaperNanoForge_Content</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(5,5)</drawSize>
                </graphic>
            </li>
        </modExtensions>
    </RecipeDef>
    <RecipeDef ParentName="Celes_AutoRecipe_Base">
        <defName>Celes_AutoRecipe_MakeSpacerRifle</defName>
        <label>自动组装星铃步枪</label>
        <description>自动生产线组装星铃制式突击步枪（无品质产物——a 模型基准项）。</description>
        <formingTicks>60000</formingTicks>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>50</count>
            </li>
        </ingredients>
        <products>
            <Celes_Spacer_Rifle>1</Celes_Spacer_Rifle>
        </products>
    </RecipeDef>
    <RecipeDef ParentName="Celes_AutoRecipe_Base">
        <!-- 品质闸对照项：产物 CelesSaberSpacer 经 BaseMeleeWeapon_Sharp_Quality 链带 CompQuality——
             提取时应触发黄字+强制普通品质（D1），控制台无红字；
             内容物临时走产物图轨道（useProductGraphic——覆盖链验证：Forming 期显示军刀本体） -->
        <defName>Celes_AutoRecipe_MakeSaber</defName>
        <label>自动组装星铃军刀</label>
        <description>自动生产线组装星铃军刀（带品质产物——品质闸对照项）。</description>
        <formingTicks>30000</formingTicks>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_FormingGraphicExt">
                <useProductGraphic>true</useProductGraphic>
            </li>
        </modExtensions>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>50</count>
            </li>
        </ingredients>
        <products>
            <CelesSaberSpacer>1</CelesSaberSpacer>
        </products>
    </RecipeDef>

    <!-- ═══ 批 5 U2：b 模型配方族（Pawn 产出，2026-10-02）═══
         判别器=D12（ProducedThingDef.category==Pawn——C# 侧 ThingCategory.Pawn 枚举，非 ThingCategoryDefOf）；
         产物=并行资产批双机械体（ThingDefs_Race/Race_Mech_Celes.xml）；
         多周期语义：周期间=人工工作段（原料总量一次投入全程躺容器，非再装料——Diabolus cycles=12 佐证）；
         内容物双态（方案 A 裁决 10-02）：Forming 期=ext.graphic 半成品图（Celes_HalfGestatedMech，
         母本 HalfGestatedMechSmall 64px 拷贝）→ Formed 后自动切容器内 Pawn 本体图（C# 侧序0+尺寸守卫）；
         ext li 跨继承追加 last-wins 覆盖父类默认图（军刀 useProductGraphic 同机制）；
         原料=Lancer 培育配方母本三料（钢75+玻璃钢75+零部件4——原版 SubcoreRegular 系 Biotech 物品故换零部件；数值占位实测后定稿）；
         cycles：MakeMechTest=2（多周期回环主验证，D20 已知耦合=布线失效红字可见）；
                 MakeMechCleaner=1（单周期对照轨）；均省略 workSkill（Pawn 无品质，品质闸天然放行） -->
    <RecipeDef ParentName="Celes_AutoRecipe_Base">
        <defName>Celes_AutoRecipe_MakeMechTest</defName>
        <label>自动锻造测试机械体</label>
        <description>自动生产线锻造测试机械体（b 模型主验证项——多周期孕育产出活体 Pawn，初始必然携带测试型机械步枪）。</description>
        <jobString>正在锻造测试机械体</jobString>
        <formingTicks>90000</formingTicks>
        <gestationCycles>2</gestationCycles>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_FormingGraphicExt">
                <graphic>
                    <texPath>Celes/Pawn/Mechanoid/Celes_HalfGestatedMech</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(1.3,1.3)</drawSize>
                </graphic>
            </li>
        </modExtensions>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>75</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Plasteel</li>
                    </thingDefs>
                </filter>
                <count>75</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <count>4</count>
            </li>
        </ingredients>
        <products>
            <Celes_MechTest>1</Celes_MechTest>
        </products>
    </RecipeDef>
    
    <RecipeDef ParentName="Celes_AutoRecipe_Base">
        <defName>Celes_AutoRecipe_MakeMechCleaner</defName>
        <label>自动锻造清洁机</label>
        <description>自动生产线锻造轻型清洁机械体（单周期对照轨——非战斗无武装，产出后可执行清扫工作）。</description>
        <jobString>正在锻造清洁机</jobString>
        <formingTicks>60000</formingTicks>
        <gestationCycles>1</gestationCycles>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_FormingGraphicExt">
                <graphic>
                    <texPath>Celes/Pawn/Mechanoid/Celes_HalfGestatedMech</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(0.9,0.9)</drawSize>
                </graphic>
            </li>
        </modExtensions>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>75</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Plasteel</li>
                    </thingDefs>
                </filter>
                <count>75</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <count>4</count>
            </li>
        </ingredients>
        <products>
            <Celes_MechCleaner>1</Celes_MechCleaner>
        </products>
    </RecipeDef>
</Defs>
