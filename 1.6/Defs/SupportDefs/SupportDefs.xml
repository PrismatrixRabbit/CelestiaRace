        <description>武备测试：误差坠落的燃烧性垃圾箱，落地引燃并洒落可燃液体。</description>
        <supportType>CombatEquipment</supportType>
        <unlockLevel>0</unlockLevel>
        <creditCost>80</creditCost>
        <keyCost>0</keyCost>
        <maxTotal>32</maxTotal>
        <arrivalDelayTicks>300</arrivalDelayTicks>
        <landingRule Class="CelesFeature.CelesFD_LandingRule_UniformScatter">
            <radius>3</radius>
        </landingRule>
        <effect Class="CelesFeature.CelesFD_Effect_CrateStrike">
            <fallerDef>CelesFD_Faller_IncendiaryCrate</fallerDef>
        </effect>
        <beamColor>(255, 20, 20, 180)</beamColor>
    </CelesFeature.CelesFD_SupportDef>

    <!-- c：渐进弹幕（3×5 / 排内 0.3s / 排间 1.5s / 格距 5 / 高爆弹幕弹） -->
    <CelesFeature.CelesFD_SupportDef>
        <defName>CelesFD_SupportTestProgressiveBarrage</defName>
        <hasOngoingTimer>true</hasOngoingTimer>
        <uiIcon>Celes/UI/CelesFD_Icons/R_ForwardShell</uiIcon>
        <cooldownTicks>3600</cooldownTicks>
        <label>火力：轨道游走火力网</label>
        <description>武备测试：沿投掷方向的渐进弹幕覆盖。</description>
        <supportType>CombatEquipment</supportType>
        <unlockLevel>1</unlockLevel>
        <creditCost>200</creditCost>
        <keyCost>1</keyCost>
        <maxTotal>32</maxTotal>
        <arrivalDelayTicks>300</arrivalDelayTicks>
        <effect Class="CelesFeature.CelesFD_Effect_ProgressiveBarrage">
            <rows>5</rows>
            <columns>3</columns>
            <sameRowIntervalTicks>18</sameRowIntervalTicks>
            <rowIntervalTicks>90</rowIntervalTicks>
            <cellSpacing>5</cellSpacing>
            <fallerDef>CelesFD_Faller_BarrageShellHE</fallerDef>
        </effect>
        <beamColor>(255, 20, 20, 180)</beamColor>
    </CelesFeature.CelesFD_SupportDef>

    <!-- c：一字烟幕（5 点 / 0.5s 错峰 / 间距 5 / 单点 r7.9） -->
    <CelesFeature.CelesFD_SupportDef>
        <defName>CelesFD_SupportTestSmokeLine</defName>
        <uiIcon>Celes/UI/CelesFD_Icons/R_Smoke</uiIcon>
        <cooldownTicks>1800</cooldownTicks>
        <label>火力：轨道烟幕</label>
        <description>武备测试：沿投掷线垂线方向铺开的烟幕带。</description>
        <supportType>CombatEquipment</supportType>
        <unlockLevel>0</unlockLevel>
        <creditCost>60</creditCost>
        <keyCost>0</keyCost>
        <maxTotal>32</maxTotal>
        <arrivalDelayTicks>300</arrivalDelayTicks>
        <effect Class="CelesFeature.CelesFD_Effect_SmokeLine">
            <dropCount>5</dropCount>
            <intervalTicks>30</intervalTicks>
            <spacing>5</spacing>
            <fallerDef>CelesFD_Faller_SmokePod</fallerDef>
        </effect>
        <beamColor>(255, 20, 20, 180)</beamColor>
    </CelesFeature.CelesFD_SupportDef>

    <!-- c：混杂弹幕（r16.9 ×15 发 ×18 tick 间隔，高爆/燃烧随机） -->
    <CelesFeature.CelesFD_SupportDef>
        <defName>CelesFD_SupportTestMixedBarrage</defName>
        <hasOngoingTimer>true</hasOngoingTimer>
        <uiIcon>Celes/UI/CelesFD_Icons/R_TrashRain</uiIcon>
        <cooldownTicks>3600</cooldownTicks>
        <previewRadius>16.9</previewRadius>
        <label>协议：轨道垃圾雨</label>
        <description>武备测试：大范围随机混杂弹幕覆盖。</description>
        <supportType>CombatEquipment</supportType>
        <unlockLevel>1</unlockLevel>
        <creditCost>300</creditCost>
        <keyCost>2</keyCost>
        <maxTotal>32</maxTotal>
        <arrivalDelayTicks>300</arrivalDelayTicks>
        <effect Class="CelesFeature.CelesFD_Effect_MixedBarrage">
            <radius>16.9</radius>
            <count>15</count>
            <intervalTicks>18</intervalTicks>
            <fallerDefs>
                <li>CelesFD_Faller_ExplosiveCrate</li>
                <li>CelesFD_Faller_IncendiaryCrate</li>
            </fallerDefs>
        </effect>
        <beamColor>(255, 20, 20, 180)</beamColor>
    </CelesFeature.CelesFD_SupportDef>

    <!-- c：定点狙击（2s 瞄准线跟踪 → 末刻 300 伤 / 2.0 锐穿；无目标不射） -->
