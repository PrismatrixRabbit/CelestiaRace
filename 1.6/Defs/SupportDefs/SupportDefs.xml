<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- W-2a：a-1 早期武备空投（基础代码层测试 Def——用户武备清单 2026-09-03）
         字段规格：《12-W2阶段B_批次设计》§2④；数值占位 XML 可调
         旧测试 Def（SupportTestGarbage/SupportTestBombard）已随 W-2a 数据层重构移除（canTargetPawns 废止；
         dev 存档若残留引用将报缺 def 警告，无害） -->
    <CelesFeature.CelesFD_SupportDef>
        <defName>CelesFD_SupportTestWeaponDrop</defName>
        <uiIcon>Celes/UI/CelesFD_Icons/B_BaseGun</uiIcon>
        <cooldownTicks>1800</cooldownTicks>
        <label>拓荒武备空投</label>
        <description>武备测试：精确落位的减速坠落空投舱，落地为可搜刮容器，内含基础武备清单。</description>
        <supportType>CombatEquipment</supportType>
        <unlockLevel>0</unlockLevel>
        <creditCost>50</creditCost>
        <keyCost>0</keyCost>
        <applyDelayHours>0</applyDelayHours>
        <maxTotal>32</maxTotal>
        <arrivalDelayTicks>300</arrivalDelayTicks>
        <!-- 精确落位：信标格本体（无误差） -->
        <landingRule Class="CelesFeature.CelesFD_LandingRule_Exact" />
        <!-- a-1：坠落容器（Decelerate 减速姿态 faller + spawnAll 固定清单） -->
        <effect Class="CelesFeature.CelesFD_Effect_CrateDrop">
            <crateDef>CelesFD_DropCrate_SupportPodStarter</crateDef>
        </effect>
        <!-- 防御型默认色：浅蓝（用户定稿——光柱颜色 XML (r,g,b,a) 0-255） -->
        <beamColor>(135, 206, 250, 242)</beamColor>
    </CelesFeature.CelesFD_SupportDef>

    <CelesFeature.CelesFD_SupportDef>
        <defName>CelesFD_SupportSpaceWeaponDrop</defName>
        <uiIcon>Celes/UI/CelesFD_Icons/B_SpaceGun</uiIcon>
        <cooldownTicks>1800</cooldownTicks>
        <label>制式步枪空投</label>
        <description>武备测试：精确落位的减速坠落空投舱，落地为可搜刮容器，内含制式步枪。</description>
        <supportType>CombatEquipment</supportType>
        <unlockLevel>1</unlockLevel>
        <creditCost>50</creditCost>
        <keyCost>0</keyCost>
        <applyDelayHours>0</applyDelayHours>
        <maxTotal>32</maxTotal>
        <arrivalDelayTicks>300</arrivalDelayTicks>
        <!-- 精确落位：信标格本体（无误差） -->
        <landingRule Class="CelesFeature.CelesFD_LandingRule_Exact" />
        <!-- a-1：坠落容器（Decelerate 减速姿态 faller + spawnAll 固定清单） -->
        <effect Class="CelesFeature.CelesFD_Effect_CrateDrop">
            <crateDef>CelesFD_DropCrate_SpaceWeaponDrop</crateDef>
        </effect>
        <!-- 防御型默认色：浅蓝（用户定稿——光柱颜色 XML (r,g,b,a) 0-255） -->
        <beamColor>(135, 206, 250, 242)</beamColor>
    </CelesFeature.CelesFD_SupportDef>

    <!-- ═══ W-2b：内容测试层支援 Def（用户武备清单；数值占位 XML 可调）═══ -->

    <!-- a-2：定点爆炸性垃圾箱（散射 r2.9 均匀 + 落地爆 4.9 + 血量引信 0.5 + 终结爆 2.9） -->
    <CelesFeature.CelesFD_SupportDef>
        <defName>CelesFD_SupportTestExplosiveCrate</defName>
        <uiIcon>Celes/UI/CelesFD_Icons/R_ExplosiveTrash</uiIcon>
        <cooldownTicks>1800</cooldownTicks>
        <label>协议：摔炮垃圾箱</label>
        <description>武备测试：误差坠落的爆炸性垃圾箱，落地爆炸，受创后进入爆炸倒计时。</description>
        <supportType>CombatEquipment</supportType>
        <unlockLevel>0</unlockLevel>
        <creditCost>80</creditCost>
        <keyCost>0</keyCost>
        <maxTotal>32</maxTotal>
        <arrivalDelayTicks>300</arrivalDelayTicks>
        <landingRule Class="CelesFeature.CelesFD_LandingRule_UniformScatter">
            <radius>3</radius>
        </landingRule>
        <effect Class="CelesFeature.CelesFD_Effect_CrateStrike">
            <fallerDef>CelesFD_Faller_ExplosiveCrate</fallerDef>
        </effect>
        <beamColor>(255, 20, 20, 180)</beamColor>
    </CelesFeature.CelesFD_SupportDef>

    <!-- a-3：定点燃烧性垃圾箱（Flame 落地爆 4.9+先洒燃料；终结爆 2.9 无燃料） -->
