<?xml version="1.0" encoding="utf-8"?>
<Defs>
    
    <ThingDef ParentName="ApparelBase">
        <defName>Celes_ServantCoat</defName>
        <label>侍仆维生装置侍仆防护长袍</label>
        <description>侍仆维生装置穿戴起来极其难受的长袍，附带大量无创体外循环装置，深入喉管的软管会剥夺穿戴者的语言能力。它会提醒穿戴者的身份，并通过不时的电刺激从心理层面驯化穿戴者，减少穿戴者反抗的机会。</description>
        <costStuffCount>80</costStuffCount>
        <techLevel>Industrial</techLevel>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <costList>
            <Steel>50</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
            <Celes_NanoMachine>10</Celes_NanoMachine>
        </costList>
        <graphicData>
            <texPath>Celes/Apparel/Shell/ServantCoat/ServantCoat</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <Mass>0.3</Mass>
            <EquipDelay>15</EquipDelay>
            <MaxHitPoints>200</MaxHitPoints>
            <WorkToMake>9000</WorkToMake>
            <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.6</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.85</StuffEffectMultiplierInsulation_Heat>
        </statBases>
        <equippedStatOffsets>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.45</SlaveSuppressionOffset>
            <ToxicEnvironmentResistance>1.0</ToxicEnvironmentResistance>
        </equippedStatOffsets>
        <apparel>
            <layers>
                <li>Shell</li>
            </layers>
            <useWornGraphicMask>true</useWornGraphicMask>
            <developmentalStageFilter>Adult</developmentalStageFilter>
            <bodyPartGroups>
                <li>UpperHead</li>
                <li>Mouth</li>
                <li>Neck</li>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Celes/Apparel/Shell/ServantCoat/ServantCoat</wornGraphicPath>
            <tags>
                <li>Celes_Servant</li>
            </tags>
            <drawData>
                <defaultData>
                    <layer>83</layer>
                </defaultData>
            </drawData>
            <!--<drawData>
                <dataNorth><layer>40</layer></dataNorth>
            </drawData>-->
            <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
            <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>Celes_NanoImplant_II</researchPrerequisite>
            <recipeUsers>
                <li>ElectricTailoringBench</li>
                <li>HandTailoringBench</li>
                <li>Celes_TailoringTab</li>
            </recipeUsers>
            <displayPriority>301</displayPriority>
        </recipeMaker>
        <thingCategories>
            <li>ApparelMisc</li>
        </thingCategories>
        <comps>
            <li Class="CompProperties_CauseHediff_Apparel">
                <hediff>Celes_ServantCoat</hediff>
                <part>Torso</part>
            </li>
        </comps>
    </ThingDef>

    <HediffDef>
        <defName>Celes_ServantCoat</defName>
        <label>侍仆维生装置侍仆防护长袍</label>
        <description>侍仆维生装置穿戴起来极其难受的长袍，附带大量无创体外循环装置，深入喉管的软管会剥夺穿戴者的语言能力。它会提醒穿戴者的身份，并通过不时的电刺激从心理层面驯化穿戴者，减少穿戴者反抗的机会。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <stages>
            <li>
                <painOffset>0.20</painOffset>
                <hungerRateFactor>0.5</hungerRateFactor>
                <foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
                <statOffsets>
                    <MaxNutrition>1.5</MaxNutrition>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Talking</capacity>
                        <postFactor>0</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_RemoveIfApparelDropped"/>
        </comps>
        <isBad>false</isBad>
    </HediffDef>
    
</Defs>