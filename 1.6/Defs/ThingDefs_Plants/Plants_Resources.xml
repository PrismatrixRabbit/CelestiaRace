<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="PlantBase">
		<defName>Plant_CelesParsnip</defName>
        <label>荧尘防风草</label>
        <description>荧尘防风草是一种被高度基因改造的植物，可以收获「介质凝胶」。\n\n这种植物结合了多种截然不同的生物的基因片段，甚至有些并不来自于古地球，因此无法有效的归类入现存的生物分类体系。其光合组织有着极高的光合效率，容许荧尘防风草有充足的能量自发固氮并从土壤和大气中富集各种物质，在不同的器官合成为复杂的化学前体物质，并最终输送到其肉质根中储存。因此在肥沃的土壤中，它的生长速度会大大加快、</description>
		<descriptionHyperlinks>
			<ThingDef>Celes_BioGel</ThingDef>
		</descriptionHyperlinks>
		<thingClass>CelesFeature.CelesIM_LeaflessImmunePlant</thingClass>
        <statBases>
			<Beauty>2</Beauty>
			<BeautyOutdoors>2</BeautyOutdoors>
            <MaxHitPoints>75</MaxHitPoints>
			<Flammability>0.5</Flammability>
            <Nutrition>0.2</Nutrition>
        </statBases>
        <graphicData>
            <texPath>Celes/Plant/Plant_CelesNano</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <selectable>true</selectable>
        <pathCost>14</pathCost>
        <ingestible/>
        <plant>
			<immatureGraphicPath>Celes/Plant/Plant_CelesNanoImmature</immatureGraphicPath>
			<fertilitySensitivity>1.2</fertilitySensitivity>
			<growDays>5</growDays>
			<sowWork>540</sowWork>
			<dieIfLeafless>false</dieIfLeafless>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>Celes_BioGel</harvestedThingDef>
			<harvestYield>9</harvestYield>
			<neverBlightable>true</neverBlightable>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
			<!--<sowMinSkill>2</sowMinSkill>-->
			<sowResearchPrerequisites>
				<li>Celes_Plant_I</li>
			</sowResearchPrerequisites>
			<topWindExposure>0.1</topWindExposure>
            <visualSizeRange>0.6~1.05</visualSizeRange>
            <wildOrder>2</wildOrder>
			<pollution>Any</pollution>
			<fertilityMin>0.7</fertilityMin>
        </plant>
    </ThingDef>
</Defs>