<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <DamageDef ParentName="Bullet">
        <defName>Celes_ParticleBurn</defName>
        <label>粒子灼伤</label>
        <deathMessage>{0} has been pierced by a focused particle beam.</deathMessage>
        <impactSoundType>Bullet</impactSoundType>
        <hediff>Celes_ParticleBurn</hediff>
        <armorCategory>Sharp</armorCategory>
        <canUseDeflectMetalEffect>true</canUseDeflectMetalEffect>
        <hasForcefulImpact>false</hasForcefulImpact>
        <buildingDamageFactorImpassable>1.5</buildingDamageFactorImpassable>
        <buildingDamageFactorPassable>1.0</buildingDamageFactorPassable>
        <plantDamageFactor>2</plantDamageFactor>
        <modExtensions>
            <li Class="CelesFeature.Celes_DamageExtension_ExtraDamages">
                <extraDamages>
                    <li>
                        <def>Burn</def>
                        <amount>8</amount>
                        <chance>1.0</chance>
                    </li>
                </extraDamages>
            </li>
        </modExtensions>
    </DamageDef>

    <DamageDef ParentName="Bullet">
        <defName>Celes_ParticleBlast</defName>
        <label>粒子冲击</label>
        <deathMessage>{0} has been pulverized by a particle shockwave.</deathMessage>
        <impactSoundType>Bullet</impactSoundType>
        <hediff>Celes_ParticleBlast</hediff>
        <armorCategory>Blunt</armorCategory>
        <hasForcefulImpact>true</hasForcefulImpact>
        <buildingDamageFactorImpassable>2</buildingDamageFactorImpassable>
        <buildingDamageFactorPassable>1.5</buildingDamageFactorPassable>
        <plantDamageFactor>2</plantDamageFactor>
        <modExtensions>
            <li Class="CelesFeature.Celes_DamageExtension_ExtraDamages">
                <extraDamages>
                    <li>
                        <def>Burn</def>
                        <amount>4</amount>
                        <chance>1.0</chance>
                    </li>
                </extraDamages>
            </li>
        </modExtensions>
        <additionalHediffs>
            <li>
                <hediff>Celes_IrradiatedSoftening</hediff>
                <severityPerDamageDealt>0.003</severityPerDamageDealt>
            </li>
        </additionalHediffs>
    </DamageDef>
    
    <DamageDef ParentName="Bullet">
        <defName>Celes_BulletRadiation</defName>
        <modExtensions>
            <li Class="CelesFeature.Celes_DamageExtension_ExtraDamages">
                <extraDamages>
                    <li>
                        <def>Burn</def>
                        <amount>8</amount>
                        <armorPenetration>2.0</armorPenetration>
                        <chance>0.8</chance>
                    </li>
                </extraDamages>
            </li>
        </modExtensions>
        <label>radioactive plasma projectile</label>
        <deathMessage>{0} was shot by high-energy plasma.</deathMessage>
        <additionalHediffs>
            <li>
                <hediff>CelesRadiation</hediff>
                <severityPerDamageDealt>0.005</severityPerDamageDealt>
                <inverseStatScaling>true</inverseStatScaling>
                <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
            </li>
        </additionalHediffs>
        <impactSoundType>Bullet</impactSoundType>
    </DamageDef>
    
    <DamageDef ParentName="Bullet">
        <defName>Celes_Particle</defName>
        <label>polarised particle projectile</label>
        <deathMessage>{0} was shot by a polarised particle.</deathMessage>
        <impactSoundType>Bullet</impactSoundType>
        <buildingDamageFactorImpassable>3</buildingDamageFactorImpassable>
        <buildingDamageFactorPassable>1.5</buildingDamageFactorPassable>
        <plantDamageFactor>3</plantDamageFactor>
        <modExtensions>
            <li Class="CelesFeature.Celes_DamageExtension_ExtraDamages">
                <extraDamages>
                    <li>
                        <def>Burn</def>
                        <amount>8</amount>
                        <armorPenetration>2.0</armorPenetration>
                        <chance>0.8</chance>
                    </li>
                </extraDamages>
            </li>
        </modExtensions>
        <additionalHediffs>
            <li>
                <hediff>CelesRadiation</hediff>
                <severityPerDamageDealt>0.005</severityPerDamageDealt>
                <inverseStatScaling>true</inverseStatScaling>
                <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
            </li>
        </additionalHediffs>
    </DamageDef>

    <DamageDef ParentName="Bullet">
        <defName>Celes_MassiveParticle</defName>
        <modExtensions>
            <li Class="CelesFeature.Celes_DamageExtension_ExtraDamages">
                <extraDamages>
                    <li>
                        <def>Burn</def>
                        <amount>8</amount>
                        <armorPenetration>2.0</armorPenetration>
                        <chance>0.8</chance>
                    </li>
                </extraDamages>
            </li>
        </modExtensions>
        <label>massive polarised particle projectile</label>
        <deathMessage>{0} was shot by a polarised particle.</deathMessage>
