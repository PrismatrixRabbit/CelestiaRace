<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ResourceBase" Name="Celes_CargoBase" Abstract="True">
        <thingClass>CelesFeature.CelesIM_CargoCrate</thingClass>
        <stackLimit>5</stackLimit>
        <thingCategories>
            <li>Celes_Cargo</li>
        </thingCategories>
        <!--<comps>
            <li Class="CelesFeature.CelesIM_CompProperties_Cargo">
                <openTicks>100</openTicks>
            </li>
        </comps>-->
    </ThingDef>

    <ThingDef ParentName="Celes_CargoBase">
        <defName>Celes_CargoEmpty</defName>
        <label>空货组箱子</label>
        <description>一箱空的星铃规范货组箱子。通常……没什么用。</description>
        <graphicData>
            <texPath>Celes/Item/Cargo/Cargo_Empty</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MarketValue>3</MarketValue>
            <MaxHitPoints>75</MaxHitPoints>
            <Mass>0.5</Mass>
            <Flammability>0.5</Flammability>
            <DeteriorationRate>2.0</DeteriorationRate>
            <WorkToMake>30</WorkToMake>
        </statBases>
        <!-- 3白银 -->
    </ThingDef>

    <ThingDef ParentName="Celes_CargoBase">
        <defName>Celes_CargoMaterial</defName>
        <label>预制建材货组</label>
        <description>一箱星铃规范的材料，内含被切割加工成特定形制的某种资源，通常用于和星铃外勤部交易。</description>
        <graphicData>
            <texPath>Celes/Item/Cargo/Cargo_Material</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <Mass>50</Mass>
            <Flammability>0</Flammability>
            <DeteriorationRate>1.0</DeteriorationRate>
            <WorkToMake>600</WorkToMake>
        </statBases>
        <costStuffCount>60</costStuffCount>
        <stuffCategories>
            <li>Metallic</li>
            <li>Woody</li>
            <li>Stony</li>
        </stuffCategories>
        <!-- 钢铁：116白银 木：74白银 石质：56白银 -->
    </ThingDef>

    <ThingDef ParentName="Celes_CargoBase">
        <defName>Celes_CargoFabricMaterial</defName>
        <label>荒地营宿货组</label>
        <description>一箱装有大量特定织物的货组，带有少量用于支撑的刚性材料。通常用于和星铃外勤部交易。</description>
        <graphicData>
            <texPath>Celes/Item/Cargo/Cargo_FabricMaterial</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <Mass>10</Mass>
            <Flammability>0.5</Flammability>
            <DeteriorationRate>2.0</DeteriorationRate>
            <WorkToMake>800</WorkToMake>
        </statBases>
        <costStuffCount>150</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
    </ThingDef>

    <ThingDef ParentName="Celes_CargoBase">
        <defName>Celes_CargoComponent</defName>
        <label>维护工具货组</label>
        <description>一箱维护工具文案之后写！</description>
        <graphicData>
            <texPath>Celes/Item/Cargo/Cargo_Component</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MarketValue>250</MarketValue>
            <MaxHitPoints>70</MaxHitPoints>
            <Mass>13</Mass>
            <Flammability>0.5</Flammability>
            <DeteriorationRate>2</DeteriorationRate>
            <WorkToMake>800</WorkToMake>
        </statBases>
        <costList>
            <ComponentIndustrial>5</ComponentIndustrial>
            <Steel>20</Steel>
        </costList>
        <!-- 市价=细算201上浮至250（零部件稀缺面板溢价，用户裁决）；Mass=钢10+零部件3+箱0.5 -->
    </ThingDef>

    <ThingDef ParentName="Celes_CargoBase">
        <defName>Celes_CargoFood</defName>
        <label>预制食品货组</label>
        <description>文案之后写！</description>
        <graphicData>
            <texPath>Celes/Item/Cargo/Cargo_Food</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MarketValue>210</MarketValue>
            <MaxHitPoints>50</MaxHitPoints>
            <Mass>4.5</Mass>
            <Flammability>0.5</Flammability>
            <DeteriorationRate>0.25</DeteriorationRate>
            <WorkToMake>4500</WorkToMake>
        </statBases>
        <!-- 市价=10份精致餐(20)上浮（用户裁决210）；Deter/HP对位包装生存食品实测(0.25/50)；Mass按最大配方6.75营养=135块×0.03+箱 -->
    </ThingDef>

    <ThingDef ParentName="Celes_CargoBase">
        <defName>Celes_CargoFoodSp</defName>
        <label>油边烤肉货组</label>
        <description>文案之后写！</description>
        <graphicData>
            <texPath>Celes/Item/Cargo/Cargo_FoodSp</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <healthAffectsPrice>false</healthAffectsPrice>
        <tickerType>Rare</tickerType>
        <statBases>
            <MarketValue>300</MarketValue>
            <MaxHitPoints>50</MaxHitPoints>
            <Mass>3</Mass>
            <Flammability>2.0</Flammability>
            <DeteriorationRate>6</DeteriorationRate>
            <WorkToMake>3200</WorkToMake>
        </statBases>
        <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>2</daysToRotStart>
                <rotDestroys>true</rotDestroys>
            </li>
        </comps>
        <!-- 生鲜货组：Rottable三件套对位肉族（2天起腐/腐烂销毁/Rare tick）；市价=肉奢侈160+辅料61=231→溢价300（用户裁决） -->
    </ThingDef>

    <ThingDef ParentName="Celes_CargoBase">
        <defName>Celes_CargoFuel</defName>
        <label>涡轮燃油货组</label>
        <description>文案之后写！</description>
        <graphicData>
            <texPath>Celes/Item/Cargo/Cargo_Fuel</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <healthAffectsPrice>false</healthAffectsPrice>
        <tickerType>Normal</tickerType>
        <statBases>
            <MarketValue>91</MarketValue>
            <MaxHitPoints>50</MaxHitPoints>
            <Mass>7</Mass>
            <Flammability>2.0</Flammability>
            <DeteriorationRate>1</DeteriorationRate>
            <WorkToMake>700</WorkToMake>
        </statBases>
        <costList>
            <Chemfuel>30</Chemfuel>
            <Steel>10</Steel>
        </costList>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>1.1</explosiveRadius>
                <explosiveDamageType>Flame</explosiveDamageType>
                <explosiveExpandPerStackcount>0.037</explosiveExpandPerStackcount>
                <startWickOnDamageTaken>
                    <li>Flame</li>
                </startWickOnDamageTaken>
                <startWickHitPointsPercent>0.333</startWickHitPointsPercent>
                <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
                <preExplosionSpawnChance>1</preExplosionSpawnChance>
                <wickTicks>70~150</wickTicks>
            </li>
        </comps>
        <!-- 危险品：爆炸comp全套对位原版化合燃料（受创引信70~150tick后爆燃，堆叠扩半径） -->
    </ThingDef>

