    <!-- RTPV 换能组件（RTG）：FD 专属获取、消耗即固化——无制造配方、不可拆解；
         仅作为同位素发电机建造材料 -->
    <ThingDef ParentName="ResourceBase">
        <defName>Celes_RTPVTransducer</defName>
        <label>外勤部RTPV换能组件</label>
        <description>来自星铃外勤部的RTPV换能组件。\n\n热光伏同位素电池(Radioisotope Thermophotovoltaic，RTPV)是一种核电池。用放射性同位素衰变产生的热量作热源，通过热辐射光伏电池的方式把热能直接转换成电能。</description>
        <possessionCount>2</possessionCount>
        <graphicData>
            <!-- TODO:贴图待填（现用晶格运算元件图占位） -->
            <texPath>Celes/Item/Utility/RTPVTransducer/RTPVTransducer</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Standard_Drop</soundDrop>
        <!-- TODO:堆叠上限占位（实测定稿） -->
        <stackLimit>1</stackLimit>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <MarketValue>1600</MarketValue>
            <Mass>15</Mass>
            <Flammability>0</Flammability>
            <DeteriorationRate>1</DeteriorationRate>
        </statBases>
        <intricate>true</intricate>
        <thingCategories>
            <li>Celes_Manufactured</li>
        </thingCategories>
    </ThingDef>

    <!-- ========== 星铃机控 ========== -->

    <ThingDef MayRequire="Ludeon.RimWorld.Biotech">
        <defName>Celes_MechlinkAuthorization</defName>
        <label>民用机控限制骇入器</label>
        <description>利用在边缘世界发现的机控中枢，结合尘构机械制成的骇入器。用于强行解除星铃被设置于硬件层面的机控限制，并更新为星铃标准机控。</description>

        <thingClass>ThingWithComps</thingClass>
        <category>Item</category>
        <drawerType>MapMeshOnly</drawerType>
        <techLevel>Spacer</techLevel>
        <useHitPoints>true</useHitPoints>
        <pathCost>14</pathCost>
        <selectable>true</selectable>
        <altitudeLayer>Item</altitudeLayer>
        <tickerType>Never</tickerType>
        <alwaysHaulable>true</alwaysHaulable>
        <resourceReadoutPriority>Middle</resourceReadoutPriority>
        <thingCategories>
            <li>BodyPartsMechtech</li>
        </thingCategories>

        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <Beauty>-2</Beauty>
            <Mass>1</Mass>
            <MarketValue>500</MarketValue>
            <DeteriorationRate>0</DeteriorationRate>
        </statBases>
        <graphicData>
            <texPath>Celes/Item/MechlinkAuthorization/MechlinkAuthorization</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.0</drawSize>
        </graphicData>

        <comps>
            <li Class="CompProperties_Forbiddable"/>

            <li Class="CompProperties_Usable">
                <useJob>Celes_RemoveMechlinkRestriction</useJob>
                <useLabel>覆写民用机控限制</useLabel>
            </li>

            <li Class="CelesFeature.Celes_CompProperties_RemoveMechlinkRestriction">
                <requisiteHediffs>
                    <li>MechlinkImplant</li>
                    <li>Celes_MechlinkRestriction</li>
                </requisiteHediffs>
                <hediffToRemove>Celes_MechlinkRestriction</hediffToRemove>
                <hediffToAdd>Celes_StandardMechlink</hediffToAdd>
                <bodyPart>Brain</bodyPart>
                <letterDef>PositiveEvent</letterDef>
                <letterLabel>民用机控限制已覆写: {PAWN_labelShort}</letterLabel>
                <letterText>{PAWN} 的民用机控限制已被覆写为星铃标准机控链接。</letterText>
            </li>

            <li Class="CompProperties_UseEffectPlaySound">
                <soundOnUsed>MechlinkInstalled</soundOnUsed>
            </li>

            <li Class="CompProperties_UseEffectDestroySelf" />
        </comps>
    </ThingDef>

    <!-- ========== 星铃STC ========== -->
    
    <ThingDef Name="Celes_STCResourceBase" ParentName="ResourceBase" Abstract="True">
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Standard_Drop</soundDrop>
        <stackLimit>10</stackLimit>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <MarketValue>500</MarketValue>
            <Mass>1</Mass>
            <Flammability>0.25</Flammability>
            <DeteriorationRate>2.0</DeteriorationRate>
        </statBases>
        <intricate>true</intricate>
        <thingCategories>
            <li>Manufactured</li>
        </thingCategories>
        <isTechHediff>true</isTechHediff>
    </ThingDef>

	<ThingDef ParentName="Celes_STCResourceBase">
		<defName>Celes_STCLock</defName>
		<label>未解析的自译解技术核心</label>
		<description>这是一个尚未解析的自译解技术核心，需要解析为特定项目才能使用。\n\n一种被称为＂自译解技术核心＂的，来自星铃＂领航计划＂的极端先进技术教学装置，形态多变，但大多有多种明显的接口。在边缘世界极其少见，似乎大多数都被星铃科考队严加保管。\n\n从大脑链接到全息投影，这一装置旨在向任何具有智能的生物个体解释星铃的科技并指导他将其付诸实践。而奇怪的，部分蜂群思维式生物无法使用和理解这一设备教导的知识。尚不清楚星铃出于什么理由制造了这一装置，但它确实有助于使用者解锁进一步的星铃科技。</description>
		<descriptionHyperlinks>
			<ThingDef>Celes_STC_MainTech_III</ThingDef>
			<RecipeDef>Parse_CelesSTC_MainTech_III</RecipeDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Celes/Item/Utility/Celes_STCLock/Celes_STCLock</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<Flammability>0</Flammability>
		</statBases>
	</ThingDef>

	<RecipeDef>
		<defName>Parse_CelesSTC_MainTech_III</defName>
		<label>尘构技术解译</label>
		<description>尘构技术解译。</description>
		<jobString>尘构技术解译</jobString>
		<uiIconThing>Celes_STC_MainTech_III</uiIconThing>
		<workAmount>10000</workAmount>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Smelt</soundWorking>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<li>Celes_LabNanoForge</li>
		</recipeUsers>
		<!--<researchPrerequisite>Celes_MainTech_I</researchPrerequisite>-->
		<skillRequirements>
			<Crafting>4</Crafting>
			<Intellectual>6</Intellectual>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Celes_STCLock</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Celes_NanoMachine</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<products>
			<Celes_STC_MainTech_III>1</Celes_STC_MainTech_III>
		</products>
	</RecipeDef>

	<ThingDef ParentName="Celes_STCResourceBase">
        <defName>Celes_STC_MainTech_III</defName>
        <label>自译解技术核心（尘构技术解译）</label>
        <description>这是关于星铃研究项目＂尘构技术解译＂的自译解技术核心。\n\n一种被称为＂自译解技术核心＂的，来自星铃＂领航计划＂的极端先进技术教学装置，形态多变，但大多有多种明显的接口。在边缘世界极其少见，似乎大多数都被星铃科考队严加保管。\n\n从大脑链接到全息投影，这一装置旨在向任何具有智能的生物个体解释星铃的科技并指导他将其付诸实践。而奇怪的，部分蜂群思维式生物无法使用和理解这一设备教导的知识。尚不清楚星铃出于什么理由制造了这一装置，但它确实有助于使用者解锁进一步的星铃科技。\n\n尘构技术解译\n\n破译并研究星铃的独特技术之一——尘构技术，一种基于控制论的可编程增强纳米机械。解锁适用于边缘世界的尘构应急生产方式，并开启真正的标准星铃技术。</description>
		<descriptionHyperlinks>
			<ThingDef>Celes_STCLock</ThingDef>
			<RecipeDef>Parse_CelesSTC_MainTech_III</RecipeDef>
		</descriptionHyperlinks>
        <graphicData>
            <texPath>Celes/Item/Utility/Celes_STC/Celes_STC</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <Flammability>0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_CompAnalyzableUnlockResearch">
                <analysisID>1383328672</analysisID>
                <requiresMechanitor>false</requiresMechanitor>

                <!-- Analyzable -->

                <analysisDurationHours>0.5</analysisDurationHours>
                <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
                <completedLetterLabel>Signal chip studied: {RESEARCH} unlocked</completedLetterLabel>
                <completedLetter>By studying the signal chip, {PAWN_labelShort} has acquired the insight needed for the research project(s) {RESEARCH}.\n\nYour researchers can now use research benches to begin researching how to actually use the technology.</completedLetter>
                <completedLetterDef>PositiveEvent</completedLetterDef>

                <!-- Interactable -->

                <activateTexPath>UI/Icons/Study</activateTexPath>

                <activateLabelString>Analyze...</activateLabelString>
                <activateDescString>Analyze the signal chip.</activateDescString>
                <jobString>Analyze signal chip</jobString>
                <guiLabelString>Choose who should analyze this</guiLabelString>
                <inspectString>Can be analyzed by a colonist.</inspectString>

                <targetingParameters>
                    <canTargetBuildings>false</canTargetBuildings>
                    <canTargetAnimals>false</canTargetAnimals>
                    <canTargetMechs>false</canTargetMechs>
                    <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
                </targetingParameters>
            </li>
        </comps>
    </ThingDef>
    
</Defs>