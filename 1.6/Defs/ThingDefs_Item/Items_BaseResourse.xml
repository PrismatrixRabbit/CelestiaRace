    <ThingDef ParentName="ResourceBase"><!-- 晶化尘构单元 -->
        <defName>Celes_NanoMachine</defName>
        <label>晶态尘构单元</label>
        <description>处于基准态的，名为尘构的分子机械。\n\n本质是一种模块化，受限再编程性的纳米级工具组。晶化基准形态为尘构组成的便于输运的长程有序结构，使用时通过外源场控注入预设指令。尘构物质可以简单理解为外源编码的硅-碳基FPGA单元。基础功能包括但不限于靶向物质输送、分子级物质排列、组装与修复（包括有限的自组装）、分布式传感器和信息转译。</description>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Celes/Item/DustMech/NanoMachine</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
            <drawSize>0.85</drawSize>
        </graphicData>
        <stackLimit>75</stackLimit>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <MarketValue>42</MarketValue>
            <Mass>0.01</Mass>
            <Flammability>0</Flammability>
            <DeteriorationRate>0.1</DeteriorationRate>
        </statBases>
        <intricate>true</intricate> <!-- Not returned to player when product made of this is smelted. -->
        <thingCategories>
            <li>Celes_Manufactured</li>
        </thingCategories>
        <tradeTags>
            <li>Celes_TradeBase</li>
        </tradeTags>
    </ThingDef>

