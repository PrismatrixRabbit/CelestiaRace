    <ThingDef ParentName="ResourceBase"><!-- 尘晶碎片 --><!-- 贴图未更新 -->
        <defName>Celes_CrystallineMaterial</defName>
        <label>尘晶碎片</label>
        <description>尘晶碎片是破碎尘晶后得到的结构化晶态物质，本身也能归类为尘构，但通常作为其他尘构单元的复制原料。储存了大量复制尘构物质所需的前体物质。\n\n对尘晶碎片微观结构的解析是开启尘构技术研究的关键一步。</description>
        <descriptionHyperlinks>
            <ThingDef>Celes_InitialCrystalCluster</ThingDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Celes/Item/DustMech/CrystallineMaterial</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
            <drawSize>0.90</drawSize>
        </graphicData>
        <stackLimit>150</stackLimit>
        <useHitPoints>false</useHitPoints>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MarketValue>3</MarketValue>
            <Mass>0.5</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <thingCategories>
            <li>Celes_Manufactured</li>
        </thingCategories>
        
        <comps>
            <li Class="CompProperties_CompAnalyzableUnlockResearch">
                <analysisID>356174224</analysisID>
                <requiresMechanitor>false</requiresMechanitor>

                <!-- Analyzable -->

                <analysisDurationHours>0.5</analysisDurationHours>
                <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
                <completedLetterLabel>尘晶解析完毕:解锁{RESEARCH}</completedLetterLabel>
                <completedLetter>通过解析尘晶碎片的微观结构, {PAWN_labelShort}获得了研究{RESEARCH}所必须的知识。\n\n你的研究者现在可以使用研究台开始学习如何实际应用这项科技。</completedLetter>
                <completedLetterDef>PositiveEvent</completedLetterDef>

                <!-- Interactable -->

                <activateTexPath>UI/Icons/Study</activateTexPath>

                <activateLabelString>解析中...</activateLabelString>
                <activateDescString>正在解析尘晶碎片.</activateDescString>
                <jobString>解析尘晶碎片</jobString>
                <guiLabelString>选择一位殖民者解析尘晶</guiLabelString>
                <inspectString>可以被殖民者解析.</inspectString>

                <targetingParameters>
                    <canTargetBuildings>false</canTargetBuildings>
                    <canTargetAnimals>false</canTargetAnimals>
                    <canTargetMechs>false</canTargetMechs>
                    <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
                </targetingParameters>
            </li>
        </comps>
    </ThingDef>
    
