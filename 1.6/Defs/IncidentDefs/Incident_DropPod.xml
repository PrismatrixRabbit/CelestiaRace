<?xml version="1.0" encoding="utf-8"?>
<Defs>
  
  <!-- 轨道垃圾箱事件族（2026-10-24 裁决）：5 事件共享 refireCheckTags=CelesOrbitDropTrash——
       家族内任一触发 → minRefireDays=30 天内全族被 FiredTooRecently 拦截（退出候选池，同时消除池收缩放大）。
       baseChance 总预算 1.0（本次等比缩放合计 0.8：原 0.8/0.5/0.5/0.1/0.3 → 0.29/0.18/0.18/0.04/0.11）。
       调整时保持等比缩放，勿单点调高。 -->
  <!-- 事件：普通（同原版货舱坠毁 ResourcePodCrash baseChance=1.0，概率略低 20%） -->
  <IncidentDef>
    <defName>CelesFD_NormalOrbitDropTrash</defName>
    <label>星铃轨道垃圾箱坠落</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CelesFeature.CelesFD_IncidentWorker_OrbitDrop</workerClass>
    <baseChance>0.29</baseChance>
    <minRefireDays>30</minRefireDays>
    <tags>
      <li>CelesOrbitDropTrash</li>
    </tags>
    <refireCheckTags>
      <li>CelesOrbitDropTrash</li>
    </refireCheckTags>
    <letterDef>NeutralEvent</letterDef>
    <letterLabel>星铃轨道垃圾箱坠落</letterLabel>
    <letterText>星铃轨道垃圾箱坠落在您的殖民地附近。其中或许有些有用的物资。</letterText>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropExtension">
        <crates>
          <!-- W-2a-fix 拆分（2026-09-03）：TrashNormal → 散货版 + 建筑版（原 2~5 混合 → 等量对半，占位待实测定稿） -->
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalThing</crateDef>
            <countRange>1~2</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalBuilding</crateDef>
            <countRange>1~2</countRange>
          </li>
        </crates>
      </li>
    </modExtensions>
  </IncidentDef>

  <!-- 事件：大量 -->
  <IncidentDef>
    <defName>CelesFD_HugeOrbitDropTrash</defName>
    <label>大量星铃轨道垃圾箱坠落</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CelesFeature.CelesFD_IncidentWorker_OrbitDrop</workerClass>
    <baseChance>0.18</baseChance>
    <minRefireDays>30</minRefireDays>
    <tags>
      <li>CelesOrbitDropTrash</li>
    </tags>
    <refireCheckTags>
      <li>CelesOrbitDropTrash</li>
    </refireCheckTags>
    <letterDef>PositiveEvent</letterDef>
    <letterLabel>星铃轨道垃圾箱坠落</letterLabel>
    <letterText>大量星铃轨道垃圾箱坠落在您的殖民地附近。其中或许有些有用的物资。</letterText>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropExtension">
        <crates>
          <!-- W-2a-fix 拆分：原 7~13 混合 → 等量对半（占位） -->
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalThing</crateDef>
            <countRange>3~6</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalBuilding</crateDef>
            <countRange>3~6</countRange>
          </li>
        </crates>
      </li>
    </modExtensions>
  </IncidentDef>

  <!-- 事件：危险（概率略低 50%） -->
  <IncidentDef>
    <defName>CelesFD_DangerOrbitDropTrash</defName>
    <label>星铃轨道垃圾箱坠落</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CelesFeature.CelesFD_IncidentWorker_OrbitDrop</workerClass>
    <baseChance>0.18</baseChance>
    <minRefireDays>30</minRefireDays>
    <tags>
      <li>CelesOrbitDropTrash</li>
    </tags>
    <refireCheckTags>
      <li>CelesOrbitDropTrash</li>
    </refireCheckTags>
    <letterDef>NeutralEvent</letterDef>
    <letterLabel>星铃轨道垃圾箱坠落</letterLabel>
    <letterText>星铃轨道垃圾箱坠落在您的殖民地附近。请谨慎处理其中的内容物。</letterText>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropExtension">
        <crates>
          <!-- W-2a-fix 拆分：原 1~2 混合 → 等量对半（占位） -->
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalThing</crateDef>
            <countRange>1~1</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalBuilding</crateDef>
            <countRange>1~1</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashDanger</crateDef>
