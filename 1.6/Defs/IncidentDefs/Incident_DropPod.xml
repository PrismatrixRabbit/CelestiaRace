  <!-- 事件：神秘 -->
  <IncidentDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>CelesFD_MysteryOrbitDropTrash</defName>
    <label>星铃轨道垃圾箱坠落</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CelesFeature.CelesFD_IncidentWorker_OrbitDrop</workerClass>
    <baseChance>0.04</baseChance>
    <minRefireDays>30</minRefireDays>
    <tags>
      <li>CelesOrbitDropTrash</li>
    </tags>
    <refireCheckTags>
      <li>CelesOrbitDropTrash</li>
    </refireCheckTags>
    <letterDef>NegativeEvent</letterDef>
    <letterLabel>星铃轨道垃圾箱坠落</letterLabel>
    <letterText>星铃轨道垃圾箱坠落在您的殖民地附近。氛围不对……</letterText>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropExtension">
        <crates>
          <!-- W-2a-fix 拆分：原 1~1 混合 → 等量对半（0~1 占位——50/50 近似） -->
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalThing</crateDef>
            <countRange>0~1</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalBuilding</crateDef>
            <countRange>0~1</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashDanger</crateDef>
            <countRange>1~3</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashMystery</crateDef>
            <countRange>1~1</countRange>
          </li>
        </crates>
      </li>
    </modExtensions>
  </IncidentDef>

  <!-- 事件：晶体（概率略低 50%） -->
  <IncidentDef>
    <defName>CelesFD_CrystalOrbitDrop</defName>
    <label>星铃轨道垃圾箱坠落（晶体）</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CelesFeature.CelesFD_IncidentWorker_OrbitDrop</workerClass>
    <baseChance>0.11</baseChance>
    <minRefireDays>30</minRefireDays>
    <tags>
      <li>CelesOrbitDropTrash</li>
    </tags>
    <refireCheckTags>
      <li>CelesOrbitDropTrash</li>
    </refireCheckTags>
    <letterDef>NegativeEvent</letterDef>
    <letterLabel>星铃轨道垃圾箱坠落（晶体）</letterLabel>
    <letterText>检测到星铃轨道晶体坠落的信号。这些晶体对星铃外勤部而言有着特殊价值。</letterText>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropExtension">
        <crates>
          <!-- W-2a-fix 拆分：原 1~2 混合 → 等量对半（占位） -->
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalThing</crateDef>
            <countRange>1~1</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_TrashNormalBuilding</crateDef>
            <countRange>1~1</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_Crystal</crateDef>
            <countRange>3~5</countRange>
          </li>
        </crates>
      </li>
    </modExtensions>
  </IncidentDef>


  <!-- ═══ 开局任务链事件 1：初始晶体坠落（2026-08-25） ═══
       触发 = 叙事者 SingleMTB（Storyteller.xml）+ earliestDay=7；baseChance=0 防随机池；Worker 内置位 CrystalEventTick（道歉信 3700 起算）。
       2026-09-20 修正认知（玩家反馈 forced 连发）："全局一次"不再由 minRefireDays=99999 保证——其记录按地图存于
       StoryState 且 forced 派发不写记录（StoryState.Notify_IncidentFired 实证；叙事者倍率类 mod 以 forced 派发 → 连发）。
       全局一次 = Worker 执行体自查 GameComponent.CrystalEventTriggered（含 gc 存在性双闸，forced 亦受辖）；
       minRefireDays=99999 保留作 per-map 兜底；派系门禁见 Worker（缺失时不进池/不执行，含全部轨道坠落事件） -->
  <IncidentDef>
    <defName>CelesFD_InitialCrystalOrbitDrop</defName>
    <label>星铃轨道晶体坠落</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CelesFeature.CelesFD_IncidentWorker_OrbitDrop</workerClass>
    <baseChance>0</baseChance>
    <earliestDay>7</earliestDay>
    <minRefireDays>99999</minRefireDays>
    <letterDef>NegativeEvent</letterDef>
    <letterLabel>星铃轨道晶体坠落</letterLabel>
    <letterText>检测到星铃轨道晶体坠落的信号。其中包含着相当高价值的晶体。</letterText>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropExtension">
        <crates>
          <li>
            <crateDef>CelesFD_DropCrate_Crystal</crateDef>
            <countRange>5~6</countRange>
          </li>
          <li>
            <crateDef>CelesFD_DropCrate_InitialCrystal</crateDef>
            <countRange>1~1</countRange>
          </li>
        </crates>
      </li>
    </modExtensions>
  </IncidentDef>
</Defs>
