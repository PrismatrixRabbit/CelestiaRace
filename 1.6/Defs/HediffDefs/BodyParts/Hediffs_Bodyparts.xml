<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ========== 假耳朵 ========= -->

    <HediffDef ParentName="AddedBodyPartBase">
        <defName>Celes_FakeEar</defName>
        <label>伪耳假兔耳假兔耳</label>
        <labelNoun>假兔耳</labelNoun>
        <description>一个用于星铃的，已经安装的用布做的假兔耳，包括一个人工耳蜗和铁丝制成的布料外框。并不能恢复星铃复杂的听力系统，布做的耳朵看着也非常糟糕，但总比完全失聪要好。一个用于星铃的用布做的假兔耳，包括一个人工耳蜗和铁丝制成的布料外框。并不能恢复星铃复杂的听力系统，布做的耳朵看着也非常糟糕，但总比完全失聪要好。</description>
        <descriptionHyperlinks><ThingDef>Celes_FakeEar</ThingDef></descriptionHyperlinks>
        <spawnThingOnRemoved>Celes_FakeEar</spawnThingOnRemoved>
        <addedPartProps>
            <solid>true</solid>
            <partEfficiency>0.65</partEfficiency>
        </addedPartProps>
        <stages>
            <li>
                <statOffsets>
                    <PawnBeauty>-1</PawnBeauty>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <ThingDef ParentName="BodyPartProstheticMakeableBase">
        <defName>Celes_FakeEar</defName>
        <label>伪耳假兔耳假兔耳</label>
        <description>一个用于星铃的，已经安装的用布做的假兔耳，包括一个人工耳蜗和铁丝制成的布料外框。并不能恢复星铃复杂的听力系统，布做的耳朵看着也非常糟糕，但总比完全失聪要好。一个用于星铃的用布做的假兔耳，包括一个人工耳蜗和铁丝制成的布料外框。并不能恢复星铃复杂的听力系统，布做的耳朵看着也非常糟糕，但总比完全失聪要好。</description>
        <descriptionHyperlinks><RecipeDef>Celes_InstallFakeEar</RecipeDef></descriptionHyperlinks>
        <costList>
            <Cloth>20</Cloth>
            <Steel>25</Steel>
            <ComponentIndustrial>4</ComponentIndustrial>
        </costList>
    </ThingDef>

    <RecipeDef ParentName="SurgeryInstallBodyPartProstheticBase">
        <defName>Celes_InstallFakeEar</defName>
        <label>安装假兔耳</label>
        <description>安装一个假兔耳。</description>
        <descriptionHyperlinks>
            <ThingDef>Celes_FakeEar</ThingDef>
            <HediffDef>Celes_FakeEar</HediffDef>
        </descriptionHyperlinks>
        <jobString>安装假兔耳中</jobString>
        <recipeUsers>
            <li>Celes_Race</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Celes_FakeEar</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>Celes_FakeEar</li>
            </thingDefs>
        </fixedIngredientFilter>
        <appliedOnFixedBodyParts>
            <li>Celes_Ear</li>
        </appliedOnFixedBodyParts>
        <addsHediff>Celes_FakeEar</addsHediff>
    </RecipeDef>

    <!-- ========== 仿生耳 ========= -->
    
    <HediffDef ParentName="AddedBodyPartBase">
        <defName>Celes_BionicEar</defName>
        <label>仿生兔耳仿生兔耳</label>
        <labelNoun>假兔耳</labelNoun>
        <description>一个用于星铃的，已经安装的先进人造仿生兔耳，模仿了星铃高度复杂的耳朵。其内置的大多数组件都用于还原星铃复杂的灵能共振听力，并能自动抵抗噪音环境，精准感知和识别有效声音，但总体来看只是略微优于星铃原生的耳朵。一个用于星铃的先进人造仿生兔耳，模仿了星铃高度复杂的耳朵。其内置的大多数组件都用于还原星铃复杂的灵能共振听力，并能自动抵抗噪音环境，精准感知和识别有效声音，但总体来看只是略微优于星铃原生的耳朵。</description>
        <descriptionHyperlinks><ThingDef>Celes_BionicEar</ThingDef></descriptionHyperlinks>
        <spawnThingOnRemoved>Celes_BionicEar</spawnThingOnRemoved>
        <addedPartProps>
            <solid>true</solid>
            <partEfficiency>1.1</partEfficiency>
            <betterThanNatural>true</betterThanNatural>
        </addedPartProps>
    </HediffDef>

