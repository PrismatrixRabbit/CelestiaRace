<?xml version="1.0" encoding="utf-8"?>
<Defs>
    
    <HediffDef MayRequire="Ludeon.RimWorld.Biotech">
        <defName>Celes_MechlinkRestriction</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <label>民用机控限制</label>
        <description>一个硬件层的机控能力限制，适用于大多数星铃。\n\n为了方便生活工作，在星铃的母星系，星铃们会在出生时就进行一系列义体化改造，大多数都能被尘构自动化完成，而其中唯一完全不能在边缘世界复现的就是机控中枢系统。一部分诞生自边缘世界的新生代星铃，便可能并不具有机控能力。\n\n对于有机械操纵需要的星铃，过去可能只需要稍稍申请。而如今要解除这一限制，可能需要借助边缘世界的某些类似物。</description>
        <isBad>false</isBad>
        <descriptionHyperlinks>
            <ThingDef>Celes_MechlinkAuthorization</ThingDef>
            <HediffDef>Celes_StandardMechlink</HediffDef>
        </descriptionHyperlinks>
        <stages>
            <li>
                <statFactors>
                    <MechBandwidth>0.35</MechBandwidth>
                </statFactors>
                <statOffsets>
                    <MechControlGroups>-1</MechControlGroups>
                </statOffsets>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_RemoveIfOtherHediff" MayRequire="Ludeon.RimWorld.Biotech">
                <hediffs>
                    <li>Celes_StandardMechlink</li>
                </hediffs>
                <stages>0~</stages>
                <mtbHours>0</mtbHours>
                <message>{0} is no longer .</message>
                <messageType>SilentInput</messageType>
                <onlyMessageForColonistsOrPrisoners>true</onlyMessageForColonistsOrPrisoners>
            </li>
        </comps>
    </HediffDef>
    
    <HediffDef MayRequire="Ludeon.RimWorld.Biotech">
        <defName>Celes_StandardMechlink</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <label>星铃标准机控</label>
        <description>一个硬件层的机控能力改装，提升星铃个体的机械控制能力，在星铃的母星常见于技术军士或工程师。\n\n为了方便生活工作，在星铃的母星系，星铃们会在出生时就进行一系列义体化改造，大多数都能被尘构自动化完成，而其中唯一完全不能在边缘世界复现的就是机控中枢系统。一部分诞生自边缘世界的新生代星铃，便可能并不具有机控能力。</description>
        <isBad>false</isBad>
        <descriptionHyperlinks><ThingDef>Celes_MechlinkAuthorization</ThingDef></descriptionHyperlinks>
        <stages>
            <li>
                <statOffsets>
                    <MechBandwidth>9</MechBandwidth>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef MayRequire="Ludeon.RimWorld.Biotech">
        <defName>CelesSleepMechlinkImplant</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <label>机控中枢(休眠)</label>
        <description>已经失活的机控中枢。这是由于和植入者体内的纳米机械高度融合，而该纳米机械已经，或者曾经完全停机。</description>
        <isBad>false</isBad>
        <descriptionHyperlinks><HediffDef>MechlinkImplant</HediffDef></descriptionHyperlinks>
        <stages>
        </stages>
    </HediffDef>

    <RecipeDef ParentName="Celes_Surgery" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>Celes_MechlinkRestart</defName>
        <modExtensions>
            <li Class="CelesFeature.Celes_RecipeModExtension">
                <addHediff>true</addHediff>
                <hediffToAdd>MechlinkImplant</hediffToAdd>
                <removeHediff>true</removeHediff>
                <hediffToRemove MayRequire="Ludeon.RimWorld.Biotech">CelesSleepMechlinkImplant</hediffToRemove>
                <AllowWhenHediff>
                    <li MayRequire="Ludeon.RimWorld.Biotech">CelesSleepMechlinkImplant</li>
                </AllowWhenHediff>
                <useRace>true</useRace>
                <race>
                    <li>Celes_Race</li>
                </race>
            </li>
        </modExtensions>
        <label>重启机控中枢</label>
        <description>重启机控中枢。</description>
        <jobString>正在重启机控中枢</jobString>
        <descriptionHyperlinks>
            <HediffDef>MechlinkImplant</HediffDef>
            <HediffDef>CelesSleepMechlinkImplant</HediffDef>
        </descriptionHyperlinks>
        <workerClass>CelesFeature.Celes_RecipeSurgery</workerClass>
        <workAmount>2000</workAmount>
        <hideBodyPartNames>true</hideBodyPartNames>
        <targetsBodyPart>false</targetsBodyPart>
        <isViolation>false</isViolation>
        <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
        <surgerySuccessChanceFactor>5.0</surgerySuccessChanceFactor>
        <uiIconThing>Mechlink</uiIconThing>
    </RecipeDef>

    <HediffDef ParentName="ImplantHediffBase" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>Celes_FieldAidRestrict</defName>
        <label>战地支援限制</label>
        <description>Celestia Command has added restrictions to the Field Support Team to avoid risks to the mechlink.</description>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.0625</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <MechBandwidth>0</MechBandwidth>
                </statFactors>
            </li>
        </stages>
    </HediffDef>
</Defs>