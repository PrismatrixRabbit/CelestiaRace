<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>CelesRadiation</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>放射性等离子暴露</label>
        <labelNoun>放射性等离子暴露</labelNoun>
        <description>暴露于某种星铃的放射性等离子体武器中的后遗症，全身疼痛并带有不定期的烧伤症状，需要服用药物才能缓慢治愈。\n\n而对于机械体，这种内照射相当于某种缓慢而长效的EMP，会逐渐降低敌人的数据处理能力。</description>
        <isBad>true</isBad>
        <maxSeverity>1</maxSeverity>
        <tendable>true</tendable>
        <comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.13</severityPerDay>
				<showHoursToRecover>true</showHoursToRecover>
			</li>
            <li Class="HediffCompProperties_TendDuration">
                <labelTendedWell>have taken anti-radiation drugs</labelTendedWell>
                <labelTendedWellInner>have taken anti-radiation drugs</labelTendedWellInner>
                <labelSolidTendedWell>have taken anti-radiation drugs</labelSolidTendedWell>
                <severityPerDayTended>-0.33</severityPerDayTended>
            </li>
        </comps>
        <stages>
            <li>
                <minSeverity>0.1</minSeverity>
                <painOffset>0.1</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.9</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.2</minSeverity>
                <painOffset>0.2</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.8</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.4</minSeverity>
                <painOffset>0.35</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.45</postFactor>
                    </li>
                </capMods>
                <hediffGivers>
                    <li Class="HediffGiver_RandomDrugEffect">
                        <hediff>Burn</hediff>
                        <minSeverity>5</minSeverity>
                        <severityToMtbDaysCurve>
                            <points>
                                <li>(0.40, 0.5)</li>
                                <li>(0.65, 0.33)</li>
                            </points>
                        </severityToMtbDaysCurve>
                        <canAffectAnyLivePart>true</canAffectAnyLivePart>
                    </li>
                </hediffGivers>
            </li>
            <li>
                <minSeverity>0.65</minSeverity>
                <painOffset>0.50</painOffset>
                <capMods>
                    <li>
						<capacity>Consciousness</capacity>
						<postFactor>0.30</postFactor>
                    </li>
                </capMods>
                <hediffGivers>
                    <li Class="HediffGiver_RandomDrugEffect">
                        <hediff>Burn</hediff>
                        <minSeverity>8</minSeverity>
                        <severityToMtbDaysCurve>
                            <points>
                                <li>(0.65, 0.33)</li>
                                <li>(0.90, 0.25)</li>
                            </points>
                        </severityToMtbDaysCurve>
                        <canAffectAnyLivePart>true</canAffectAnyLivePart>
                    </li>
                </hediffGivers>
            </li>
            <li>
                <minSeverity>0.9</minSeverity>
                <painOffset>0.60</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.10</setMax>
                    </li>
                </capMods>
                <hediffGivers>
                    <li Class="HediffGiver_RandomDrugEffect">
                        <hediff>Burn</hediff>
                        <minSeverity>10</minSeverity>
                        <severityToMtbDaysCurve>
                            <points>
                                <li>(0.90, 0.25)</li>
                                <li>(1.00, 0.2)</li>
                            </points>
                        </severityToMtbDaysCurve>
                        <canAffectAnyLivePart>true</canAffectAnyLivePart>
                    </li>
                </hediffGivers>
            </li>
        </stages>
    </HediffDef>
</Defs>