<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <TerrainDef ParentName="FloorBase">
    <defName>Celes_CrystalFloor</defName>
    <label>人工晶态表面</label>
    <description>由尘构构成的晶态地表，可以为晶簇生长提供基底。可被拆除还原为原始地形。</description>
    <renderPrecedence>250</renderPrecedence>
    <texturePath>Celes/Terrain/CrystalFloor</texturePath>
    <statBases>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Celes_NanoMachine>1</Celes_NanoMachine>
    </costList>
    <researchPrerequisites>
      <li>Celes_Bio_I</li>
    </researchPrerequisites>
    <designationCategory>Celes_SpecialBuildings</designationCategory>
    <affordances Inherit="false">
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef ParentName="FloorBase">
    <defName>Celes_CrystalSurface</defName>
    <label>晶化表面</label>
    <description>活性晶簇扩散产生的晶态覆层，可以为晶簇生长提供基底。拆除后还原为原始地形。</description>
    <renderPrecedence>250</renderPrecedence>
    <texturePath>Celes/Terrain/CrystalSurface</texturePath>
    <affordances Inherit="false">
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
    </affordances>
    <designationCategory Inherit="false" />
  </TerrainDef>

</Defs>
