<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ===================== L2 开放市场 · 收购新增 ===================== -->

    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_L2Buy_Logistics</defName>
        <title>L2物流物资收购</title>
        <category>Open</category>
        <isBuy>true</isBuy>
        <fameReward>8</fameReward>
        <orderDurationInQuadrums>0.5</orderDurationInQuadrums>
        <validLevel>
            <li>CelesFD_Level_L2</li>
        </validLevel>
        <includeThings>
            <li>
                <filter><thingDefs><li>Celes_CargoComponent</li></thingDefs></filter>
                <thingAmount>1~2</thingAmount>
                <thingPriceCredit>21</thingPriceCredit>
                <thingWeight>1</thingWeight>
                <label>维护工具货组</label>
            </li>
            <li>
                <filter><thingDefs><li>Celes_CargoEmpty</li></thingDefs></filter>
                <thingAmount>3</thingAmount>
                <orderTotalPriceCredit>1</orderTotalPriceCredit>
                <thingWeight>0.5</thingWeight>
                <thingExtraFameFactor>0.5</thingExtraFameFactor>
                <label>空箱</label>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- ===================== L2 开放市场 · 出售新增 ===================== -->

