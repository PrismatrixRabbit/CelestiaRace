        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <thingDefs>
                        <li>Celes_CargoMaterial</li>
                    </thingDefs>
                </filter>
                <stuffCategoriesToAllow>
                    <li>Woody</li>
                </stuffCategoriesToAllow>
                <thingAmount>3~7</thingAmount>
                <thingPriceCredit>7</thingPriceCredit>
                <thingWeight>1</thingWeight>
                <label>木预制建材货组</label>
                <description>{RULEPACK:CelesFD_L1Buy_CargoBuildingMaterialFlavor:r_cargo_building_wood}</description>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Celes_CargoMaterial</li>
                    </thingDefs>
                </filter>
                <stuffCategoriesToAllow>
                    <li>Stony</li>
                </stuffCategoriesToAllow>
                <thingAmount>3~7</thingAmount>
                <thingPriceCredit>5</thingPriceCredit>
