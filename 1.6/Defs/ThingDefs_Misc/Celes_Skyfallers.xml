<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 星铃外勤部空投舱 -->

  <!-- 结构参照：Core Ethereal_Skyfallers.xml（DropPodIncoming/DropPodLeaving）+ Core Things_Special.xml（ActiveDropPod） -->

  <ThingDef ParentName="DropPodIncoming">
    <defName>CelesFD_DropPodIncoming</defName>
    <label>星铃空投舱（抵达）</label>
    <graphicData>
      <texPath>Celes/Building/DropPod/DropPodCelestia</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <!-- W-2a-fix（2026-09-03 全量打包）：ConstantSpeed（摆脱 DropPodIncoming 的 Decelerate）；
         散货舱【无爆炸】（拆分方案裁决：落地解体的非建筑舱不炸——爆炸仅建筑坠落舱）；
         angleCurve 常值 0 = 直上直下垂直滑入（取消默认 -33.7° 斜角，Skyfaller.cs:253-255 分支） -->
    <skyfaller>
      <anticipationSound>DropPod_Fall_Mechanoid</anticipationSound>
      <movementType>ConstantSpeed</movementType>
      <angleCurve>
        <points>
          <li>(0, 0)</li>
          <li>(9999, 0)</li>
        </points>
      </angleCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="DropPodLeaving">
    <defName>CelesFD_DropPodLeaving</defName>
    <label>星铃空投舱（离场）</label>
    <graphicData>
      <texPath>Celes/Building/DropPod/DropPodCelestia</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <!-- W-2a-fix：离场同取消斜角（直上直下） -->
    <skyfaller>
      <angleCurve>
        <points>
          <li>(0, 0)</li>
          <li>(9999, 0)</li>
        </points>
      </angleCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="ActiveDropPod">
    <defName>CelesFD_ActiveDropPod</defName>
    <label>星铃空投舱</label>
    <soundOpen>DropPod_Open_Mechanoid</soundOpen>
    <graphicData>
      <texPath>Celes/Building/DropPod/DropPodCelestia</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- 事件空投舱 -->

  <!-- ═══ W-2a-fix 拆分方案（2026-09-03 用户裁决）：普通垃圾箱拆为散货版 + 建筑版 ═══
       散货版：仅物品条目 → 星铃空投舱散货路径（落地开舱散落自毁——无爆炸）；
       建筑版：仅 Building 条目 → 垃圾箱 faller（空中爆）+ 容器战利品表。
       原"内容与建筑混杂"单 def 已删除（条目权重语义不变——散货版内部仍按权重抽一） -->

  <CelesFeature.CelesFD_DropCrateDef>
    <defName>CelesFD_DropCrate_TrashNormalThing</defName>
    <contents>
      <li><type>Thing</type><thingDefName>Steel</thingDefName><amountRange>10~25</amountRange><weight>0.25</weight></li>
      <li><thingDefName>ComponentIndustrial</thingDefName><amountRange>1~3</amountRange><weight>0.1</weight></li>
      <li><thingDefName>MealSurvivalPack</thingDefName><amountRange>2~5</amountRange><weight>0.1</weight></li>
      <li><thingDefName>Medicine</thingDefName><amountRange>1~1</amountRange><weight>0.025</weight></li>
      <li><thingDefName>ComponentSpacer</thingDefName><amountRange>1~1</amountRange><weight>0.025</weight></li>
    </contents>
  </CelesFeature.CelesFD_DropCrateDef>

  <CelesFeature.CelesFD_DropCrateDef>
    <defName>CelesFD_DropCrate_TrashNormalBuilding</defName>
    <fallerDef>CelesFD_Skyfaller_OrbitTrashNormal</fallerDef>
    <lootTableDef>CelesFD_Loot_TrashNormal</lootTableDef>
    <contents>
      <li>
        <type>Building</type>
        <amountRange>1~1</amountRange>
        <weight>1.0</weight>
      </li>
    </contents>
  </CelesFeature.CelesFD_DropCrateDef>

  <!-- 垃圾箱下降基类（普通/危险共享；2026-08-15 继承链缩减：子类仅差异 defName/扩展 crateDef）
       W-2a：movementType=ConstantSpeed + angleCurve 垂直滑入（标量字段经继承合并生效；impact 爆炸扩展因
       modExtensions 列表覆盖语义[坑12]不挂基类，逐子类写入） -->
  <ThingDef Name="Celes_OrbitTrashFallerBase" Abstract="True" ParentName="DropPodIncoming">
    <thingClass>CelesFeature.CelesFD_Skyfaller_OrbitCrate</thingClass>
    <label>星铃轨道垃圾箱（降落）</label>
    <graphicData>
      <texPath>Celes/Building/DropPod/DropPodCelestia</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <skyfaller>
      <anticipationSound>DropPod_Fall_Mechanoid</anticipationSound>
      <movementType>ConstantSpeed</movementType>
      <angleCurve>
        <points>
          <li>(0, 0)</li>
          <li>(9999, 0)</li>
        </points>
      </angleCurve>
    </skyfaller>
  </ThingDef>

  <!-- 垃圾箱下降（建筑版——空中爆 r1.9 + lead 30tick；散货版无 faller——走星铃舱路径） -->
  <ThingDef ParentName="Celes_OrbitTrashFallerBase">
    <defName>CelesFD_Skyfaller_OrbitTrashNormal</defName>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropFallerExtension">
        <crateDef>CelesFD_DropCrate_TrashNormalBuilding</crateDef>
      </li>
      <li Class="CelesFeature.CelesFD_SkyfallerImpactExtension">
        <explosionRadius>0.9</explosionRadius>
        <explosionDamage>Bomb</explosionDamage>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 垃圾箱下降（危险——扩展绑危险 crate） -->

  <CelesFeature.CelesFD_DropCrateDef>
    <defName>CelesFD_DropCrate_TrashDanger</defName>
    <fallerDef>CelesFD_Skyfaller_OrbitTrashDanger</fallerDef>
    <lootTableDef>CelesFD_Loot_TrashDanger</lootTableDef>
    <contents>
      <li>
        <type>Building</type>
        <amountRange>1~1</amountRange>
        <weight>1.0</weight>
      </li>
    </contents>
  </CelesFeature.CelesFD_DropCrateDef>

  <ThingDef ParentName="Celes_OrbitTrashFallerBase">
    <defName>CelesFD_Skyfaller_OrbitTrashDanger</defName>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropFallerExtension">
        <crateDef>CelesFD_DropCrate_TrashDanger</crateDef>
      </li>
      <li Class="CelesFeature.CelesFD_SkyfallerImpactExtension">
        <explosionRadius>0.9</explosionRadius>
        <explosionDamage>Bomb</explosionDamage>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 垃圾箱下降（神秘——扩展绑神秘 crate） -->

  <CelesFeature.CelesFD_DropCrateDef>
    <defName>CelesFD_DropCrate_TrashMystery</defName>
    <fallerDef>CelesFD_Skyfaller_OrbitTrashMystery</fallerDef>
    <lootTableDef>CelesFD_Loot_TrashMystery</lootTableDef>
    <contents>
      <li>
        <type>Building</type>
        <amountRange>1~1</amountRange>
        <weight>1.0</weight>
      </li>
    </contents>
  </CelesFeature.CelesFD_DropCrateDef>

  <ThingDef ParentName="Celes_OrbitTrashFallerBase">
    <defName>CelesFD_Skyfaller_OrbitTrashMystery</defName>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropFallerExtension">
        <crateDef>CelesFD_DropCrate_TrashMystery</crateDef>
      </li>
      <li Class="CelesFeature.CelesFD_SkyfallerImpactExtension">
        <explosionRadius>0.9</explosionRadius>
        <explosionDamage>Bomb</explosionDamage>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 晶体下降（贴图 = Celes_CrystalSeed 建筑贴图；晶体侧无爆炸——用户裁决 2026-09-03 终版） -->

  <CelesFeature.CelesFD_DropCrateDef>
    <defName>CelesFD_DropCrate_Crystal</defName>
    <fallerDef>CelesFD_Skyfaller_OrbitCrystal</fallerDef>
    <contents>
      <li>
        <type>Building</type>
        <thingDefName>Celes_CrystalSeed</thingDefName>
        <amountRange>1~1</amountRange>
        <weight>1.0</weight>
      </li>
    </contents>
  </CelesFeature.CelesFD_DropCrateDef>

  <ThingDef ParentName="DropPodIncoming">
    <defName>CelesFD_Skyfaller_OrbitCrystal</defName>
    <thingClass>CelesFeature.CelesFD_Skyfaller_OrbitCrate</thingClass>
    <label>星铃轨道晶体（降落）</label>
    <graphicData>
      <texPath>Celes/Building/CrystalSeeder/CrystalSeed_Active</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <skyfaller>
      <anticipationSound>DropPod_Fall</anticipationSound>
      <movementType>ConstantSpeed</movementType>
      <angleCurve>
        <points>
          <li>(0, 0)</li>
          <li>(9999, 0)</li>
        </points>
      </angleCurve>
    </skyfaller>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropFallerExtension">
        <crateDef>CelesFD_DropCrate_Crystal</crateDef>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 初始晶体下降（贴图 = Celes_CrystalInitialSeed 建筑贴图；晶体侧无爆炸——用户裁决 2026-09-03 终版） -->

  <CelesFeature.CelesFD_DropCrateDef>
    <defName>CelesFD_DropCrate_InitialCrystal</defName>
    <fallerDef>CelesFD_Skyfaller_OrbitCrystalInitial</fallerDef>
    <contents>
      <li>
        <type>Building</type>
        <thingDefName>Celes_CrystalInitialSeed</thingDefName>
        <amountRange>1~1</amountRange>
        <weight>1.0</weight>
      </li>
    </contents>
  </CelesFeature.CelesFD_DropCrateDef>

  <ThingDef ParentName="DropPodIncoming">
    <defName>CelesFD_Skyfaller_OrbitCrystalInitial</defName>
    <thingClass>CelesFeature.CelesFD_Skyfaller_OrbitCrate</thingClass>
    <label>星铃轨道晶体（降落）</label>
    <graphicData>
      <texPath>Celes/Building/CrystalSeeder/CrystalInitialSeed_Active</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <skyfaller>
      <anticipationSound>DropPod_Fall</anticipationSound>
      <movementType>ConstantSpeed</movementType>
      <angleCurve>
        <points>
          <li>(0, 0)</li>
          <li>(9999, 0)</li>
        </points>
      </angleCurve>
    </skyfaller>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropFallerExtension">
        <crateDef>CelesFD_DropCrate_InitialCrystal</crateDef>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ═══ W-2a：武备支援空投舱（a-1 早期武备空投）═══ -->

  <!-- 武备空投 crate：容器模式（lootTable 指向支援舱容器 + spawnAll 固定清单）；
       playerOwned=true（FD-G37 归入项：武备掉落 Def 配玩家归属） -->
  <CelesFeature.CelesFD_DropCrateDef>
    <defName>CelesFD_DropCrate_SupportPodStarter</defName>
    <fallerDef>CelesFD_Faller_SupportPod</fallerDef>
    <lootTableDef>CelesFD_Loot_SupportPodStarter</lootTableDef>
    <playerOwned>true</playerOwned>
  </CelesFeature.CelesFD_DropCrateDef>

  <!-- 武备空投舱下降（A2-10 裁决：物资支援类 = Decelerate 减速坠落姿态——贴图 Reducer；
       W-2a-fix：angleCurve 垂直滑入；无爆炸（物资投送） -->
  <ThingDef ParentName="DropPodIncoming">
    <defName>CelesFD_Faller_SupportPod</defName>
    <thingClass>CelesFeature.CelesFD_Skyfaller_OrbitCrate</thingClass>
    <label>星铃武备空投舱（降落）</label>
    <graphicData>
      <texPath>Celes/Building/DropPod/DropPodCelestiaReducer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <anticipationSound>DropPod_Fall</anticipationSound>
      <angleCurve>
        <points>
          <li>(0, 0)</li>
          <li>(9999, 0)</li>
        </points>
      </angleCurve>
    </skyfaller>
    <modExtensions>
      <li Class="CelesFeature.CelesFD_OrbitDropFallerExtension">
        <crateDef>CelesFD_DropCrate_SupportPodStarter</crateDef>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
