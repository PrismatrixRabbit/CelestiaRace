    <!-- ========== 武器科技 ========== -->

    <ResearchProjectDef>
        <defName>Celes_Weapon_I</defName><!-- 星铃拓荒武器 -->
        <label>星铃拓荒武器</label>
        <description>依照星铃标准设计拓荒武器，允许制作拓荒冰镐，并改良简单枪械。注意：星铃的蓝图中只包括改进指南，而不包括武器本身的制造方案。\n\n这些古董般的设计，只是通过与晶蒴等材料一并锻造，就能有着纳米级精度的膛线与自气密的跨时代性能。</description>
        <baseCost>500</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
        </prerequisites>
        <researchViewX>0</researchViewX>
        <researchViewY>1.8</researchViewY>
        <tab>Celes_ResearchTab</tab>
        <tags>
        </tags>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>Celes_Weapon_II</defName><!-- 星铃古典武器 -->
        <label>星铃古典武器</label>
        <description>按照星铃武器规范和弹药口径设计的古典武器，允许制作拓荒军刀等武器，并改良精准步枪。注意：星铃的蓝图中只包括改进指南，而不包括武器本身的制造方案。\n\n这种武器利用电化学推进发射弹药，有着夸张的能量密度，已经逼近一个工业文明所能企及的极限。这型号仍然用于星铃拓荒队的先锋小队中，或者被配发给前哨站居民防身，它们的历史却已经无从追溯。</description>
        <baseCost>700</baseCost>
        <techLevel>Industrial</techLevel>
        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
        <prerequisites>
            <li>Celes_MainTech_II</li>
        </prerequisites>
        <researchViewX>1</researchViewX>
        <researchViewY>1.8</researchViewY>
        <tab>Celes_ResearchTab</tab>
        <tags>
        </tags>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>Celes_Weapon_III</defName><!-- 星铃制式武器 --><!-- 待编辑 -->
        <label>星铃制式武器</label>
        <description>解锁制作发射高能极化粒子束的星铃制式枪械，这些武器附带的高能辐射会对目标体表严重烧伤，并干扰机械体的运作。并允许制作制式单分子军刀等武器。\n\n这些武器曾被星铃海军淘汰百年有余，但基于边缘世界的工业暂不支持海军军规武器生产的现状，于是这些差强人意的粒子束武器便也成为拓荒队的标配。</description>
        <baseCost>3000</baseCost>
        <techLevel>Spacer</techLevel>
        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <prerequisites>
