<Defs>

  <!-- ============ 生长判定链参数阐释 ============
 判定链算法（每次检测周期执行一次，培育器/晶种共用）：
   1. 初始概率 C = totalGrowChance − perDecreaseChance × 范围内非最高级晶簇数
      （进链前一次性计算；当次新生晶簇不参与本次削减）
      若 C ≤ 0 → 取 minGrowChance（保底）
   2. 判定链循环（while C > 0）：
      单次判定概率 = min(C, maxGrowChance) → 掷骰
      成功 → 在 growRadius 内随机可生长地板创建 1 级晶簇
      无论成败 → C −= growStepDecrement → 回到循环头
   3. 链结束后：范围内已有晶簇各以 chanceToGrow 概率积累 1 生长值
      （生长值达到 pointToGrow 阈值即升级，升级由生长源驱动）

 各参数含义：
   totalGrowChance（1.5）  —— 总生长概率，判定链的初始 C。
                              数值越大，单次检测的判定次数越多（饱和晶簇数越高）。
   maxGrowChance（0.8）    —— 单次判定概率上限。C 高于此值时掷骰概率封顶，
                              用于控制单次判定成功率（防止总概率过高时次次必中）。
   growStepDecrement（0.5）—— 判定链步进减量。每轮判定后 C 的固定削减量。
                              越小 → 判定次数越多（链越长）；必须 > 0（否则死循环）。
   perDecreaseChance（0.15）—— 每个非最高级晶簇对总概率的削减量。密度自限核心：
                              范围内晶簇越多，下次检测的总概率越低，饱和后自然停止扩散。
   minGrowChance（0.05）   —— 保底下限。削减导致 C ≤ 0 时仍保留一次低概率判定，
                              保证高密度环境下不会完全停摆（仍有少量新簇机会）。
   chanceToGrow（0.33）    —— 晶簇个体生长值积累概率。每次检测每晶簇独立掷骰，
                              命中则生长值 +1（升级阈值见 pointToGrow）。

 示例（total=1.5 / max=0.8 / step=0.5 / 无晶簇时）：
   轮1：C=1.5，判定概率=min(1.5,0.8)=0.8，判定后 C=1.0
   轮2：C=1.0，判定概率=0.8，判定后 C=0.5
   轮3：C=0.5，判定概率=0.5，判定后 C=0 → 链结束（最多 3 次判定）
   密度自限示例（20 个晶簇）：C = 1.5 − 20×0.15 = −1.5 → 保底 0.05 → 仅 1 次判定
 ============================================ -->

  <!-- 尘构晶簇：Mineable 建筑，原版开采系统零改动接入 -->
  <!-- [事实] 结构参照原版 MineableSteel（Core Buildings_Natural.xml:91-113）与 RockBase 继承链 -->
  <ThingDef ParentName="BuildingNaturalBase">
    <defName>Celes_CrystalCluster</defName>
    <label>尘晶晶簇</label>
    <description>由某种更大的结构催生的次生晶簇，可以开采出尘晶碎片，会提取和富集地下的特定矿物质以生长。生长有体积上限，通常来说达到上限后再开采收益是最高的。</description>
    <thingClass>CelesFeature.CelesIM_CrystalCluster</thingClass>
    <graphicData>
      <texPath>Celes/Building/CrystalCluster/CrystalCluster_1</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <tickerType>Long</tickerType>
    <fillPercent>0.5</fillPercent>
    <mineable>true</mineable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <mineableThing>Celes_CrystallineMaterial</mineableThing>
      <mineableYield>1</mineableYield>
      <!-- [事实] mineableDropChance=0：关闭基类 Mineable 产出（Mineable.cs:68 判定），产出由 Comp.PostDestroy 按等级自产 -->
      <mineableDropChance>0</mineableDropChance>
    </building>
    <comps>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalCluster">
        <levelGraphics>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_1</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_2</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_3</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_4</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
        </levelGraphics>
        <!-- dev 直接生成时的默认参数（培育器/晶种生成时由 InitGrowth 覆盖） -->
        <pointToGrow>
          <li>0</li>
          <li>2</li>
          <li>5</li>
          <li>10</li>
        </pointToGrow>
        <!-- 各等级开采产出 1/2/4/16 -->
        <yieldByLevel>
          <li>1</li>
          <li>2</li>
          <li>4</li>
          <li>16</li>
        </yieldByLevel>
        <!-- dev 兜底参数（培育器/晶种生成时由 InitGrowth 覆盖）：两晶态地板 -->
        <terrainToGrow>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </terrainToGrow>
        <!-- 豁免地板：人工晶态表面/晶化表面铺到晶簇脚下不触发地板替换破坏 -->
        <protectedTerrains>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </protectedTerrains>
      </li>
    </comps>
  </ThingDef>

  <!-- 晶体培育器：燃料驱动周期扩散晶簇 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Celes_CrystalSeeder</defName>
    <label>晶体培育器</label>
    <description>内含尘晶晶种的晶体培育器，会在周围的「人工晶态表面」上催生更小型的尘晶晶簇。需要「人工晶态表面」维持运转，无燃料时进入待机。晶簇生长至最高等级后可用自动标记开采。</description>
    <descriptionHyperlinks>
      <ThingDef>Celes_InitialCrystalCluster</ThingDef>
      <ThingDef>Celes_CrystallineMaterial</ThingDef>
    </descriptionHyperlinks>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Celes/Building/CrystalSeeder/CrystalSeeder</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.0,2.0)</drawSize>
    </graphicData>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Celes_InitialCrystalCluster>1</Celes_InitialCrystalCluster>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.6</fillPercent>
    <uiIconScale>0.4</uiIconScale>
    <uiIconOffset>(0, 0)</uiIconOffset>
    <castEdgeShadows>true</castEdgeShadows>
    <size>(1,1)</size>
    <designationCategory>Celes_SpecialBuildings</designationCategory>
    <passability>PassThroughOnly</passability>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <WorkToBuild>5000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <!-- F4：依赖型线程终端——断链=无法工作（inspect 文字与生长冻结行为一致；不配 WarmUpDuration=无预热） -->
      <Celes_ThreadDependency>1</Celes_ThreadDependency>
    </statBases>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <researchPrerequisites>
      <li>Celes_Bio_I</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>CelesFeature.CelesIM_PlaceWorker_CrystalGrowRadius</li>
      <!-- F4：放置时预览线程连接（尘构机同款） -->
      <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>300</basePowerConsumption>
        <idlePowerDraw>50</idlePowerDraw>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Refuelable">
        <fuelFilter>
          <thingDefs>
            <li>Celes_ReplicationMaterial</li>
            <li>Celes_ReplicationMaterialFlesh</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>5</fuelCapacity>
        <fuelConsumptionRate>1.0</fuelConsumptionRate>
        <consumeFuelOnlyWhenPowered>true</consumeFuelOnlyWhenPowered>
        <!-- F3b：锁定缺料图标为尘晶培养底料（双燃料下 AnyAllowedDef 取值顺序不可控，原版字段钦定；
             路径=贴图实体位置 目录/同名.png——物品 def 的 texPath 短路径此处不适用，勿互抄。
             燃料目标量可调两行已按用户裁决删除：原版装填 job 无配置即自动装填，可调目标量非必需） -->
        <fuelIconPath>Celes/Item/BaseResource/ReplicationMaterial/ReplicationMaterial</fuelIconPath>
        <fuelLabel>复制基质</fuelLabel>
        <outOfFuelMessage>基质耗尽，培育停止。</outOfFuelMessage>
      </li>
      <!-- F4：线程终端（断链冻结生长＋Lack 脉动/连接标志视觉自动获得；参数镜像尘构机参照） -->
      <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
        <baseThreadsCost>4</baseThreadsCost>
        <markTexPath>Celes/UI/Overlays/ThreadMark</markTexPath>
        <linkHeight>1.7</linkHeight>
      </li>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalSeeder">
        <ticksToGrow>10000</ticksToGrow>
        <growRadius>9.9</growRadius>
        <totalGrowChance>1.5</totalGrowChance>
        <maxGrowChance>0.8</maxGrowChance>
        <growStepDecrement>0.5</growStepDecrement>
        <perDecreaseChance>0.15</perDecreaseChance>
        <minGrowChance>0.05</minGrowChance>
        <baseGrowDef>Celes_CrystalCluster</baseGrowDef>
        <!-- 可生长地板：人工晶态表面 + 晶化表面（两地板均配） -->
        <terrainToGrow>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </terrainToGrow>
        <!-- 晶簇生成位置创建地板（layerable 晶化表面） -->
        <spawnTerrain>Celes_CrystalSurface</spawnTerrain>
        <pointToGrow>
          <li>0</li>
          <li>2</li>
          <li>5</li>
          <li>10</li>
        </pointToGrow>
        <chanceToGrow>0.33</chanceToGrow>
      </li>
      <!--
      <li Class="CelesFeature.CelesIM_CompProperties_CorpseFuel">
        <corpseBlacklist>
          <li>Celes_NanoCrystallisedCorpse</li>
          <li>Celes_RottenNanoCrystallisedCorpse</li>
        </corpseBlacklist>
        <maxCorpseCharge>2.0</maxCorpseCharge>
      </li>
      -->
    </comps>
  </ThingDef>

  <!-- 尘晶柱：自然生长源，次数上限自限，无燃料无电力 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Celes_CrystalSeed</defName>
    <label>尘晶柱</label>
    <description>柱状的尘晶，会在周围催生更小型的尘晶晶簇，本身也可以开采出尘晶碎片。因为不明原因的突变对周围的植物和动物会有毒害作用，好在物理破坏可以摧毁其活性。\n\n尘晶柱会提取和富集地下的特定矿物质，往周围生产和释放微小的晶体孢子，这些孢子在接触到固态表面后就会开始形成尘晶晶簇。正常来说不应该在有机物上生长……但好在大多数情况下晶簇是打不过免疫系统的，但是植物就不好说了。</description>
    <descriptionHyperlinks>
      <ThingDef>Celes_CrystallineMaterial</ThingDef>
    </descriptionHyperlinks>
    <thingClass>CelesFeature.Celes_CrystalSeedThing</thingClass>
    <building>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <graphicData>
      <texPath>Celes/Building/CrystalSeeder/CrystalSeed_Inactive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <size>(1,1)</size>
    <passability>Standable</passability>
    <tickerType>Rare</tickerType>
    <placeWorkers>
      <li>CelesFeature.CelesIM_PlaceWorker_CrystalGrowRadius</li>
    </placeWorkers>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>75</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <costList>
      <Celes_CrystallineMaterial>24</Celes_CrystallineMaterial>
    </costList>
    <comps>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalSeed">
        <attemptsLimit>45</attemptsLimit>
        <ticksToGrow>2500</ticksToGrow>
        <growRadius>9.9</growRadius>
        <totalGrowChance>0.8</totalGrowChance>
        <maxGrowChance>0.8</maxGrowChance>
        <growStepDecrement>0.4</growStepDecrement>
        <perDecreaseChance>0.10</perDecreaseChance>
        <minGrowChance>0.05</minGrowChance>
        <baseGrowDef>Celes_CrystalCluster</baseGrowDef>
        <!-- 生长表面 = 任意 Medium 支撑（Affordance 模式，用户裁决：不限于晶态地板）；terrainToGrow 保留备用 -->
        <terrainCheckMode>Affordance</terrainCheckMode>
        <terrainToGrow>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </terrainToGrow>
        <!-- 晶簇生成位置创建地板（layerable 晶化表面——感染表现） -->
        <spawnTerrain>Celes_CrystalSurface</spawnTerrain>
        <pointToGrow>
          <li>0</li>
          <li>2</li>
          <li>5</li>
          <li>10</li>
        </pointToGrow>
        <chanceToGrow>0.33</chanceToGrow>
        <activeGraphicData>
          <texPath>Celes/Building/CrystalSeeder/CrystalSeed_Active</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </activeGraphicData>
      </li>
      <!-- 数值：45 次判定 × 0.25 = +11.25 → 最终半径 22.15（10.9 + 11.25）；硬上限 125 -->
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalBlight">
        <startRadius>10.9</startRadius>
        <radiusGrowPerCheck>0.25</radiusGrowPerCheck>
        <expandCheckTicks>2500</expandCheckTicks>
        <maxRadius>125</maxRadius>
        <pawnHediff>Celes_DustMechInfection</pawnHediff>
        <hediffSeverityPerDay>1.0</hediffSeverityPerDay>
        <plantHarmFrequencyPerArea>0.011</plantHarmFrequencyPerArea>
        <leaflessPlantKillChance>0.35</leaflessPlantKillChance>
        <ignoreSpecialTrees>true</ignoreSpecialTrees>
        <messageOnCropDeath>true</messageOnCropDeath>
      </li>
      <!-- 晶化表面扩散（真菌状分叉+填充；失活即停；仅晶种系挂载） -->
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalTerrainSpread">
        <spreadTerrain>Celes_CrystalSurface</spreadTerrain>
        <spreadPerCheck>3</spreadPerCheck>
        <branchChance>0.1</branchChance>
        <maxTips>12</maxTips>
        <minTips>3</minTips>
        <thickenChance>0.6</thickenChance>
        <neededAffordance>Light</neededAffordance>
      </li>
    </comps>
  </ThingDef>

