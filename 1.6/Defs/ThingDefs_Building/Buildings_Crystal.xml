      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <costList>
      <Celes_InitialCrystalCluster>1</Celes_InitialCrystalCluster>
    </costList>
    <comps>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalSeed">
        <attemptsLimit>99999</attemptsLimit>
        <ticksToGrow>10000</ticksToGrow>
        <growRadius>9.9</growRadius>
        <totalGrowChance>1.5</totalGrowChance>
        <maxGrowChance>0.8</maxGrowChance>
        <growStepDecrement>0.5</growStepDecrement>
        <perDecreaseChance>0.15</perDecreaseChance>
        <minGrowChance>0.05</minGrowChance>
        <baseGrowDef>Celes_CrystalCluster</baseGrowDef>
        <!-- 生长表面 = 任意 Medium 支撑（Affordance 模式）；terrainToGrow 保留备用 -->
        <terrainCheckMode>Affordance</terrainCheckMode>
        <terrainToGrow>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </terrainToGrow>
        <!-- 晶簇生成位置创建地板（layerable 晶化表面——感染表现） -->
        <spawnTerrain>Celes_CrystalSurface</spawnTerrain>
        <pointToGrow>
          <li>0</li>
          <li>2</li>
          <li>5</li>
          <li>10</li>
        </pointToGrow>
        <chanceToGrow>0.33</chanceToGrow>
        <activeGraphicData>
          <texPath>Celes/Building/CrystalSeeder/CrystalInitialSeed_Active</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </activeGraphicData>
      </li>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalBlight">
        <startRadius>10.9</startRadius>
        <radiusGrowPerCheck>0.01</radiusGrowPerCheck>
        <expandCheckTicks>2500</expandCheckTicks>
        <maxRadius>125</maxRadius>
        <pawnHediff>Celes_DustMechInfection</pawnHediff>
