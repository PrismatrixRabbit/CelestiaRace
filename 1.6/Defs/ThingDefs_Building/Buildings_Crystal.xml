        <plantHarmFrequencyPerArea>0.011</plantHarmFrequencyPerArea>
        <leaflessPlantKillChance>0.35</leaflessPlantKillChance>
        <ignoreSpecialTrees>true</ignoreSpecialTrees>
        <messageOnCropDeath>true</messageOnCropDeath>
      </li>
      <!-- 晶化表面扩散（真菌状分叉+填充；失活即停） -->
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalTerrainSpread">
        <spreadTerrain>Celes_CrystalSurface</spreadTerrain>
        <spreadPerCheck>3</spreadPerCheck>
        <branchChance>0.1</branchChance>
        <maxTips>12</maxTips>
        <minTips>3</minTips>
        <thickenChance>0.6</thickenChance>
