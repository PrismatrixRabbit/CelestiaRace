<Defs>

  <!-- ============ 生长判定链参数阐释 ============
 判定链算法（每次检测周期执行一次，培育器/晶种共用）：
   1. 初始概率 C = totalGrowChance − perDecreaseChance × 范围内非最高级晶簇数
      （进链前一次性计算；当次新生晶簇不参与本次削减）
      若 C ≤ 0 → 取 minGrowChance（保底）
   2. 判定链循环（while C > 0）：
      单次判定概率 = min(C, maxGrowChance) → 掷骰
      成功 → 在 growRadius 内随机可生长地板创建 1 级晶簇
      无论成败 → C −= growStepDecrement → 回到循环头
   3. 链结束后：范围内已有晶簇各以 chanceToGrow 概率积累 1 生长值
      （生长值达到 pointToGrow 阈值即升级，升级由生长源驱动）

 各参数含义：
   totalGrowChance（1.5）  —— 总生长概率，判定链的初始 C。
                              数值越大，单次检测的判定次数越多（饱和晶簇数越高）。
   maxGrowChance（0.8）    —— 单次判定概率上限。C 高于此值时掷骰概率封顶，
                              用于控制单次判定成功率（防止总概率过高时次次必中）。
   growStepDecrement（0.5）—— 判定链步进减量。每轮判定后 C 的固定削减量。
                              越小 → 判定次数越多（链越长）；必须 > 0（否则死循环）。
   perDecreaseChance（0.15）—— 每个非最高级晶簇对总概率的削减量。密度自限核心：
                              范围内晶簇越多，下次检测的总概率越低，饱和后自然停止扩散。
   minGrowChance（0.05）   —— 保底下限。削减导致 C ≤ 0 时仍保留一次低概率判定，
                              保证高密度环境下不会完全停摆（仍有少量新簇机会）。
   chanceToGrow（0.33）    —— 晶簇个体生长值积累概率。每次检测每晶簇独立掷骰，
                              命中则生长值 +1（升级阈值见 pointToGrow）。

 示例（total=1.5 / max=0.8 / step=0.5 / 无晶簇时）：
   轮1：C=1.5，判定概率=min(1.5,0.8)=0.8，判定后 C=1.0
   轮2：C=1.0，判定概率=0.8，判定后 C=0.5
   轮3：C=0.5，判定概率=0.5，判定后 C=0 → 链结束（最多 3 次判定）
   密度自限示例（20 个晶簇）：C = 1.5 − 20×0.15 = −1.5 → 保底 0.05 → 仅 1 次判定
 ============================================ -->
  
  <!-- 晶体培育器：燃料驱动周期扩散晶簇 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Celes_CrystalSeeder</defName>
    <label>晶体培育器</label>
    <description>周期性在范围内可生长地板上催生尘构晶簇。需要燃料维持运转，无燃料时进入待机。晶簇生长至最高等级后可用自动标记开采。</description>
    <descriptionHyperlinks>
      <ThingDef>Celes_InitialCrystalCluster</ThingDef>
      <ThingDef>Celes_CrystallineMaterial</ThingDef>
    </descriptionHyperlinks>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Celes/Building/CrystalSeeder/CrystalSeeder</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.0,2.0)</drawSize>
    </graphicData>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Celes_InitialCrystalCluster>1</Celes_InitialCrystalCluster>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.6</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <size>(2,2)</size>
    <designationCategory>Celes_SpecialBuildings</designationCategory>
    <passability>PassThroughOnly</passability>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToBuild>5000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <researchPrerequisites>
      <li>Celes_MainTech_I</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>CelesFeature.CelesIM_PlaceWorker_CrystalGrowRadius</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>300</basePowerConsumption>
        <idlePowerDraw>50</idlePowerDraw>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Refuelable">
        <fuelFilter>
          <thingDefs>
            <li>Celes_ReplicationMaterial</li>
            <li>Celes_FleshReplicationMaterial</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>5</fuelCapacity>
        <fuelConsumptionRate>1.0</fuelConsumptionRate>
        <consumeFuelOnlyWhenPowered>true</consumeFuelOnlyWhenPowered>
        <fuelLabel>复制基质</fuelLabel>
        <outOfFuelMessage>基质耗尽，培育停止。</outOfFuelMessage>
      </li>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalSeeder">
        <ticksToGrow>10000</ticksToGrow>
        <growRadius>9.9</growRadius>
        <totalGrowChance>1.5</totalGrowChance>
        <maxGrowChance>0.8</maxGrowChance>
        <growStepDecrement>0.5</growStepDecrement>
        <perDecreaseChance>0.15</perDecreaseChance>
        <minGrowChance>0.05</minGrowChance>
        <baseGrowDef>Celes_CrystalCluster</baseGrowDef>
        <!-- 可生长地板：人工晶态表面 + 晶化表面（两地板均配） -->
        <terrainToGrow>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </terrainToGrow>
        <!-- 晶簇生成位置创建地板（layerable 晶化表面） -->
        <spawnTerrain>Celes_CrystalSurface</spawnTerrain>
        <pointToGrow>
          <li>0</li>
          <li>2</li>
          <li>5</li>
          <li>10</li>
        </pointToGrow>
        <chanceToGrow>0.33</chanceToGrow>
      </li>
      <!--
      <li Class="CelesFeature.CelesIM_CompProperties_CorpseFuel">
        <corpseBlacklist>
          <li>Celes_NanoCrystallisedCorpse</li>
          <li>Celes_RottenNanoCrystallisedCorpse</li>
        </corpseBlacklist>
        <maxCorpseCharge>2.0</maxCorpseCharge>
      </li>
      -->
    </comps>
  </ThingDef>

  <!-- 野外晶种：自然生长源，次数上限自限，无燃料无电力 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Celes_CrystalSeed</defName>
    <label>野外晶种</label>
    <description>会自然催生尘构晶簇的活性晶体。会吸收并毒害附近的植物和动物，一定时间后失活，失活后范围内晶簇停止生长。但其范围内的尘构毒性不会消失。</description>
    <descriptionHyperlinks>
      <ThingDef>Celes_CrystallineMaterial</ThingDef>
    </descriptionHyperlinks>
    <thingClass>CelesFeature.Celes_CrystalSeedThing</thingClass>
    <building>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <graphicData>
      <texPath>Celes/Building/CrystalSeeder/CrystalSeed_Inactive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <size>(1,1)</size>
    <passability>Standable</passability>
    <tickerType>Rare</tickerType>
    <placeWorkers>
      <li>CelesFeature.CelesIM_PlaceWorker_CrystalGrowRadius</li>
    </placeWorkers>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <costList>
      <Celes_CrystallineMaterial>24</Celes_CrystallineMaterial>
    </costList>
    <comps>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalSeed">
        <attemptsLimit>45</attemptsLimit>
        <ticksToGrow>2500</ticksToGrow>
        <growRadius>9.9</growRadius>
        <totalGrowChance>0.8</totalGrowChance>
        <maxGrowChance>0.8</maxGrowChance>
        <growStepDecrement>0.4</growStepDecrement>
        <perDecreaseChance>0.10</perDecreaseChance>
        <minGrowChance>0.05</minGrowChance>
        <baseGrowDef>Celes_CrystalCluster</baseGrowDef>
        <!-- 生长表面 = 任意 Medium 支撑（Affordance 模式，用户裁决：不限于晶态地板）；terrainToGrow 保留备用 -->
        <terrainCheckMode>Affordance</terrainCheckMode>
        <terrainToGrow>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </terrainToGrow>
        <!-- 晶簇生成位置创建地板（layerable 晶化表面——感染表现） -->
        <spawnTerrain>Celes_CrystalSurface</spawnTerrain>
        <pointToGrow>
          <li>0</li>
          <li>2</li>
          <li>5</li>
          <li>10</li>
        </pointToGrow>
        <chanceToGrow>0.33</chanceToGrow>
        <activeGraphicData>
          <texPath>Celes/Building/CrystalSeeder/CrystalSeed_Active</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </activeGraphicData>
      </li>
      <!-- 数值：45 次判定 × 0.25 = +11.25 → 最终半径 22.15（10.9 + 11.25）；硬上限 125 -->
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalBlight">
        <startRadius>10.9</startRadius>
        <radiusGrowPerCheck>0.25</radiusGrowPerCheck>
        <expandCheckTicks>2500</expandCheckTicks>
        <maxRadius>125</maxRadius>
        <pawnHediff>Celes_DustMechInfection</pawnHediff>
        <hediffSeverityPerDay>1.0</hediffSeverityPerDay>
        <plantHarmFrequencyPerArea>0.011</plantHarmFrequencyPerArea>
        <leaflessPlantKillChance>0.35</leaflessPlantKillChance>
        <ignoreSpecialTrees>true</ignoreSpecialTrees>
        <messageOnCropDeath>true</messageOnCropDeath>
      </li>
      <!-- 晶化表面扩散（真菌状分叉+填充；失活即停；仅晶种系挂载） -->
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalTerrainSpread">
        <spreadTerrain>Celes_CrystalSurface</spreadTerrain>
        <spreadPerCheck>3</spreadPerCheck>
        <branchChance>0.1</branchChance>
        <maxTips>12</maxTips>
        <minTips>3</minTips>
        <thickenChance>0.6</thickenChance>
        <neededAffordance>Light</neededAffordance>
      </li>
    </comps>
  </ThingDef>

