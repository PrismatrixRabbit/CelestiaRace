    <!-- 协调器：扩容枢纽（被视作中枢托管增幅器族；电力负载×2 乘区）；
         必须紧贴中枢；协调器之间不可互相连接 -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_Coordinator</defName>
        <label>协调器</label>
        <description>协调器会在连接时无条件增加中枢的电力负载，但可像中枢一样连接各型增幅器，并将加成反馈至直连中枢。协调器之间不可互相连接，中枢至多连接两台协调器。\n\n中枢的「编译线程」输入数据流相较于输出数据流通常更为混乱而大量，这些混杂的算力未经过计算、协调与处理，通常的中继器无法承担这种数据传输任务。协调器基于对中枢的增幅扩容的需求应运而生，并可以将这些数据流和电力直接在增幅器与中枢间传输，唯一的问题是，协调器本身会指数级的增加中枢的耗电。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <!-- TODO:贴图待填（现用增幅器图占位，尺寸随正式美术调整） -->
            <texPath>Celes/Building/Coordinator/Coordinator</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(6,6)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <uiIconScale>0.4</uiIconScale>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <uiOrder>1100</uiOrder>
        <costList>
            <CelesAlloy>400</CelesAlloy>
            <Celes_Substrate>100</Celes_Substrate>
            <Celes_NanoComponent>8</Celes_NanoComponent>
            <ComponentSpacer>4</ComponentSpacer>
            <Celes_AdvancedComponent>2</Celes_AdvancedComponent>
        </costList>
        <statBases>
            <WorkToBuild>27000</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <!-- TODO:Mass 占位（实测定稿） -->
            <Mass>10</Mass>
        </statBases>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>Celes_MainTech_IV</li>
        </researchPrerequisites>
        <comps>
            <!-- 对上：中枢设施——紧贴中枢（斜角相邻最小中心距 2.5）；中枢侧接纳 ≤2 台 -->
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <compClass>CelesFeature.CelesIM_CompFacility_ProducerDevice</compClass>
                <maxSimultaneous>2</maxSimultaneous>
                <maxLinkedTargets>1</maxLinkedTargets>
                <maxDistance>6.9</maxDistance>
            </li>
            <!-- 对下：受影响侧宿主（被视作中枢）——托管增幅器族 -->
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Celes_AmplifierBasic</li>
                    <li>Celes_AmplifierNode</li>
                    <li>Celes_AmplifierAdvanced</li>
                    <li>Celes_Balancer</li>
                </linkableFacilities>
            </li>
        </comps>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_AmplifierExt">
                <producerPowerFactor>1.5</producerPowerFactor>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowProducerLinks</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

</Defs>
