<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ========== 中枢计算塔 ========== -->

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_CentralControlTower</defName>
        <label>中枢计算塔</label>
        <description>星铃局域尘构控制系统的核心组件，主要负责协调大批数据的统筹处理，也能少量的提供「编译线程」。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/CentralControlTower/CentralControlTower</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(17,17)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(3,3)</size>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconScale>0.4</uiIconScale>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <useHitPoints>true</useHitPoints>
        <uiOrder>990</uiOrder>
        <costList>
            <Steel>200</Steel>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>1600</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            
            <li Class="CelesFeature.CelesIM_CompProperties_ProducerPower" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadProducer">
                <baseThreadsProduce>8</baseThreadsProduce>
                <connectRadius>6.9</connectRadius>
                <overloadCount>7500</overloadCount>
                <linkHeight>6.4</linkHeight>
                <faultRepairResource>ComponentIndustrial</faultRepairResource>
                <faultRepairCount>2</faultRepairCount>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Celes_AmplifierBasic</li>
                    <li>Celes_AmplifierNode</li>
                    <li>Celes_AmplifierAdvanced</li>
                    <li>Celes_Balancer</li>
                    <li>Celes_Coordinator</li>
                </linkableFacilities>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <!-- ========== 中继 ========== -->

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_RelayNode</defName>
        <label>中继信号塔</label>
        <description>扩展编译线程连接范围的中继设备。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/RelayNode/RelayNode</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.9,3,0.9)</volume>
            </shadowData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <!-- 连线由中继 PostDraw 绘制——恒绘防视野剔除（drawOffscreen=true 跳过 viewRect 判定） -->
        <drawOffscreen>true</drawOffscreen>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <uiIconScale>0.4</uiIconScale>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>8</Mass>
        </statBases>
        <comps>
            <!-- 7 连接数 / 范围 4.9 -->
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadRelay">
                <connectionLimit>7</connectionLimit>
                <connectRadius>4.9</connectRadius>
                <forwardOnlyRadiusBonus>4</forwardOnlyRadiusBonus>

                <linkHeight>2.0</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

