<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestCore</defName>
        <label>测试中枢</label>
        <description>带宽工业系统测试用中枢建筑。产出编译线程，供范围内的终端设备连接。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/SimplifiedControlTower/SimplifiedControlTower</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(15,15)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(3,3)</size>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconScale>0.4</uiIconScale>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>300</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadProducer">
                <baseThreadsProduce>8</baseThreadsProduce>
                <connectRadius>24.9</connectRadius>
                <overloadCount>7500</overloadCount>
                <!-- 批 3 B3：中枢端连点 z+ 偏移（伪 3D 视觉高度；按贴图塔顶实际位置实测定稿） -->
                <linkHeight>5.6</linkHeight>
                <!-- E+F：自定义中枢故障维修资源（原版 CompBreakdownable 已禁用——下方 comp 已移除） -->
                <faultRepairResource>ComponentIndustrial</faultRepairResource>
                <faultRepairCount>2</faultRepairCount>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestTerminal</defName>
        <label>测试终端</label>
        <description>带宽工业系统测试用终端建筑。连接至中枢后消耗编译线程进行生产。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/LegacyElectroicComputer/LegacyElectroicComputer</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(7,4)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(4,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>50</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>1500</WorkToBuild>
            <MaxHitPoints>120</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>150</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>4</baseThreadsCost>


                <!-- 批 3 B3：连接状态标志（贴图路径 XML 可配；高度按终端贴图顶端实测定稿） -->
                <markTexPath>Celes/UI/Overlays/ThreadMark</markTexPath>
                <linkHeight>2.2</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <!-- ═══ 批 2：预热启用变体（B2 验证资产——haveWarmUpCount=true，保留无预热原版对照）═══ -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestTerminalWarmup</defName>
        <label>测试终端（预热）</label>
        <description>带宽工业系统测试用终端建筑（预热变体）：连接后需完成预热倒计时（12500 tick），用于验证预热三态（活跃递减/无信号冻结/断联清零）。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/LabNanoForge/LabNanoForge</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2.5,1.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>50</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>1500</WorkToBuild>
            <MaxHitPoints>120</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <!-- 批 5 前置修订：预热时长单源化（原 comp warmUpTicks 12500 迁此） -->
            <Celes_WarmUpDuration>12500</Celes_WarmUpDuration>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>150</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>4</baseThreadsCost>



                <markTexPath>Celes/UI/Overlays/ThreadMark</markTexPath>
                <linkHeight>1.2</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestRelay</defName>
        <label>测试中继信号塔</label>
        <description>扩展编译线程连接范围的中继设备。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/RelayNode/RelayNode</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.9,3,0.9)</volume>
            </shadowData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <!-- 批 3 B3：连线由中继 PostDraw 绘制——恒绘防视野剔除（放大看对端时线不消失；
             DynamicDrawManager.CullJob 对 drawOffscreen=true 跳过 viewRect 判定，轨道打击基类同款先例） -->
        <drawOffscreen>true</drawOffscreen>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <uiIconScale>0.4</uiIconScale>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <comps>
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadRelay">
                <connectionLimit>3</connectionLimit>
                <connectRadius>7.9</connectRadius>
                <!-- 批 3 B3：中继端连点 z+ 偏移（伪 3D 视觉高度；按贴图顶端实测定稿） -->
                <linkHeight>2.0</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <!-- ═══ 批 5（二类生产·U1 2026-09-29）：a 模型管线测试建筑
         字段对照母本 MechGestatorBase（Biotech Buildings_Production.xml:5-40）+ BenchBase 链 + LabNanoForge；
         comps 逐单元补挂（InteractionGate/UpgradeRecipe/Byproduct 随 U3/U4/U5）；贴图占位（ForgeTerminal 单图），正式美术挂账 ═══ -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestAutoProducer</defName>
        <label>测试自动生产机</label>
        <description>带宽工业系统批5测试建筑：二类生产管线验证（自动生产工作台）。贴图占位。</description>
        <thingClass>CelesFeature.CelesIM_Building_AutoProducer</thingClass>
        <graphicData>
            <texPath>Celes/Building/ShaperNanoForge/ShaperNanoForge</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(3,3)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-2)</interactionCellOffset>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.20</staticSunShadowHeight>
        <pathCost>42</pathCost>
        <surfaceType>Item</surfaceType>
        <containedPawnsSelectable>true</containedPawnsSelectable>
        <canOverlapZones>false</canOverlapZones>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <useHitPoints>true</useHitPoints>
        <uiOrder>1050</uiOrder>
        <costList>
            <Steel>150</Steel>
        </costList>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Cleanliness>0</Cleanliness>
            <WorkTableWorkSpeedFactor>2.0</WorkTableWorkSpeedFactor>

            <!-- 批 5 前置修订：值义反转——1=依赖/0=可离网；本 def 原意可离网（旧值义 1）→ 迁移为 0 -->
            <Celes_ThreadDependency>1</Celes_ThreadDependency>
            <Celes_UnconnectedEfficiency>0.1</Celes_UnconnectedEfficiency>
        </statBases>
        <recipes>
            <li>Celes_AutoRecipe_MakeSpacerRifle</li>
            <li>Celes_AutoRecipe_MakeSaber</li>
        </recipes>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>350</basePowerConsumption>
                <!-- Q2 待机电力（2026-09-30 批复，值参考母本 MechGestator）：消费方=建筑 Tick 250t 分档 -->
                <idlePowerDraw>50</idlePowerDraw>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>4</baseThreadsCost>
                <markTexPath>Celes/UI/Overlays/ThreadMark</markTexPath>
                <linkHeight>1.7</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_ReportWorkSpeedPenalties</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <building>
            <ai_chillDestination>false</ai_chillDestination>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
        </building>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>
</Defs>