<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestCore</defName>
        <label>中枢</label>
        <description>带宽工业系统的中枢建筑。产出编译线程，供范围内的终端设备连接；可加装中枢调整设备（增幅器/平衡器/高级增幅器/协调器）调整线程产出与电力负载。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/SimplifiedControlTower/SimplifiedControlTower</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(15,15)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(3,3)</size>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconScale>0.4</uiIconScale>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>1600</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <!-- 批 7 修订（文本 order）：当前功率修正行置于编译线程产出行之前（comp 序=Inspect 行序） -->
            <li Class="CelesFeature.CelesIM_CompProperties_ProducerPower" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadProducer">
                <baseThreadsProduce>8</baseThreadsProduce>
                <connectRadius>6.9</connectRadius>
                <overloadCount>7500</overloadCount>
                <linkHeight>5.6</linkHeight>
                
                <faultRepairResource>ComponentIndustrial</faultRepairResource>
                <faultRepairCount>2</faultRepairCount>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Celes_TestProducerAmplifier</li>
                    <li>Celes_TestBalancer</li>
                    <li>Celes_TestAdvAmplifier</li>
                    <li>Celes_TestCoordinator</li>
                </linkableFacilities>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestRelay</defName>
        <label>中继信号塔</label>
        <description>扩展编译线程连接范围的中继设备。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/RelayNode/RelayNode</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.9,3,0.9)</volume>
            </shadowData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <!-- 批 3 B3：连线由中继 PostDraw 绘制——恒绘防视野剔除（放大看对端时线不消失；
             DynamicDrawManager.CullJob 对 drawOffscreen=true 跳过 viewRect 判定，轨道打击基类同款先例） -->
        <drawOffscreen>true</drawOffscreen>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <uiIconScale>0.4</uiIconScale>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>8</Mass>
        </statBases>
        <comps>
            <!-- 批 7（需求 0）：7 连接数 / 范围 4.9 -->
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadRelay">
                <connectionLimit>7</connectionLimit>
                <connectRadius>4.9</connectRadius>
                <forwardOnlyRadiusBonus>4</forwardOnlyRadiusBonus>
                
                <linkHeight>2.0</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- 批 7（需求 0）：高级中继信号塔——低连接数、超远范围（3 / 24.9） -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestRelayAdv</defName>
        <label>高级中继信号塔</label>
        <description>扩展编译线程连接范围的高级中继设备：连接数低，但范围极远。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/RelayNode/RelayNode</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.9,3,0.9)</volume>
            </shadowData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <drawOffscreen>true</drawOffscreen>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <uiIconScale>0.4</uiIconScale>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>8</Mass>
        </statBases>
        <comps>
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadRelay">
                <connectionLimit>3</connectionLimit>
                <connectRadius>16.9</connectRadius>
                <forwardOnlyRadiusBonus>10</forwardOnlyRadiusBonus>
                <linkHeight>2.0</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- ═══ 批 5（二类生产·U1 2026-09-29）：a 模型管线测试建筑
         字段对照母本 MechGestatorBase（Biotech Buildings_Production.xml:5-40）+ BenchBase 链 + LabNanoForge；
         comps 逐单元补挂（InteractionGate/UpgradeRecipe/Byproduct 随 U3/U4/U5）；贴图占位（ForgeTerminal 单图），正式美术挂账 ═══ -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestAutoProducer</defName>
        <label>测试自动生产机</label>
        <description>带宽工业系统批5测试建筑：二类生产管线验证（自动生产工作台）。贴图占位。</description>
        <thingClass>CelesFeature.CelesIM_Building_AutoProducer</thingClass>
        <graphicData>
            <texPath>Celes/Building/ShaperNanoForge/ShaperNanoForge</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(3,3)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-2)</interactionCellOffset>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.20</staticSunShadowHeight>
        <pathCost>42</pathCost>
        <surfaceType>Item</surfaceType>
        <containedPawnsSelectable>true</containedPawnsSelectable>
        <canOverlapZones>false</canOverlapZones>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <useHitPoints>true</useHitPoints>
        <uiOrder>1050</uiOrder>
        <costList>
            <Steel>150</Steel>
        </costList>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Cleanliness>0</Cleanliness>
            <WorkTableWorkSpeedFactor>2.0</WorkTableWorkSpeedFactor>

            <Celes_WarmUpDuration>12500</Celes_WarmUpDuration>
            <Celes_ThreadDependency>1</Celes_ThreadDependency>
            <Celes_UnconnectedEfficiency>0.1</Celes_UnconnectedEfficiency>
        </statBases>
        <recipes>
            <li>Celes_AutoRecipe_MakeSpacerRifle</li>
            <li>Celes_AutoRecipe_MakeSaber</li>
            <!-- 批 6 D：锁定配方（默认隐藏——解锁增幅器链接后可见+可挂单） -->
            <li>Celes_AutoRecipe_MakeLockedRifle</li>
            <!-- b 模型两配方（MakeMechTest/MakeMechCleaner）随 Defs_Biotech 条件目录（D33）——
                 此处不硬链（无 Biotech 时配方 def 不存在=悬空红字），由 Defs_Biotech/Patches/
                 Biotech_Recipes_Link.xml 按条件追加 -->
        </recipes>
        <comps>
            <!-- 批 6 收尾修正②：Inspect 工作速度系数行（原版 BenchBase 同款 comp——终端无 BenchBase
                 父故历来缺此行，stats 页有=statBases 独立解析；值+原版原因括号免费；A 柜贡献显示在
                 尘构机效率行括号——statOffsets 落点不同，两行括号各自语义正确；置 comps 首位=
                 复刻 BenchBase 继承序（工作台族该行恒最上） -->
            <li Class="CompProperties_ReportWorkSpeed">
                <workSpeedStat>WorkTableWorkSpeedFactor</workSpeedStat>
            </li>
            <!-- 批 6 收尾修正：星铃调频形态 A（bill 旗标判定——D36 原语义，comp 化=挂载点显式化） -->
            <li Class="CelesFeature.CelesIM_CompProperties_StarlinkTuning">
                <mode>AutoBill</mode>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>350</basePowerConsumption>
                <!-- Q2 待机电力（2026-09-30 批复，值参考母本 MechGestator）：消费方=建筑 Tick 250t 分档 -->
                <idlePowerDraw>50</idlePowerDraw>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>4</baseThreadsCost>
                <markTexPath>Celes/UI/Overlays/ThreadMark</markTexPath>
                <linkHeight>1.7</linkHeight>
            </li>
            <!-- ═══ U2 追加（2026-10-02）：三态状态指示灯（贴图对位方案）═══
                 texPath 写基础名（不带 _south）——引擎按朝向解析变体族（_north/_east/_south/_west，
                 同 Glow 族命名约定）；现仅 _south 一张时缺向回退=引擎 offset 旋转复用（全朝向正确）；
                 红=未工作/装料/等待操作/冻结，蓝=锻造中，绿=完成待取；实心 Cutout 染色无 R 通道坑；
                 drawSize 与底图一致=640² 画布 1:1 对位（灯点画布位=世界位） -->
            <li Class="CelesFeature.CelesIM_CompProperties_StatusLight">
                <texPath>Celes/Building/ShaperNanoForge/ShaperNanoForge_Light</texPath>
                <drawSize>(5,5)</drawSize>
                <colorIdle>(0.9, 0.2, 0.2)</colorIdle>
                <colorWorking>(0.4, 0.7, 1.0)</colorWorking>
                <colorComplete>(0.3, 0.9, 0.4)</colorComplete>
            </li>
            <!-- 批 6 A/C/D：增幅器白名单（受影响侧主动扫描；各 def 轴1上限=各自 maxSimultaneous 互不挤占） -->
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Celes_TestToolCabinet</li>
                    <li>Celes_TestOverclocker</li>
                    <li>Celes_TestRecipeUnlocker</li>
                </linkableFacilities>
            </li>
            <!-- 批 6 C：超频 comp（Toggle 出现于终端侧=「连接时终端获得」；解锁唯一条件=超频器链接） -->
            <li Class="CelesFeature.CelesIM_CompProperties_Overclock">
                <efficiencyFactor>2.0</efficiencyFactor>
                <threadCostFactor>2.0</threadCostFactor>
                <iconPath>Celes/UI/Icons/ThreadConnect</iconPath>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_ReportWorkSpeedPenalties</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <building>
            <ai_chillDestination>false</ai_chillDestination>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
            <barDrawData>
                <north>
                    <preRotationOffset>(-1.04, -1.05)</preRotationOffset>
                    <size>(0.7, 0.13)</size>
                </north>
                <south>
                    <preRotationOffset>(0, -1.05)</preRotationOffset>
                    <size>(1.5, 0.13)</size>
                </south>
                <east>
                    <preRotationOffset>(0, -1.05)</preRotationOffset>
                    <size>(1.5, 0.13)</size>
                </east>
                <west>
                    <preRotationOffset>(0, -1.05)</preRotationOffset>
                    <size>(1.5, 0.13)</size>
                </west>
            </barDrawData>
        </building>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <!-- ═══════════════════════════════════════════════════════════════════
         批 6 增幅器四塔（2026-10-03 · 审计批准版）——全部 1×2、贴图 Celes_Amplifier（256×384
         =drawSize(2,3) 逐格 128px）、Graphic_Single 南向制（D35）、纯 facility 直连不经中继。
         连接上限两轴：轴1 maxSimultaneous=受影响侧每目标本 def 上限（原版字段）；
         轴2 maxLinkedTargets=每台设施服务目标上限（我方 AmplifierFacility 字段，-1=不限）。
         无状态灯（暂无灯图，补图即挂单行 XML）；数值全占位实测。
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- B 中枢增幅器（Producer Effect）：无需线程仅耗电；每台+4 线程产出（计入 TotalCapacity 直显）。
         每中枢最多 4 台（轴1），每台只连 1 个中枢（轴2） -->
    <!-- 批 7（需求 1 / D45）：中枢增幅器——+8 线程 / +2000W 中枢负载；限 4 台；贴图自测试终端移交（D50） -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestProducerAmplifier</defName>
        <label>中枢增幅器</label>
        <description>链接中枢的增益设施：提升中枢的编译线程产出 +8，同时增加中枢 2000W 电力负载。必须直连中枢或经中枢协调器托管（纯设施链接，不经过中继）。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/LegacyElectroicComputer/LegacyElectroicComputer</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(7,4)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(4,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>100</Steel>
        </costList>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>25</Mass>
        </statBases>
        <comps>
            <!-- 批 7：自带电力移除（D45 需求 1——负载改挂中枢：producerPowerOffset +2000W）；
                 ProducerDevice 族基=开关（D44）+CanBeActive 单门；maxDistance 6.9=中枢连接半径（D54） -->
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <compClass>CelesFeature.CelesIM_CompFacility_ProducerDevice</compClass>
                <maxSimultaneous>4</maxSimultaneous>
                <maxLinkedTargets>1</maxLinkedTargets>
                <maxDistance>6.9</maxDistance>
            </li>
        </comps>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_AmplifierExt">
                <boostPerUnit>8</boostPerUnit>
                <producerPowerOffset>2000</producerPowerOffset>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowProducerLinks</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- 批 7（需求 2）：中枢平衡器——降低中枢 1600W 电力负载；占用 2 线程（设施+消费者双身份） -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestBalancer</defName>
        <label>中枢平衡器</label>
        <description>链接中枢的调节设施：降低中枢 1600W 电力负载，同时占用 2 编译线程。必须直连中枢或经中枢协调器托管；断线程即失效。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_Amplifier</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,3)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(1,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>100</Steel>
        </costList>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Celes_ThreadDependency>1</Celes_ThreadDependency>
            <Mass>10</Mass>
        </statBases>
        <comps>
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <compClass>CelesFeature.CelesIM_CompFacility_ProducerDevice</compClass>
                <maxSimultaneous>2</maxSimultaneous>
                <maxLinkedTargets>1</maxLinkedTargets>
                <maxDistance>6.9</maxDistance>
            </li>
            <!-- 批 7（需求 2）：线程消费者身份——占用 2 线程（断线程→CanBeActive 失活→电力减项停） -->
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>2</baseThreadsCost>
            </li>
        </comps>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_AmplifierExt">
                <producerPowerOffset>-1600</producerPowerOffset>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowProducerLinks</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- 批 7（需求 3）：中枢高级增幅器——+20 线程 / +3600W 中枢负载；限 2 台 -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestAdvAmplifier</defName>
        <label>中枢高级增幅器</label>
        <description>链接中枢的高级增益设施：提升中枢的编译线程产出 +20，同时增加中枢 3600W 电力负载。必须直连中枢或经中枢协调器托管。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_Amplifier</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,3)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(1,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>100</Steel>
        </costList>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>10</Mass>
        </statBases>
        <comps>
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <compClass>CelesFeature.CelesIM_CompFacility_ProducerDevice</compClass>
                <maxSimultaneous>2</maxSimultaneous>
                <maxLinkedTargets>1</maxLinkedTargets>
                <maxDistance>6.9</maxDistance>
            </li>
        </comps>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_AmplifierExt">
                <boostPerUnit>20</boostPerUnit>
                <producerPowerOffset>3600</producerPowerOffset>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowProducerLinks</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- 批 7（需求 4 / D45）：中枢协调器——扩容枢纽（被视作中枢：以中枢同限托管增幅器族；
         自身不产加成、电力 ×3 乘区（≤2 台=×9）；必须紧贴中枢（maxDistance 2.5=斜角可放最小中心距 D54）；
         协调器不在任何白名单内=协调器互链天然阻断 -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestCoordinator</defName>
        <label>中枢协调器</label>
        <description>中枢的扩容枢纽：可像中枢一样托管增幅器/平衡器（加成回流至其直连中枢），并将中枢电力乘 3。必须紧贴中枢放置；协调器之间不可互相连接。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_Amplifier</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,3)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(1,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>100</Steel>
        </costList>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>10</Mass>
        </statBases>
        <comps>
            <!-- 对上：中枢设施——紧贴中枢（maxDistance 2.5）；中枢侧接纳 ≤2 台（maxSimultaneous） -->
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <compClass>CelesFeature.CelesIM_CompFacility_ProducerDevice</compClass>
                <maxSimultaneous>2</maxSimultaneous>
                <maxLinkedTargets>1</maxLinkedTargets>
                <maxDistance>6.9</maxDistance>
            </li>
            <!-- 对下：受影响侧宿主（被视作中枢）——托管增幅器族 -->
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Celes_TestProducerAmplifier</li>
                    <li>Celes_TestBalancer</li>
                    <li>Celes_TestAdvAmplifier</li>
                </linkableFacilities>
            </li>
        </comps>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_AmplifierExt">
                <producerPowerFactor>3</producerPowerFactor>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowProducerLinks</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- A 工具柜型增幅器：需线程不耗电（断链失活）；尘构机效率 +0.1（statOffsets 原生注入+显示）。
         每终端最多 2 台（轴1），每台可服务任意数量终端（轴2=-1）；可 uninstall 搬迁重链接 -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestToolCabinet</defName>
        <label>测试工具柜</label>
        <description>链接尘构终端的增益设施：提升终端的尘构机效率。自身作为线程消费者依赖网络（断链即失活），不耗电。可拆除搬运到别处重新链接。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_Amplifier</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,3)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(1,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>80</Steel>
        </costList>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>10</Mass>
        </statBases>
        <comps>
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <compClass>CelesFeature.CelesIM_CompFacility_Threaded</compClass>
                <statOffsets>
                    <Celes_ThreadLinkEfficiency>0.1</Celes_ThreadLinkEfficiency>
                </statOffsets>
                <maxSimultaneous>2</maxSimultaneous>
                <maxLinkedTargets>-1</maxLinkedTargets>
            </li>
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>1</baseThreadsCost>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- C 超频器：链接终端解锁超频 Toggle（建造需科技——未解锁不可建造；建了并链接即可超频）。
         严格 1:1（轴1=1/轴2=1）；批 7（Q3/D47）：0 电——带宽=激活时终端占用×2（现行机制不变）；
         效率×2 与线程占用×2 均作用于终端 -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestOverclocker</defName>
        <label>超频器</label>
        <description>链接尘构终端后解锁终端的超频开关：以双倍线程占用换取尘构机效率加倍。与终端严格一对一链接。需要研究超频技术后才能建造。自身零耗电。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_Amplifier</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,3)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(1,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <researchPrerequisites>
            <li>Celes_Research_Overclock</li>
        </researchPrerequisites>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>10</Mass>
        </statBases>
        <comps>
            <!-- 批 7（Q3）：自带电力移除——0 电（带宽成本经终端占用体现） -->
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <maxSimultaneous>1</maxSimultaneous>
                <maxLinkedTargets>1</maxLinkedTargets>
            </li>
        </comps>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_AmplifierExt">
                <unlockOverclock>true</unlockOverclock>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowProducerLinks</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- D 解锁增幅器：携配方解锁标签（链接终端后锁定配方可见+可挂单）。严格 1:1（轴1=1/轴2=1）；
         批 7（D49/Q3）：0 电 + ≥1 线程/台（依赖型消费者）——不工作（断线程）不激活配方 -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestRecipeUnlocker</defName>
        <label>配方解锁增幅器</label>
        <description>链接尘构终端后解锁带锁配方（默认隐藏的特殊配方）。与终端严格一对一链接，断开链接后配方重新隐藏。占用 1 编译线程；未在工作状态时配方不激活。自身零耗电。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_Amplifier</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,3)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <size>(1,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>80</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Celes_ThreadDependency>1</Celes_ThreadDependency>
            <Mass>10</Mass>
        </statBases>
        <comps>
            <!-- 批 7（D49）：自带电力移除 + 消费者身份（≥1 线程/台，XML 可配）；
                 Threaded=消费者门接入 CanBeActive——断线程即失活→锁定配方回隐藏（RecipeWorker_Locked 读门） -->
            <li Class="CelesFeature.CelesIM_CompProperties_AmplifierFacility">
                <compClass>CelesFeature.CelesIM_CompFacility_Threaded</compClass>
                <maxSimultaneous>1</maxSimultaneous>
                <maxLinkedTargets>1</maxLinkedTargets>
            </li>
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>1</baseThreadsCost>
            </li>
        </comps>
        <modExtensions>
            <li Class="CelesFeature.CelesIM_AmplifierExt">
                <unlockRecipeTags>
                    <li>Celes_TestRecipeLock</li>
                </unlockRecipeTags>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowProducerLinks</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>
</Defs>