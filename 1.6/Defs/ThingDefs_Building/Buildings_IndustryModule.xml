<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ========== 中枢计算塔 ========== -->

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_CentralControlTower</defName>
        <label>中枢计算塔</label>
        <description>「域(DOMAIN)」的中枢设备和核心组件，可以负责协调大批数据的统筹处理，其数据处理能力被主要特化为执行尘构的编译与控制运算。也能少量的提供「编译线程」并在有限的信号范围内支持尘构编译运算。\n\n作为星铃尘构作业管理与自主接口节点(Dust-mech Operation Management and Autonomous Interface Node, D.O.M.A.I.N.)的核心组件，事实上，中枢计算塔也承担能量整流和无线输电的功能，因此「域」内的几乎所有的终端设备都不需要消耗电力，但中枢计算塔会随着「编译线程」上限的提升大幅增加耗电量。这不取决于使用的「编译线程」，而仅仅取决于「编译线程」的上限。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/CentralControlTower/CentralControlTower</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(17,17)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(3,3)</size>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconScale>0.4</uiIconScale>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <useHitPoints>true</useHitPoints>
        <uiOrder>990</uiOrder>
        <costList>
            <Steel>200</Steel>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>Celes_MainTech_I</li>
        </researchPrerequisites>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>1600</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            
            <li Class="CelesFeature.CelesIM_CompProperties_ProducerPower" />
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadProducer">
                <baseThreadsProduce>8</baseThreadsProduce>
                <connectRadius>6.9</connectRadius>
                <overloadCount>7500</overloadCount>
                <linkHeight>6.4</linkHeight>
                <faultRepairResource>ComponentIndustrial</faultRepairResource>
                <faultRepairCount>2</faultRepairCount>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Celes_AmplifierBasic</li>
                    <li>Celes_AmplifierNode</li>
                    <li>Celes_AmplifierAdvanced</li>
                    <li>Celes_Balancer</li>
                    <li>Celes_Coordinator</li>
                </linkableFacilities>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <!-- ========== 中继 ========== -->

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_RelayNode</defName>
        <label>转发单元</label>
        <description>扩展中枢设备编译线程信号覆盖范围的中继设备，只能连接有限数量的其他设备。在禁用终端设备连接后，能优化传输协议而增加信号范围。中继设备不占用「编译线程」。\n\n依靠这种外部配置的传输协议模式，转发单元能兼顾连接数量和连接距离。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/RelayNode/RelayNode</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.9,3,0.9)</volume>
            </shadowData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <!-- 连线由中继 PostDraw 绘制——恒绘防视野剔除（drawOffscreen=true 跳过 viewRect 判定） -->
        <drawOffscreen>true</drawOffscreen>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <uiIconScale>0.4</uiIconScale>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>8</Mass>
        </statBases>
        <researchPrerequisites>
            <li>Celes_MainTech_I</li>
        </researchPrerequisites>
        <comps>
            <!-- 7 连接数 / 范围 4.9 -->
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadRelay">
                <connectionLimit>7</connectionLimit>
                <connectRadius>4.9</connectRadius>
                <forwardOnlyRadiusBonus>4</forwardOnlyRadiusBonus>

                <linkHeight>2.0</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>

    <!-- 高级中继信号塔——低连接数、超远范围（3 / 16.9） -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_RelayNodeAdvanced</defName>
        <label>束流转发塔</label>
        <description>扩展中枢设备编译线程信号覆盖范围的塔状中继设备，只能连接极其有限数量的其他设备。在禁用终端设备连接后，能优化传输协议而大幅增加信号范围。\n\n这种转发单元为了扩大信号传输距离而削减了可用频段数量，因而只能连接更少的其他设备。但这提供了极其巨大的信号传输范围，加上传输协议的优化模式，适合用作长距离中继而非局域连接。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/RelayNodeAdvanced/RelayNodeAdvanced</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(6,6)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.9,3,0.9)</volume>
            </shadowData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <drawOffscreen>true</drawOffscreen>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <uiIconOffset>(0, 0.3)</uiIconOffset>
        <uiIconScale>0.4</uiIconScale>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>8</Mass>
        </statBases>
        <researchPrerequisites>
            <li>Celes_Manufactory_I</li>
        </researchPrerequisites>
        <comps>
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadRelay">
                <connectionLimit>3</connectionLimit>
                <connectRadius>16.9</connectRadius>
                <forwardOnlyRadiusBonus>10</forwardOnlyRadiusBonus>
                <linkHeight>2.3</linkHeight>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
    </ThingDef>
    
    <!-- ========== 纳米锻炉系 ========== -->

    <!-- 「塑造」纳米锻炉 -->
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_NanoForgeShaper</defName>
        <label>「塑造」纳米锻炉</label>
        <description>基础型号的自动化纳米锻炉，无需人力工作持续编译，但需要占用「编译线程」以编译和控制尘构自主执行配方。\n\n这种纳米锻炉的效率不及熟练工匠，但全天候可用加之「域」内的无线输电模式使其完全可作为具有竞争力的加工设备。</description>
        <thingClass>CelesFeature.CelesIM_Building_AutoProducer</thingClass>
        <graphicData>
            <texPath>Celes/Building/NanoForgeShaper/NanoForgeShaper</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(2,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.5</fillPercent>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.20</staticSunShadowHeight>
        <pathCost>42</pathCost>
        <surfaceType>Item</surfaceType>
        <containedPawnsSelectable>true</containedPawnsSelectable>
        <canOverlapZones>false</canOverlapZones>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <useHitPoints>true</useHitPoints>
        <uiOrder>1010</uiOrder>
        <costList>
            <Steel>100</Steel>
            <CelesAlloy>70</CelesAlloy>
            <ComponentIndustrial>3</ComponentIndustrial>
            <Celes_NanoComponent>2</Celes_NanoComponent>
        </costList>
        <statBases>
            <WorkToBuild>4000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Cleanliness>0</Cleanliness>
            <WorkTableWorkSpeedFactor>0.8</WorkTableWorkSpeedFactor>
            
            <Celes_WarmUpDuration>12500</Celes_WarmUpDuration>
            <Celes_ThreadDependency>1</Celes_ThreadDependency>
            <Celes_UnconnectedEfficiency>0.1</Celes_UnconnectedEfficiency>
        </statBases>
        <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>Celes_MainTech_II</li>
        </researchPrerequisites>
        <recipes>
            <li>Celes_AutoRecipe_NanoMachineDirect</li>
            <li>Celes_AutoRecipe_LayeredCrystal</li>
            <li>Celes_AutoRecipe_NanoMachineByChip</li>
            <li>Celes_AutoRecipe_Alloy</li>
            <li>Celes_AutoRecipe_NanoComponent</li>
            <li>Celes_AutoRecipe_Component</li>
            <li>Celes_AutoRecipe_Cloth</li>
            <li>Celes_AutoRecipe_ClothByCloth</li>
            <li>Celes_AutoRecipe_GelFromFood</li>
        </recipes>
        <comps>
            <!-- Inspect 工作速度系数行（工作台族惯例置首位） -->
            <li Class="CompProperties_ReportWorkSpeed">
                <workSpeedStat>WorkTableWorkSpeedFactor</workSpeedStat>
            </li>
            <!-- 星铃调频形态 A（bill 旗标判定） -->
            <li Class="CelesFeature.CelesIM_CompProperties_CelestiaSync">
                <mode>AutoBill</mode>
            </li>
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>2</baseThreadsCost>
                <markTexPath>Celes/UI/Overlays/ThreadMark</markTexPath>
                <linkHeight>1.7</linkHeight>
            </li>
            <!-- 三态状态灯：红=待机/冻结，蓝=锻造中，绿=完成待取（texPath 写基础名，引擎按朝向解析变体族） -->
            <li Class="CelesFeature.CelesIM_CompProperties_StatusLight">
                <texPath>Celes/Building/NanoForgeShaper/NanoForgeShaper_Light</texPath>
                <drawSize>(3,3)</drawSize>
                <colorIdle>(0.9, 0.2, 0.2)</colorIdle>
                <colorWorking>(0.4, 0.7, 1.0)</colorWorking>
                <colorComplete>(0.3, 0.9, 0.4)</colorComplete>
            </li>
            <!-- 增幅器白名单（受影响侧主动扫描；各 def 轴1上限=各自 maxSimultaneous 互不挤占） -->
            <!-- 锻造流光（每炉各自 mote 经 comp 直配：本炉=Celes_Mote_NanoForgeShaperGlow_South） -->
            <li Class="CelesFeature.CelesIM_CompProperties_ForgeGlow">
                <glowMoteDef>Celes_Mote_NanoForgeShaperGlow_South</glowMoteDef>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Celes_NanoForgeCabinet</li>
                    <li>Celes_Overclocker</li>
                </linkableFacilities>
            </li>
            <!-- 超频（Toggle 出现于本机侧=「连接超频器时获得」）：效率×2.5 / 线程×2 -->
            <li Class="CelesFeature.CelesIM_CompProperties_Overclock">
                <efficiencyFactor>2.5</efficiencyFactor>
                <threadCostFactor>2</threadCostFactor>
                <iconPath>Celes/UI/Icons/ThreadConnect</iconPath>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_ReportWorkSpeedPenalties</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <building>
            <ai_chillDestination>false</ai_chillDestination>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
            <barDrawData>
                <north>
                    <preRotationOffset>(-0.84, -0.55)</preRotationOffset>
                    <size>(0.7, 0.13)</size>
                </north>
                <south>
                    <preRotationOffset>(0, -1.05)</preRotationOffset>
                    <size>(1.5, 0.13)</size>
                </south>
                <east>
                    <preRotationOffset>(0, -1.05)</preRotationOffset>
                    <size>(1.5, 0.13)</size>
                </east>
                <west>
                    <preRotationOffset>(0, -1.05)</preRotationOffset>
                    <size>(1.5, 0.13)</size>
                </west>
            </barDrawData>
        </building>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

