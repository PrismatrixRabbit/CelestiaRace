<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- W-1.5：落地支援信标——投掷物落地生成的"支援进行中"实体（category Ethereal：无物理交互/不可拾取/不阻挡）
         贴图 = 投掷物贴图占位（Things/Projectile/GrenadeEMP——用户裁决：apparel 用 weapon 贴图 EMPGrenades，落地信标用 projectile 贴图）
         光柱 = comp CelesFD_CompSupportBeam（PostDraw 自绘竖立 mesh——复刻 CompOrbitalBeam 去倾角；颜色 SupportDef.beamColor RGB）
         生命周期 = 触发后 5s 销毁（贴图+光柱一体——光柱随信标销毁自然消失） -->
    <ThingDef>
        <defName>CelesFD_SupportBeacon</defName>
        <label>支援呼叫信标</label>
        <thingClass>CelesFeature.CelesFD_SupportBeacon</thingClass>
        <category>Ethereal</category>
        <tickerType>Normal</tickerType>
        <drawerType>RealtimeOnly</drawerType>
        <drawOffscreen>true</drawOffscreen>
        <altitudeLayer>Item</altitudeLayer>
        <graphicData>
            <texPath>Things/Projectile/GrenadeEMP</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.0,1.0)</drawSize>
        </graphicData>
        <comps>
            <li>
                <compClass>CelesFeature.CelesFD_CompSupportBeam</compClass>
            </li>
        </comps>
    </ThingDef>

</Defs>
