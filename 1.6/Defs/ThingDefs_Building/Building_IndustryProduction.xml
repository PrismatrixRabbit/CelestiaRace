<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestCore</defName>
        <label>测试中枢</label>
        <description>带宽工业系统测试用中枢建筑。产出编译线程，供范围内的终端设备连接。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_MultifunctionalTabA/Celes_MultifunctionalTabA</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2.5,2.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(2,2)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>300</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CompProperties_ThreadProducer">
                <baseThreadsProduce>8</baseThreadsProduce>
                <connectRadius>24.9</connectRadius>
                <overloadCount>7500</overloadCount>

                <indicatorTexPath>Celes/Building/Celes_Indicator_ThreadLine</indicatorTexPath>
                <indicatorDrawSize>(1.0, 1.5)</indicatorDrawSize>
                <indicatorVerticalOffset>1.3</indicatorVerticalOffset>
            </li>
            <li Class="CompProperties_Breakdownable"/>
        </comps>
        <placeWorkers>
            <li>CelesFeature.PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestTerminal</defName>
        <label>测试终端</label>
        <description>带宽工业系统测试用终端建筑。连接至中枢后消耗编译线程进行生产。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_MultifunctionalTabA/Celes_MultifunctionalTabA</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2.5,1.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>50</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>1500</WorkToBuild>
            <MaxHitPoints>120</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>150</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CompProperties_ThreadConsumer">
                <baseThreadsCost>4</baseThreadsCost>
                <produceEffic>1.0</produceEffic>
                <canWorkOffline>true</canWorkOffline>
                <offlineFactor>0.5</offlineFactor>
                <haveWarmUpCount>false</haveWarmUpCount>
                <warmUpTicks>12500</warmUpTicks>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>Celes_TestRelay</defName>
        <label>测试中继信号塔</label>
        <description>扩展编译线程连接范围的中继设备。</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_MultifunctionalTabA/Celes_MultifunctionalTabA</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(1.0,1.0)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <size>(1,1)</size>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>200</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CelesFeature.CompProperties_ThreadRelay">
                <connectionLimit>3</connectionLimit>
                <connectRadius>7.9</connectRadius>

                <indicatorTexPath>Celes/Building/Celes_Indicator_ThreadLine</indicatorTexPath>
                <indicatorDrawSize>(1.0, 1.5)</indicatorDrawSize>
                <indicatorVerticalOffset>1.3</indicatorVerticalOffset>

                <childIndicatorTexPath>Celes/Building/Celes_Indicator_ThreadLineRelay</childIndicatorTexPath>
                <childIndicatorDrawSize>(0.6, 1.0)</childIndicatorDrawSize>
                <childIndicatorVerticalOffset>1.3</childIndicatorVerticalOffset>
            </li>
        </comps>
        <placeWorkers>
            <li>CelesFeature.PlaceWorker_ShowThreadConnection</li>
        </placeWorkers>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>
    </ThingDef>
</Defs>