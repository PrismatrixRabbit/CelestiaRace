<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 尘构晶簇：Mineable 建筑，原版开采系统零改动接入 -->
  <!-- [事实] 结构参照原版 MineableSteel（Core Buildings_Natural.xml:91-113）与 RockBase 继承链 -->
  <ThingDef ParentName="BuildingNaturalBase">
    <defName>Celes_CrystalCluster</defName>
    <label>尘构晶簇</label>
    <description>由晶体培育器或野外晶种催生的晶态物质簇。会随时间生长分级，采矿获得初始晶态材料。</description>
    <thingClass>CelesFeature.CelesIM_CrystalCluster</thingClass>
    <graphicData>
      <texPath>Celes/Building/CrystalCluster/CrystalCluster_1</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <tickerType>Long</tickerType>
    <fillPercent>0.5</fillPercent>
    <mineable>true</mineable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <mineableThing>Celes_CrystallineMaterial</mineableThing>
      <mineableYield>1</mineableYield>
      <!-- [事实] mineableDropChance=0：关闭基类 Mineable 产出（Mineable.cs:68 判定），产出由 Comp.PostDestroy 按等级自产 -->
      <mineableDropChance>0</mineableDropChance>
    </building>
    <comps>
      <li Class="CelesFeature.CelesIM_CompProperties_CrystalCluster">
        <levelGraphics>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_1</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_2</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_3</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
          <li>
            <texPath>Celes/Building/CrystalCluster/CrystalCluster_4</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </li>
        </levelGraphics>
        <!-- dev 直接生成时的默认参数（培育器/晶种生成时由 InitGrowth 覆盖） -->
        <pointToGrow>
          <li>0</li>
          <li>2</li>
          <li>5</li>
          <li>10</li>
        </pointToGrow>
        <!-- dev 兜底参数（培育器/晶种生成时由 InitGrowth 覆盖）：两晶态地板 -->
        <terrainToGrow>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </terrainToGrow>
        <!-- 豁免地板：人工晶态表面/晶化表面铺到晶簇脚下不触发地板替换破坏 -->
        <protectedTerrains>
          <li>Celes_CrystalFloor</li>
          <li>Celes_CrystalSurface</li>
        </protectedTerrains>
        <!-- 各等级开采产出 1/2/4/16 -->
        <yieldByLevel>
          <li>1</li>
          <li>2</li>
          <li>4</li>
          <li>16</li>
        </yieldByLevel>
      </li>
    </comps>
  </ThingDef>

</Defs>
