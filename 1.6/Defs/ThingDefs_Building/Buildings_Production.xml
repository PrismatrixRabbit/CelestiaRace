<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BenchBase">
        <defName>Celes_LabNanoForge</defName><!-- 星铃小型纳米锻炉 --><!-- 待编辑 -->
        <label>星铃小型纳米锻炉</label>
        <description>一台小型的纳米锻炉，可以使用恰当的技术蓝图，使用尘构作为工具合成需要的物品。</description>
        <thingClass>Building_WorkTable</thingClass>
        <graphicData>
            <texPath>Celes/Building/LabNanoForge/LabNanoForge</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(4.0,2.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <!-- 批 4：BuildingBase 继承链默认 MapMeshOnly——不注册动态绘制则 PostDraw（连接标志）不执行；
             MapMeshAndRealTime=贴图烘焙+PostDraw 实时（TestTerminal 同款，工作台族标准双通道） -->
        <drawerType>MapMeshAndRealTime</drawerType>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Cleanliness>0</Cleanliness>
            <WorkTableWorkSpeedFactor>1.5</WorkTableWorkSpeedFactor>
            
            <Celes_WarmUpDuration>12500</Celes_WarmUpDuration>
            <Celes_UnconnectedEfficiency>0.35</Celes_UnconnectedEfficiency>
        </statBases>
        <size>(3,1)</size>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <uiOrder>1000</uiOrder>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
        <recipes>
            <li>Celes_TestRecipe_Component</li>
        </recipes>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>400</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Glower">
				<glowRadius>5</glowRadius>
				<glowColor>(73,123,138,0)</glowColor>
			</li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
			<li Class="CompProperties_Breakdownable"/>
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>4</baseThreadsCost>



                <markTexPath>Celes/UI/Overlays/ThreadMark</markTexPath>
                <linkHeight>1.7</linkHeight>
            </li>
            <!-- 批 6 收尾修正：星铃调频形态 B（操作者=星铃 race 正在本台工作 → 尘构机效率 ×1.2，
                 经 P1 postfix 自动传导工作速度系数；显示全链免费——尘构机效率行/工作速度系数行
                 （BenchBase 继承）/InfoCard 分解行） -->
            <li Class="CelesFeature.CelesIM_CompProperties_StarlinkTuning">
                <mode>OperatorAtWork</mode>
            </li>
        </comps>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
		</building>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>Celes_MainTech_I</li>
		</researchPrerequisites>
		<placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_ReportWorkSpeedPenalties</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
            <li>CelesFeature.CelesIM_PlaceWorker_ShowThreadConnection</li>
		</placeWorkers>
    </ThingDef>

    <ThingDef ParentName="BenchBase">
        <defName>Celes_TailoringTab</defName><!-- 星铃缝纫台 --><!-- 待编辑 -->
        <label>星铃缝纫台</label>
        <description>带有一系列缝纫工具的星铃缝纫台，所有的规格按照星铃标准制造，用于缝制星铃衣物。没电时的工作速度只有平时的50%。</description>
        <thingClass>Building_WorkTable</thingClass>
        <graphicData>
            <texPath>Celes/Building/Celes_TailoringTab/Celes_TailoringTab</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(3.5,1.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>180</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Cleanliness>0</Cleanliness>
        </statBases>
        <size>(3,1)</size>
        <designationCategory>Celes_SpecialBuildings</designationCategory>
        <uiOrder>2510</uiOrder>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <building>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<unpoweredWorkTableWorkSpeedFactor>0.5</unpoweredWorkTableWorkSpeedFactor>
        </building>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>120</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
			<li Class="CompProperties_Breakdownable"/>
            <!--
            <li Class="CelesFeature.CelesIM_CompProperties_ThreadConsumer">
                <baseThreadsCost>4</baseThreadsCost>
            </li>
            -->
        </comps>
        <placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
            <li>Electricity</li>
			<li>Celes_Apparel_I</li>
		</researchPrerequisites>
    </ThingDef>

</Defs>