    </ThingDef>

    <!--==================================== 「魔杖」终端 ====================================-->
    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_StandardStaff</defName>
        <label>「魔杖」终端</label>
        <description>杖状便携式尘构编译与指令终端，代号「魔杖」，其发射的弹丸可以搭载不同种类的尘构，常态分为用于维护机械和结构的维护模式和用于维护调试电子设备的电磁模式。\n\n通常被科考队的技术人员作为维护工具使用，虽然大多数情况下没有杀伤性能，但在作战超频时，维护模式可以维修和增强机械体性能，而电磁模式提供定点的减速与削弱能力。</description>
        <graphicData>
            <texPath>Celes/Weapon/Standard/StandardStaff</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>0.9</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <equippedAngleOffset>-65</equippedAngleOffset>
        <soundInteract>Interact_ChargeRifle</soundInteract>
        <statBases>
            <WorkToMake>30000</WorkToMake>
            <Mass>2.5</Mass>
            <AccuracyTouch>0.65</AccuracyTouch>
            <AccuracyShort>0.75</AccuracyShort>
            <AccuracyMedium>0.60</AccuracyMedium>
            <AccuracyLong>0.50</AccuracyLong>
            <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <CelesAlloy>50</CelesAlloy>
            <Celes_Substrate>8</Celes_Substrate>
            <Celes_NanoComponent>4</Celes_NanoComponent>
        </costList>
        <recipeMaker>
            <label>锻造指令：「魔杖」终端</label>
            <researchPrerequisites>
                <li>Celes_Weapon_III</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
            <displayPriority>5524</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletStandardStaff</defaultProjectile>
                <warmupTime>0.8</warmupTime>
                <range>25.9</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>Shot_ChargeRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>3</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>杖头</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>15.7</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="CelesFeature.Celes_CompProperties_EquippableHediff">
                <hediffDef>Celes_Hediff_TerminalAbilities</hediffDef>
            </li>
        </comps>

        <weaponClasses>
            <li>ShortShots</li>
            <li>RangedLight</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_StandardRangeSupport</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_StandardRange</li>
        </tradeTags>
    </ThingDef>

