    <!--==================================== 魔杖终端 · 云 / 技能 / Hediff ====================================-->

    <ThingDef>
        <defName>Celes_NanoCloud_Maintenance</defName>
        <label>维护纳米云</label>
        <description>弥散的维护型尘构云团，持续修补范围内的结构并维持生物与机械的修复场。</description>
        <thingClass>CelesFeature.Celes_NanoCloud</thingClass>
        <category>None</category>
        <tickerType>Normal</tickerType>
        <altitudeLayer>Gas</altitudeLayer>
        <drawerType>MapMeshAndRealTime</drawerType>
        <selectable>false</selectable>
        <useHitPoints>false</useHitPoints>
        <destroyable>true</destroyable>
        <rotatable>false</rotatable>
        <drawGUIOverlay>false</drawGUIOverlay>
        <neverMultiSelect>true</neverMultiSelect>
        <graphicData>
            <texPath>Things/Mote/Smoke</texPath>
            <graphicClass>Graphic_Gas</graphicClass>
            <shaderType>Transparent</shaderType>
            <!-- 视觉浓度：alpha 0.5 在 5.8×5.8 单层上过淡；提高到 0.8 并加深主色。
                 逻辑半径仍是 comp 的 radius=2.9，drawSize 只影响观感。 -->
            <color>(0.42,0.92,0.78,0.8)</color>
            <drawSize>5.8</drawSize>
        </graphicData>
        <comps>
            <li Class="CelesFeature.Celes_CompProperties_NanoCloud">
                <radius>2.9</radius>
                <durationTicks>2500</durationTicks>
                <tickInterval>60</tickInterval>
                <buildingRepairPerDay>3000</buildingRepairPerDay>
                <buildingRepairOnlyFriendly>true</buildingRepairOnlyFriendly>
                <hediffEntries>
                    <!-- 友方非机械体：自我恢复（止血/慢愈默认开，三开关见 HediffDef） -->
                    <li>
                        <hediffDef>Celes_Hediff_SelfRecovery</hediffDef>
                        <severityPerDayInCloud>1000</severityPerDayInCloud>
                        <maxSeverity>1</maxSeverity>
                        <requireFriendly>true</requireFriendly>
                        <requireNonMechanoid>true</requireNonMechanoid>
                    </li>
                    <!-- 友方机械体：机械修复 -->
                    <li>
                        <hediffDef>Celes_Hediff_MechRecovery</hediffDef>
                        <severityPerDayInCloud>1000</severityPerDayInCloud>
                        <maxSeverity>1</maxSeverity>
                        <requireFriendly>true</requireFriendly>
                        <requireMechanoid>true</requireMechanoid>
                    </li>
                    <!-- 友方机械体：机械增幅 -->
                    <li>
                        <hediffDef>Celes_Hediff_MechAssist</hediffDef>
                        <severityPerDayInCloud>1000</severityPerDayInCloud>
                        <maxSeverity>1</maxSeverity>
                        <requireFriendly>true</requireFriendly>
                        <requireMechanoid>true</requireMechanoid>
                    </li>
                </hediffEntries>
            </li>
        </comps>
    </ThingDef>

    <ThingDef>
        <defName>Celes_NanoCloud_EM</defName>
        <label>电磁纳米云</label>
        <description>弥散的电磁型尘构云团，持续干扰范围内的护甲系统与伺服机构。</description>
        <thingClass>CelesFeature.Celes_NanoCloud</thingClass>
        <category>None</category>
        <tickerType>Normal</tickerType>
        <altitudeLayer>Gas</altitudeLayer>
        <drawerType>MapMeshAndRealTime</drawerType>
        <selectable>false</selectable>
