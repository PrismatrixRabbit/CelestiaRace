<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--==================================== GU8E「步槊」 ====================================-->

    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_StandardSniperRifle</defName>
        <label>GU8E「步槊」</label>
        <description>基于星铃技术的实验性微声狙击步枪，使用星铃制式8.5mm子弹，有较低的枪口火光与噪声。\n\n使用电点火ONC发射药提供初始速度，并以磁重接加速子弹。主要被不希望引人注意的星铃科考队员使用。</description>
        <graphicData>
            <texPath>Celes/Weapon/Standard/StandardSniperRifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.0</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_Rifle</soundInteract>
        <statBases>
            <WorkToMake>40000</WorkToMake>
            <Mass>3.6</Mass>
            <AccuracyTouch>0.65</AccuracyTouch>
            <AccuracyShort>0.80</AccuracyShort>
            <AccuracyMedium>0.90</AccuracyMedium>
            <AccuracyLong>0.80</AccuracyLong>
            <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
        </statBases>
        <equippedStatOffsets>
            <HuntingStealth>2.0</HuntingStealth>
        </equippedStatOffsets>
        <costList>
            <CelesAlloy>45</CelesAlloy>
            <Celes_NanoMachine>1</Celes_NanoMachine>
            <Celes_NanoComponent>1</Celes_NanoComponent>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <label>锻造指令：GU8E「步槊」</label>
            <researchPrerequisites>
                <li>Celes_Weapon_II</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
            <displayPriority>5520</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletStandardM</defaultProjectile>
                <warmupTime>2.0</warmupTime>
                <range>38.9</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>Shot_ChargeRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>6</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>

        <weaponClasses>
            <li>LongShots</li>
            <li>RangedHeavy</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_StandardRangeSniper</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_StandardRange</li>
        </tradeTags>
    </ThingDef>
    
    <ThingDef ParentName="BaseBullet">
        <defName>Celes_BulletStandardM</defName>
        <label>星铃制式8.5mm子弹</label>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>20</damageAmountBase>
            <armorPenetrationBase>0.3</armorPenetrationBase>
            <stoppingPower>1.5</stoppingPower>
            <speed>55</speed>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <!--==================================== 科考队切割枪 ====================================-->
    
    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_StandardCutter</defName>
        <label>科考队切割枪</label>
        <description>喷射定向等离子体束流的切割工具，对墙体与生物肢段有额外的破坏性能，并附带高热。\n\n泛用性相当高的切割工具，可以很便捷的切割板材或者墙体，但作用范围受限在等离子体的自约束极限之内。对生物的切割在其设计范畴之内。</description>
        <graphicData>
            <texPath>Celes/Weapon/Standard/StandardCutter</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>0.9</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_ChargeRifle</soundInteract>
        <statBases>
            <WorkToMake>18000</WorkToMake>
            <Mass>2.6</Mass>
            <AccuracyTouch>0.85</AccuracyTouch>
            <AccuracyShort>0.70</AccuracyShort>
            <AccuracyMedium>0.40</AccuracyMedium>
            <AccuracyLong>0.20</AccuracyLong>
            <RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <CelesAlloy>30</CelesAlloy>
            <Celes_NanoMachine>1</Celes_NanoMachine>
            <Celes_NanoComponent>1</Celes_NanoComponent>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <label>锻造指令：科考队切割枪</label>
            <researchPrerequisites>
                <li>Celes_Weapon_II</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>5521</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_StandardCutterBullet</defaultProjectile>
                <warmupTime>0.5</warmupTime>
                <range>14.9</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>Shot_ChargeRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>4</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>发射腔</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>

        <weaponClasses>
            <li>ShortShots</li>
            <li>RangedLight</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_StandardRangeClose</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_StandardRange</li>
        </tradeTags>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>Celes_StandardCutterBullet</defName>
        <label>切割等离子体</label>
        <projectile>
            <damageDef>Celes_StandardCutterDamage</damageDef>
            <damageAmountBase>28</damageAmountBase>
            <armorPenetrationBase>0.35</armorPenetrationBase>
            <stoppingPower>1.0</stoppingPower>
            <speed>60</speed>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/Charge_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <DamageDef ParentName="Bullet">
        <defName>Celes_StandardCutterDamage</defName>
        <workerClass>CelesFeature.Celes_DamageWorker_Cutting</workerClass>
        <label>等离子切割</label>
        <deathMessage>{0}被等离子流切开了。</deathMessage>
        <hediff>Cut</hediff>
        <hediffSkin>Cut</hediffSkin>
        <hediffSolid>Crack</hediffSolid>
        <impactSoundType>Slice</impactSoundType>
        <armorCategory>Sharp</armorCategory>
        <overkillPctToDestroyPart>0~0.1</overkillPctToDestroyPart>
        <buildingDamageFactor>3</buildingDamageFactor>
        <buildingDamageFactorPassable>1.5</buildingDamageFactorPassable>
        <buildingDamageFactorImpassable>3</buildingDamageFactorImpassable>
        <modExtensions>
            <li Class="CelesFeature.Celes_BodyPartTagDamageMultiplierExtension">
                <entries>
                    <li>
                        <tag>ManipulationLimbCore</tag>
                        <multiplier>1.5</multiplier>
                    </li>
                    <li>
                        <tag>ManipulationLimbSegment</tag>
                        <multiplier>1.5</multiplier>
                    </li>
                    <li>
                        <tag>ManipulationLimbDigit</tag>
                        <multiplier>1.5</multiplier>
                    </li>
                    <li>
                        <tag>MovingLimbCore</tag>
                        <multiplier>1.5</multiplier>
                    </li>
                    <li>
                        <tag>MovingLimbSegment</tag>
                        <multiplier>1.5</multiplier>
                    </li>
                    <li>
                        <tag>MovingLimbDigit</tag>
                        <multiplier>1.5</multiplier>
                    </li>
                </entries>
            </li>
            <li Class="CelesFeature.Celes_DamageExtension_ExtraDamages">
                <extraDamages>
                    <li>
                        <def>Burn</def>
                        <amount>4</amount>
                        <chance>1.0</chance>
                    </li>
                </extraDamages>
            </li>
        </modExtensions>
    </DamageDef>

    <!--==================================== GZ5E「戟」 ====================================-->
    
    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_StandardAutoRifle</defName>
        <label>GZ5E「戟」</label>
        <description>基于星铃技术的实验性自动突击步枪，使用星铃制式5.7mm子弹，具有可变弹速的两种射击模式。\n\n依赖可变磁场线圈和磁流变液系统的改进的全自动磁重接武器，复杂机械的制造和维护成本都能通过尘构大幅降低而在科考队内量产，基本可以覆盖科考队在边缘世界非军事力量的自我防卫需求。</description>
        <graphicData>
            <texPath>Celes/Weapon/Standard/StandardRifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.0</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_ChargeRifle</soundInteract>
        <statBases>
            <WorkToMake>45000</WorkToMake>
            <Mass>3.5</Mass>
            <AccuracyTouch>0.60</AccuracyTouch>
            <AccuracyShort>0.70</AccuracyShort>
            <AccuracyMedium>0.65</AccuracyMedium>
            <AccuracyLong>0.55</AccuracyLong>
            <RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <CelesAlloy>70</CelesAlloy>
            <Celes_Substrate>10</Celes_Substrate>
            <Celes_NanoComponent>2</Celes_NanoComponent>
        </costList>
        <recipeMaker>
            <label>锻造指令：GZ5E「戟」</label>
            <researchPrerequisites>
                <li>Celes_Weapon_III</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>7</Crafting>
            </skillRequirements>
            <displayPriority>5523</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletStandardS</defaultProjectile>
                <warmupTime>1.0</warmupTime>
                <range>33.9</range>
                <burstShotCount>3</burstShotCount>
                <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
                <soundCast>Shot_ChargeRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>7</muzzleFlashScale>
            </li>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletStandardS</defaultProjectile>
                <warmupTime>1.2</warmupTime>
                <range>29.9</range>
                <burstShotCount>10</burstShotCount>
                <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
                <soundCast>Shot_ChargeRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="CelesFeature.Celes_CompProperties_MultiVerb">
                <verbInfos>
                    <li>
                        <iconPath>UI/Abilities/FireSpew</iconPath>
                        <defaultLabel>三连发</defaultLabel>
                        <defaultDesc>战术性的三连发精确模式，更精确可靠。</defaultDesc>
                        <accuracyOffset>0</accuracyOffset>
                    </li>
                    <li>
                        <iconPath>UI/Abilities/FireBurst</iconPath>
                        <defaultLabel>全自动</defaultLabel>
                        <defaultDesc>全自动射击压制射击，损失精度来提供压制性火力。</defaultDesc>
                        <accuracyOffset>-0.42</accuracyOffset>
                    </li>
                </verbInfos>
            </li>
        </comps>

        <weaponClasses>
            <li>ShortShots</li>
            <li>RangedLight</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_StandardRangeAR</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_StandardRange</li>
        </tradeTags>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>Celes_BulletStandardS</defName>
        <label>星铃制式5.7mm子弹</label>
        <projectile>
            <damageDef>Bullet</damageDef>
