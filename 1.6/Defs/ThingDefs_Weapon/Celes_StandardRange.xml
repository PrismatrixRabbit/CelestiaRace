<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--==================================== 星铃拓荒型精确步枪 ====================================-->

    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_StandardSniperRifle</defName>
        <label>GU8E试制加速步枪</label>
        <description>基于星铃技术的实验性微声狙击步枪，使用星铃制式8.5mm子弹，有较低的枪口火光与噪声。\n\n使用电点火ONC发射药提供初始速度，并以磁重接加速子弹。主要被不希望引人注意的星铃科考队员使用。</description>
        <graphicData>
            <texPath>Celes/Weapon/Standard/StandardSniperRifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.0</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_Rifle</soundInteract>
        <statBases>
            <WorkToMake>15000</WorkToMake>
            <Mass>4.0</Mass>
            <AccuracyTouch>0.55</AccuracyTouch>
            <AccuracyShort>0.85</AccuracyShort>
            <AccuracyMedium>0.90</AccuracyMedium>
            <AccuracyLong>0.85</AccuracyLong>
            <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
        </statBases>
        <equippedStatOffsets>
            <HuntingStealth>2.0</HuntingStealth>
        </equippedStatOffsets>
        <costList>
            <Steel>60</Steel>
            <ComponentIndustrial>4</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <researchPrerequisites>
                <li>Celes_Weapon_I</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>5510</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletIndustryM</defaultProjectile>
                <warmupTime>1.5</warmupTime>
                <range>36.9</range>
                <soundCast>Shot_BoltActionRifle</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps Inherit="False">
            <li Class="CompProperties_Biocodable"/>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="CompProperties_EquippableAbility">
                <abilityDef>Celes_Ability_IndustryRifle</abilityDef>
            </li>
        </comps>

        <weaponClasses>
            <li>LongShots</li>
            <li>RangedHeavy</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_IndustryRangeSniper</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_IndustryRange</li>
        </tradeTags>
    </ThingDef>
</Defs>