    <ThingDef ParentName="Celes_EarlyMeleeBase">
        <defName>Celes_Hatchet</defName>
        <label>星铃拓荒手斧</label>
        <description>一把现代化设计的拓荒手斧，符合人体工学而轻便耐用。杀伤力并不出众，但胜在其上的结构可以很方便的用于收获作物和砍树。</description>
        <graphicData>
            <texPath>Celes/Weapon/Early/Celes_Hatchet</texPath>
            <graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
            <drawSize>1</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <costList>
            <Steel>45</Steel>
        </costList>
        <statBases>
            <WorkToMake>7000</WorkToMake>
            <Mass>0.85</Mass>
        </statBases>
        <equippedAngleOffset>-65</equippedAngleOffset>
        <equippedStatOffsets>
            <PlantWorkSpeed>0.4</PlantWorkSpeed>
        </equippedStatOffsets>
        <recipeMaker>
            <recipeUsers>
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
            </recipeUsers>
            <researchPrerequisites>
                <li>Celes_MainTech_I</li>
                <li>Smithing</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
        </recipeMaker>
        <weaponClasses>
            <li>Melee</li>
        </weaponClasses>
        <tools>
            <li>
                <label>斧柄</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>斧刃</label>
                <capacities>
                    <li>Cut</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.2</cooldownTime>
            </li>
        </tools>
    </ThingDef>
    
