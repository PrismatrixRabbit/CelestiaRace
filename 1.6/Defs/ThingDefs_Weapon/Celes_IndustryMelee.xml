<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="Celes_BaseMeleeWeapon">
        <defName>Celes_Hatchet</defName>
        <label>星铃拓荒型手斧</label>
        <description>科考队制式的割砍两用工具，正面是宽大的斧刃，背面带有短镰刃。其基于边缘世界本土资源条件设计，制造简单轻便耐用，可以用于收获作物、砍伐树木或清理杂草。也堪堪能作为武器。</description>
        <graphicData>
            <texPath>Celes/Weapon/Industry/Hatchet</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <costList>
            <Steel>35</Steel>
            <WoodLog>25</WoodLog>
        </costList>
        <statBases>
            <WorkToMake>8000</WorkToMake>
            <Mass>0.85</Mass>
        </statBases>
        <equippedAngleOffset>-65</equippedAngleOffset>
        <equippedStatOffsets>
            <PlantWorkSpeed>0.4</PlantWorkSpeed>
        </equippedStatOffsets>
        <recipeMaker>
            <recipeUsers>
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
                <li>Celes_LabNanoForge</li>
            </recipeUsers>
            <researchPrerequisites>
                <li>Celes_Weapon_I</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>3</Crafting>
            </skillRequirements>
            <displayPriority>5010</displayPriority>
        </recipeMaker>
        <tools>
            <li>
                <label>斧柄</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
                <armorPenetration>0.18</armorPenetration>
            </li>
            <li>
                <label>斧刃</label>
                <capacities>
                    <li>Cut</li>
                </capacities>
                <power>18</power>
                <cooldownTime>2.0</cooldownTime>
                <armorPenetration>0.30</armorPenetration>
            </li>
            <li>
                <label>镰刃</label>
                <capacities>
                    <li>Cut</li>
                </capacities>
                <power>13</power>
                <cooldownTime>1.4</cooldownTime>
                <armorPenetration>0.30</armorPenetration>
            </li>
        </tools>
        <weaponTags>
            <li>Celes_IndustryMelee</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_IndustryMelee</li>
        </tradeTags>
    </ThingDef>

