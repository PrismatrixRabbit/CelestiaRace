    <ThingDef ParentName="Celes_EarlyGunBase">
        <defName>Celes_Early_Rifle</defName>
        <label>星铃拓荒栓动步枪</label>
        <description>一把老式构型的栓动步枪，应急但确实有效，射程远而精准，但射速堪忧。使用星铃制式8.5mm子弹。\n\n如果不是某种紧急情况，这玩意应该在博物馆里躺着。</description>
        <graphicData>
            <texPath>Celes/Weapon/Early/Celes_BoltActionRifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
            <drawSize>1.1</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_Rifle</soundInteract>
        <statBases>
            <WorkToMake>45000</WorkToMake>
            <Mass>4.0</Mass>
            <AccuracyTouch>0.63</AccuracyTouch>
            <AccuracyShort>0.85</AccuracyShort>
            <AccuracyMedium>0.90</AccuracyMedium>
            <AccuracyLong>0.85</AccuracyLong>
            <RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
        </statBases>
        <weaponTags>
            <li>Celes_EarlyWeaponSniper</li>
        </weaponTags>
        <costList>
            <CelesAlloy>40</CelesAlloy>
            <WoodLog>20</WoodLog>
            <ComponentIndustrial>4</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <researchPrerequisites>
                <li>Celes_Weapon_I</li>
                <li>Gunsmithing</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>CelesBullet_EarlyRifle</defaultProjectile>
                <warmupTime>2.3</warmupTime>
                <range>39.9</range>
                <soundCast>Shot_BoltActionRifle</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>
    
