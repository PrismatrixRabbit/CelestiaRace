<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--==================================== 星铃拓荒型转轮手枪 ====================================-->

    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_IndustryRevolver</defName>
        <label>星铃拓荒型转轮手枪</label>
        <description>一种大口径的双动式转轮手枪，使用星铃特种13mm子弹。这种手枪采用了特殊的配重构型优化全枪后座，可靠耐用，通常用于贴身防卫。</description>
        <graphicData>
            <texPath>Celes/Weapon/Industry/IndustryRevolver</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>0.8</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_Revolver</soundInteract>
        <statBases>
            <WorkToMake>15000</WorkToMake>
            <Mass>3.0</Mass>
            <AccuracyTouch>0.80</AccuracyTouch>
            <AccuracyShort>0.73</AccuracyShort>
            <AccuracyMedium>0.57</AccuracyMedium>
            <AccuracyLong>0.40</AccuracyLong>
            <RangedWeapon_Cooldown>1.45</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>60</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <researchPrerequisites>
                <li>Celes_Weapon_I</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>5508</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletIndustryLSp</defaultProjectile>
                <warmupTime>0.5</warmupTime>
                <range>15.9</range>
                <soundCast>Shot_Revolver</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>

        <weaponClasses>
            <li>ShortShots</li>
            <li>RangedLight</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_IndustryRangeRevolver</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_IndustryRange</li>
        </tradeTags>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>Celes_BulletIndustryLSp</defName>
        <label>星铃特种13mm子弹</label>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>20</damageAmountBase>
            <!--<armorPenetrationBase>0.27</armorPenetrationBase>-->
            <stoppingPower>2.0</stoppingPower>
            <speed>55</speed>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Big</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <!--==================================== 星铃拓荒型精确步枪 ====================================-->
    
    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_IndustryRifle</defName>
        <label>星铃拓荒型精确步枪</label>
        <description>一种导气式半自动步枪，使用星铃旧式8.5mm子弹。这种步枪射程远而精准，制造简单耐用，维护方便，可以用于狩猎、驱离野兽或者站岗防身。\n\n也能通过切换快慢机来全自动射击，但这样通常来说压不住枪而且肩膀会酸得抬不起来。</description>
        <graphicData>
            <texPath>Celes/Weapon/Industry/IndustryRifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.0</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_Rifle</soundInteract>
        <statBases>
            <WorkToMake>15000</WorkToMake>
            <Mass>4.0</Mass>
            <AccuracyTouch>0.55</AccuracyTouch>
            <AccuracyShort>0.85</AccuracyShort>
            <AccuracyMedium>0.90</AccuracyMedium>
            <AccuracyLong>0.85</AccuracyLong>
            <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
        </statBases>
        <equippedStatOffsets>
            <HuntingStealth>2.0</HuntingStealth>
        </equippedStatOffsets>
        <costList>
            <Steel>60</Steel>
            <ComponentIndustrial>4</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <researchPrerequisites>
                <li>Celes_Weapon_I</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>5510</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletIndustryM</defaultProjectile>
                <warmupTime>1.5</warmupTime>
                <range>36.9</range>
                <soundCast>Shot_BoltActionRifle</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps Inherit="False">
            <li Class="CompProperties_Biocodable"/>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="CompProperties_EquippableAbility">
                <abilityDef>Celes_Ability_IndustryRifle</abilityDef>
            </li>
        </comps>
        
        <weaponClasses>
            <li>LongShots</li>
            <li>RangedHeavy</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_IndustryRangeSniper</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_IndustryRange</li>
        </tradeTags>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>Celes_BulletIndustryM</defName>
        <label>星铃旧式8.5mm子弹</label>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>18</damageAmountBase>
            <armorPenetrationBase>0.32</armorPenetrationBase>
            <stoppingPower>1.5</stoppingPower>
            <speed>75</speed>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Big</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>
    
    <AbilityDef>
        <defName>Celes_Ability_IndustryRifle</defName>
        <label>快慢机切换</label>
        <description>将保险切至全自动以爆发一串连射，但这样肩膀会很痛，得缓好一会。</description>
        <iconPath>Celes/UI/Icons/IndustrialChips_B</iconPath>
        <cooldownTicksRange>2500</cooldownTicksRange>
        <showPsycastEffects>false</showPsycastEffects>
        <verbProperties>
            <verbClass>Verb_AbilityShoot</verbClass>
            <defaultProjectile>Celes_BulletIndustryM</defaultProjectile>
            <range>21.9</range>
            <warmupTime>1.2</warmupTime>
            <burstShotCount>3</burstShotCount>
            <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
            <accuracyTouch>0.55</accuracyTouch>
            <accuracyShort>0.65</accuracyShort>
            <accuracyMedium>0.55</accuracyMedium>
            <accuracyLong>0.45</accuracyLong>
            <soundCast>Shot_BoltActionRifle</soundCast>
            <soundCastTail>GunTail_Heavy</soundCastTail>
            <muzzleFlashScale>9</muzzleFlashScale>
            <ai_IsWeapon>false</ai_IsWeapon>
            <targetParams>
                <canTargetLocations>false</canTargetLocations>
            </targetParams>
        </verbProperties>
    </AbilityDef>

    <!--==================================== 星铃拓荒型霰弹枪 ====================================-->

    <ThingDef ParentName="Celes_BaseHumanMakeableGun">
        <defName>Celes_IndustryShotgun</defName>
        <label>星铃拓荒型霰弹枪</label>
        <description>一种大口径泵动式霰弹枪，使用星铃特种25mm子弹。在极近距离上发射威力惊人的霰弹，可以用于破门、清障或近距离防身。由于其使用了带有膛线的枪管所以理论上算是卡宾枪……？\n\n也能装填特制的闪光弹，致盲射程内的所有人。</description>
        <graphicData>
            <texPath>Celes/Weapon/Industry/IndustryShotgun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.0</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <soundInteract>Interact_Shotgun</soundInteract>
        <statBases>
            <WorkToMake>19500</WorkToMake>
            <Mass>3.5</Mass>
            <AccuracyTouch>0.55</AccuracyTouch>
            <AccuracyShort>0.65</AccuracyShort>
            <AccuracyMedium>0.55</AccuracyMedium>
            <AccuracyLong>0.45</AccuracyLong>
            <RangedWeapon_Cooldown>0.9</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>85</Steel>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <researchPrerequisites>
                <li>Celes_Weapon_I</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>5512</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Celes_BulletIndustryShotgun</defaultProjectile>
                <warmupTime>1.2</warmupTime>
                <range>14.9</range>
                <soundCast>Shot_Shotgun</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>3</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps Inherit="False">
            <li Class="CompProperties_Biocodable"/>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="CompProperties_EquippableAbilityReloadable">
                <abilityDef>Celes_Ability_IndustryShotgun</abilityDef>
                <maxCharges>3</maxCharges>
                <ammoDef>Steel</ammoDef>
                <ammoCountPerCharge>15</ammoCountPerCharge>
                <baseReloadTicks>60</baseReloadTicks>
                <soundReload>Standard_Reload</soundReload>
                <chargeNoun>闪光弹</chargeNoun>
            </li>
        </comps>

        <weaponClasses>
            <li>ShortShots</li>
            <li>RangedHeavy</li>
        </weaponClasses>
        <weaponTags>
            <li>Celes_IndustryRangeClose</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_IndustryRange</li>
        </tradeTags>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>Celes_BulletIndustryShotgun</defName>
        <label>星铃特种25mm子弹</label>
        <projectile>
            <damageDef>Celes_ShotgunBullet</damageDef>
            <damageAmountBase>32</damageAmountBase>
            <armorPenetrationBase>0.16</armorPenetrationBase>
            <stoppingPower>3.0</stoppingPower>
            <speed>55</speed>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Shotgun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <AbilityDef>
        <defName>Celes_Ability_IndustryShotgun</defName>
        <label>25mm闪光弹</label>
        <description>装填特种闪光弹丸以致盲射程内的敌人。</description>
        <iconPath>Celes/UI/Icons/IndustrialChips_B</iconPath>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>14.9</range>
            <warmupTime>1.4</warmupTime>
            <soundCast>BulletImpact_Metal</soundCast>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="CelesFeature.Celes_CompProperties_AbilityConeApplyHediff">
                <hediffDef>Celes_Hediff_ShotgunBlind</hediffDef>
                <bodypartTagTarget>SightSource</bodypartTagTarget>
                <severityFixed>1</severityFixed>
                <chance>1</chance>
                <range>14.9</range>
                <coneSizeDegrees>25</coneSizeDegrees>
                <flashFleckDef>Celes_Fleck_Flash</flashFleckDef>
                <flashScale>120</flashScale>
                <stunDamage>4</stunDamage>
            </li>
        </comps>
    </AbilityDef>

    <HediffDef>
        <defName>Celes_Hediff_ShotgunBlind</defName>
        <label>强光致盲</label>
        <description>被强光压制视觉，短时内视力大幅下降。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <stages>
            <li>
                <partEfficiencyOffset>-0.9</partEfficiencyOffset>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600</disappearsAfterTicks>
            </li>
        </comps>
    </HediffDef>
    
    <FleckDef ParentName="FleckBase">
        <defName>Celes_Fleck_Flash</defName>
        <altitudeLayer>MoteOverhead</altitudeLayer>
        <fadeInTime>0.05</fadeInTime>
        <solidTime>0</solidTime>
        <fadeOutTime>0.05</fadeOutTime>
        <graphicData>
            <texPath>Things/Mote/ShotFlash</texPath>
            <shaderType>MoteGlow</shaderType>
            <color>(1, 0.97, 0.9)</color>
        </graphicData>
    </FleckDef>

