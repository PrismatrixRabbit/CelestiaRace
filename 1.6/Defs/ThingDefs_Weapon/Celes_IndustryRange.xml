        <weaponTags>
            <li>Celes_IndustryRangeClose</li>
        </weaponTags>
        <tradeTags>
            <li>Celes_IndustryRange</li>
        </tradeTags>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>Celes_BulletIndustryS</defName>
        <label>星铃旧式5.7mm子弹</label>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>12</damageAmountBase>
