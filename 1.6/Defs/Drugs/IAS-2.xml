<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="Celes_MakeableDrugBase">
        <defName>Celes_IAS2M</defName>
        <label>IAS-2免疫增强剂</label>
        <description>一种改良的合成药物，全面提升了使用者的免疫机能，并在血液中维持特殊药物。阻断疟疾，昏睡病，瘟疫等疾病的传染，抑制伤口感染，并对各类寄生虫的幼虫及虫卵具有毒害作用。\n\n注意：这种药物如同佩诺西林一样，无法治疗已经患上的疾病，只能用于预防。</description>
        <possessionCount>10</possessionCount>
        <descriptionHyperlinks><HediffDef>Celes_IASHigh</HediffDef></descriptionHyperlinks>
        <graphicData>
            <texPath>Celes/Drugs/IAS2</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <socialPropernessMatters>false</socialPropernessMatters>
        <rotatable>false</rotatable>
        <statBases>
            <WorkToMake>600</WorkToMake>
            <MarketValue>30</MarketValue>
            <Mass>0.005</Mass>
            <Flammability>0.7</Flammability>
        </statBases>
        <techLevel>Industrial</techLevel>
        <ingestible>
            <foodType>Processed</foodType>
            <baseIngestTicks>650</baseIngestTicks>
            <nurseable>true</nurseable>
            <drugCategory>Medical</drugCategory>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>Celes_IASHigh</hediffDef>
                    <severity>1.0</severity>
                </li>
            </outcomeDoers>
        </ingestible>
        <recipeMaker>
            <label>编织指令：IAS-2</label>
            <researchPrerequisite>Celes_Bio_I</researchPrerequisite>
            <displayPriority>1525</displayPriority>
        </recipeMaker>
        <costList>
            <Celes_NanoMachine>1</Celes_NanoMachine>
            <Celes_BioGel>4</Celes_BioGel>
        </costList>
        <comps>
            <li Class="CompProperties_Drug">
                <listOrder>1000</listOrder>
                <overdoseSeverityOffset>0.08~0.14</overdoseSeverityOffset>
            </li>
        </comps>
    </ThingDef>

    <HediffDef>
        <defName>Celes_IASHigh</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>IAS-2免疫增强剂</label>
        <description>流淌在血液中的IAS-2化学物质正在预防疾病的发生，但这无法阻止已经发生的疾病。</description>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.18</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <CancerRate  MayRequire="Ludeon.RimWorld.Biotech">0.1</CancerRate>
                </statFactors>
                <makeImmuneTo>
                    <li>Malaria</li>
                    <li>SleepingSickness</li>
                    <li>Plague</li>
                    <li>MuscleParasites</li>
                    <li>GutWorms</li>
                    <li>WoundInfection</li>
                    <li>Flu</li>
                </makeImmuneTo>
            </li>
        </stages>
    </HediffDef>

</Defs>