<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- TODO 副作用改射击能力削弱和饥饿-->
    <ThingDef ParentName="Celes_MakeableDrugBase">
        <defName>Celes_CS12M</defName>
        <label>CS-12作战止血剂</label>
        <description>一种合成化学制剂，用于短暂抑制使用者的痛觉神经，激活机体愈合机制，并通过多途径抑制出血。注意，CS-12通过过载细胞活性实现机体增强，其后效有一定致命性。\n\n过量使用CS-12的风险巨大，以至于星铃科考队使用的合成配方从根本上难以合成高浓度的CS-12。但即使如此，连续注射CS-12仍然具有不低的风险。</description>
        <descriptionHyperlinks>
            <HediffDef>Celes_CS12_HighSample</HediffDef>
            <HediffDef>Celes_CS12_After</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Celes/Drugs/CS12</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <rotatable>false</rotatable>
        <statBases>
            <WorkToMake>320</WorkToMake>
            <MarketValue>40</MarketValue>
            <Mass>0.05</Mass>
        </statBases>
        <techLevel>Industrial</techLevel>
        <ingestible>
            <ingestSound>Ingest_Inject</ingestSound>
            <foodType>Processed</foodType>
            <baseIngestTicks>650</baseIngestTicks>
            <nurseable>true</nurseable>
            <drugCategory>Medical</drugCategory>
            <ingestHoldOffsetStanding>
                <northDefault>
                    <offset>(0.18,0,0)</offset>
                </northDefault>
            </ingestHoldOffsetStanding>
            <ingestCommandString>注射{0}</ingestCommandString>
            <ingestReportString>正在注射{0}</ingestReportString>
            <useEatingSpeedStat>false</useEatingSpeedStat>
            <chairSearchRadius>0</chairSearchRadius>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>Celes_CS12_High</hediffDef>
                    <severity>0.33</severity>
                </li>
            </outcomeDoers>
        </ingestible>
        <recipeMaker>
            <label>编织指令：CS-12</label>
            <researchPrerequisite>Celes_Bio_II</researchPrerequisite>
            <displayPriority>1540</displayPriority>
        </recipeMaker>
        <costList>
            <Neutroamine>1</Neutroamine>
            <Celes_BioGel>1</Celes_BioGel>
            <MedicineHerbal>1</MedicineHerbal>
        </costList>
        <comps>
            <li Class="CompProperties_Drug">
                <isCombatEnhancingDrug>false</isCombatEnhancingDrug>
                <overdoseSeverityOffset>0.18~0.35</overdoseSeverityOffset>
            </li>
        </comps>
    </ThingDef>

    <HediffDef>
        <defName>Celes_CS12_HighSample</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>CS-12作战止血剂</label>
        <labelNoun>CS-12效果</labelNoun>
        <description>流淌在血液中的CS-12化学物质正在提高使用者的止血愈合能力。</description>
        <defaultLabelColor>(1, 1, 1)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <maxSeverity>0.002</maxSeverity>
        <isBad>false</isBad>
        <stages>
            <li>
                <painFactor>0.5</painFactor>
                <totalBleedFactor>0.3</totalBleedFactor>
                <statFactors>
                    <InjuryHealingFactor>4.0</InjuryHealingFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>Celes_CS12_High</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>CS-12作战止血剂</label>
        <labelNoun>CS-12效果</labelNoun>
        <description>流淌在血液中的CS-12化学物质正在提高使用者的止血愈合能力。</description>
        <defaultLabelColor>(1 ,1 ,1)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-4</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="CelesFeature.Celes_HediffCompProperties_Jumper">
                <targetHediff>Celes_CS12_After</targetHediff>
                <minToJump>true</minToJump>
            </li>
        </comps>
        <stages>
            <li>
                <painFactor>0.5</painFactor>
                <totalBleedFactor>0.3</totalBleedFactor>
                <statFactors>
                    <InjuryHealingFactor>4.0</InjuryHealingFactor>
                </statFactors>
            </li>
            <li>
                <minSeverity>0.501</minSeverity>
                <label>过量</label>
                <painFactor>0.2</painFactor>
                <totalBleedFactor>0</totalBleedFactor>
                <statFactors>
                    <InjuryHealingFactor>8.0</InjuryHealingFactor>
                </statFactors>
                <hediffGivers>
                    <li Class="HediffGiver_Random">
                        <hediff>HeartAttack</hediff>
                        <mtbDays>0.128</mtbDays>
                        <partsToAffect>
                            <li>Heart</li>
                        </partsToAffect>
                    </li>
                </hediffGivers>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>Celes_CS12_After</defName>
        <label>CS-12后效应</label>
        <labelNoun>CS-12后效应</labelNoun>
        <description>机体正在由CS-12导致的细胞活性过载中恢复，缺乏合适的治疗可能导致死亡。</description>
        <defaultLabelColor>(0.8, 0.8, 0.35)</defaultLabelColor>
        <hediffClass>Hediff_High</hediffClass>
        <makesSickThought>true</makesSickThought>
        <lethalSeverity>1</lethalSeverity>
        <tendable>true</tendable>
        <isBad>true</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>1</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <!--<li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>30000~60000</disappearsAfterTicks>
            </li>-->
            <li Class="HediffCompProperties_TendDuration">
                <baseTendDurationHours>24</baseTendDurationHours>
                <severityPerDayTended>-0.4</severityPerDayTended>
            </li>
        </comps>
        <stages>
            <li>
                <vomitMtbDays>0.2</vomitMtbDays>
                <restFallFactor>2.5</restFallFactor>
                <hungerRateFactorOffset>1.5</hungerRateFactorOffset>
                <capMods>
                    <li>
                        <capacity>Sight</capacity>
                        <setMax>0.8</setMax>
                    </li>
                    <li>
                        <capacity>Breathing</capacity>
                        <offset>-0.1</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.80</minSeverity>
                <label>致命</label>
                <lifeThreatening>true</lifeThreatening>
                <vomitMtbDays>0.2</vomitMtbDays>
                <restFallFactor>2.5</restFallFactor>
                <hungerRateFactorOffset>1.5</hungerRateFactorOffset>
                <capMods>
                    <li>
                        <capacity>Sight</capacity>
                        <setMax>0.8</setMax>
                    </li>
                    <li>
                        <capacity>Breathing</capacity>
                        <offset>-0.1</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>