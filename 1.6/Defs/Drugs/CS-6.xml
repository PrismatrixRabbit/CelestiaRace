<?xml version="1.0" encoding="utf-8"?>
<Defs>
    
    <ThingDef ParentName="Celes_MakeableDrugBase">
        <defName>Celes_CS6M</defName>
        <label>CS-6作战增强剂</label>
        <description>一种合成化学制剂，用于全面提高使用者的战斗能力，并短暂抑制使用者的睡眠需求。注意，CS-6通过过载细胞活性实现机体增强，其后效有一定致命性。\n\n这种复合制剂在活跃神经系统之外，对全身各系统都有一定程度的强化和过载，这种透支身体的药物长期使用会大幅降低预期寿命。毫无疑问，过量使用这种药物是相当危险的。</description>
        <descriptionHyperlinks>
            <HediffDef>Celes_CS6_HighSample</HediffDef>
            <HediffDef>Celes_CS6_After</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Celes/Drugs/CS6</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <rotatable>false</rotatable>
        <statBases>
            <WorkToMake>400</WorkToMake>
            <MarketValue>60</MarketValue>
            <Mass>0.05</Mass>
        </statBases>
        <techLevel>Industrial</techLevel>
        <ingestible>
            <foodType>Processed, Fluid</foodType>
            <baseIngestTicks>30</baseIngestTicks>
            <nurseable>true</nurseable>
            <drugCategory>Medical</drugCategory>
            <ingestSound>Ingest_Inject</ingestSound>
            <ingestHoldOffsetStanding>
                <northDefault>
                    <offset>(0.18,0,0)</offset>
                </northDefault>
            </ingestHoldOffsetStanding>
            <ingestCommandString>注射{0}</ingestCommandString>
            <ingestReportString>正在注射{0}</ingestReportString>
            <useEatingSpeedStat>false</useEatingSpeedStat>
            <chairSearchRadius>0</chairSearchRadius>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>Celes_CS6_High</hediffDef>
                    <severity>0.33</severity>
                </li>
                <li Class="IngestionOutcomeDoer_OffsetPsyfocus">
                    <offset>0.15</offset>
                </li>
            </outcomeDoers>
        </ingestible>
        <recipeMaker>
            <label>编织指令：CS-6</label>
            <researchPrerequisite>Celes_Bio_II</researchPrerequisite>
            <displayPriority>1535</displayPriority>
        </recipeMaker>
        <costList>
            <Neutroamine>2</Neutroamine>
            <Celes_BioGel>4</Celes_BioGel>
            <PsychoidLeaves>8</PsychoidLeaves>
            <Celes_NanoMachine>1</Celes_NanoMachine>
        </costList>
        <comps>
            <li Class="CompProperties_Drug">
                <isCombatEnhancingDrug>false</isCombatEnhancingDrug>
                <overdoseSeverityOffset>0.18~0.35</overdoseSeverityOffset>
            </li>
        </comps>
    </ThingDef>

    <HediffDef>
        <defName>Celes_CS6_HighSample</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>CS-6作战增强剂</label>
        <labelNoun>CS-6效果</labelNoun>
        <description>流淌在血液中的CS-6化学物质正在提高使用者的作战能力。</description>
        <defaultLabelColor>(1, 1, 1)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <maxSeverity>0.002</maxSeverity>
        <isBad>false</isBad>
        <stages>
            <li>
                <painFactor>0.2</painFactor>
                <restFallFactor>0.5</restFallFactor>
                <statOffsets>
                    <WorkSpeedGlobal>-0.10</WorkSpeedGlobal>
                    <ShootingAccuracyPawn>5.0</ShootingAccuracyPawn>
                    <MeleeHitChance>2.5</MeleeHitChance>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.35</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.5</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>Celes_CS6_High</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>CS-6作战增强剂</label>
        <labelNoun>CS-6效果</labelNoun>
        <description>流淌在血液中的CS-6化学物质正在提高使用者的作战能力。</description>
        <defaultLabelColor>(1, 1, 1)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-1.5</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="CelesFeature.Celes_HediffCompProperties_Jumper">
                <targetHediff>Celes_CS6_After</targetHediff>
                <minToJump>true</minToJump>
            </li>
        </comps>
        <stages>
            <li>
                <painFactor>0.2</painFactor>
                <restFallFactor>0.5</restFallFactor>
                <statOffsets>
                    <WorkSpeedGlobal>-0.10</WorkSpeedGlobal>
                    <ShootingAccuracyPawn>5.0</ShootingAccuracyPawn>
                    <MeleeHitChance>2.5</MeleeHitChance>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.35</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.5</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.51</minSeverity>
                <label>过量</label>
                <painFactor>0.1</painFactor>
                <restFallFactor>0.1</restFallFactor>
                <statOffsets>
                    <WorkSpeedGlobal>-0.20</WorkSpeedGlobal>
                    <ShootingAccuracyPawn>8.0</ShootingAccuracyPawn>
                    <MeleeHitChance>5.0</MeleeHitChance>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.3</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.5</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.8</offset>
                    </li>
                </capMods>
                <hediffGivers>
                    <li Class="HediffGiver_Random">
                        <hediff>HeartAttack</hediff>
                        <mtbDays>0.33</mtbDays>
                        <partsToAffect>
                            <li>Heart</li>
                        </partsToAffect>
                    </li>
                </hediffGivers>
            </li>
        </stages>
    </HediffDef>
    
    <HediffDef>
        <defName>Celes_CS6_After</defName>
        <label>CS-6后效应</label>
        <labelNoun>CS-6后效应</labelNoun>
        <description>机体正在由CS-6导致的细胞活性过载中恢复，缺乏合适的治疗可能导致死亡。</description>
        <hediffClass>Hediff_High</hediffClass>
        <defaultLabelColor>(0.8, 0.8, 0.35)</defaultLabelColor>
        <makesSickThought>true</makesSickThought>
        <lethalSeverity>1</lethalSeverity>
        <tendable>true</tendable>
        <isBad>true</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>0.5</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <!--<li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>30000~60000</disappearsAfterTicks>
            </li>-->
            <li Class="HediffCompProperties_TendDuration">
                <baseTendDurationHours>24</baseTendDurationHours>
                <severityPerDayTended>-1.5</severityPerDayTended>
            </li>
        </comps>
        <stages>
            <li>
                <vomitMtbDays>0.2</vomitMtbDays>
                <restFallFactor>2.5</restFallFactor>
                <hungerRateFactorOffset>1</hungerRateFactorOffset>
                <socialFightChanceFactor>3.0</socialFightChanceFactor>
                <capMods>
                    <li>
                        <capacity>Breathing</capacity>
                        <offset>-0.1</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.2</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.80</minSeverity>
                <label>致命</label>
                <lifeThreatening>true</lifeThreatening>
                <vomitMtbDays>0.2</vomitMtbDays>
                <restFallFactor>2.5</restFallFactor>
                <hungerRateFactorOffset>1</hungerRateFactorOffset>
                <socialFightChanceFactor>3.0</socialFightChanceFactor>
                <capMods>
                    <li>
                        <capacity>Breathing</capacity>
                        <offset>-0.1</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.2</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>