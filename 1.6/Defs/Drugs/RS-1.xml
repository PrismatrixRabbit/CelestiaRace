<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="Celes_MakeableDrugBase">
        <defName>Celes_RS1M</defName>
        <label>RS-1试验性强化剂</label>
        <description>一种合成尘构制剂，大幅全面强化使用者的身体机能，使其成为强大无匹的战争机器。但注意，摄入RS-1的同时伴随着高概率的昏迷与心脏病副作用。\n\n这种药物本质上是被调整了指令的路西法合剂，通过利用尘构对路西法合剂的指令进行覆写和过载，RS-1的研发者成功解决了这种纳米机械混合物在协调能力上的缺陷和难以排出身体的问题，但随之而来的是尘构和路西法合剂的交叉影响导致的高度不稳定。</description>
        <descriptionHyperlinks>
            <HediffDef>Celes_RS1_High</HediffDef>
            <HediffDef>Celes_RS1Stun</HediffDef>
            <HediffDef>HeartAttack</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Celes/Drugs/RS1</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <rotatable>false</rotatable>
        <statBases>
            <WorkToMake>1600</WorkToMake>
            <MarketValue>120</MarketValue>
            <Mass>0.05</Mass>
        </statBases>
        <techLevel>Industrial</techLevel>
        <ingestible>
            <foodType>Processed, Fluid</foodType>
            <nurseable>true</nurseable>
            <drugCategory>Medical</drugCategory>
            <baseIngestTicks>40</baseIngestTicks>
            <ingestSound>Ingest_Inject</ingestSound>
            <ingestHoldOffsetStanding>
                <northDefault>
                    <offset>(0.18,0,0)</offset>
                </northDefault>
            </ingestHoldOffsetStanding>
            <ingestCommandString>注射{0}</ingestCommandString>
            <ingestReportString>正在注射{0}</ingestReportString>
            <useEatingSpeedStat>false</useEatingSpeedStat>
            <chairSearchRadius>0</chairSearchRadius>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>Celes_RS1_High</hediffDef>
                    <severity>0.5</severity>
                </li>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <chance>0.33</chance>
                    <hediffDef>Celes_RS1Stun</hediffDef>
                </li>
                <li Class="IngestionOutcomeDoer_OffsetNeed">
                    <need>Rest</need>
                    <offset>1.0</offset>
                </li>
                <li Class="IngestionOutcomeDoer_OffsetNeed">
                    <need>Food</need>
                    <offset>1.0</offset>
                </li>
            </outcomeDoers>
        </ingestible>
        <recipeMaker>
            <label>编织指令：RS-1</label>
            <researchPrerequisite>Celes_Bio_IV</researchPrerequisite>
            <displayPriority>1550</displayPriority>
        </recipeMaker>
        <costList>
            <Celes_BioGel>10</Celes_BioGel>
            <Neutroamine>5</Neutroamine>
            <Luciferium>3</Luciferium>
            <Celes_NanoMachine>5</Celes_NanoMachine>
        </costList>
        <comps>
            <li Class="CompProperties_Drug">
                <isCombatEnhancingDrug>false</isCombatEnhancingDrug>
                <overdoseSeverityOffset>0.08~0.45</overdoseSeverityOffset>
            </li>
        </comps>
        <tradeTags Inherit="false">
            <li>Celes_DrugsDanger</li>
        </tradeTags>
    </ThingDef>
    
    <HediffDef>
        <defName>Celes_RS1_High</defName>
        <label>RS-1试验性强化剂</label>
        <description>体内被重编程的路西法合剂正在全面改善宿主的身体机能，并将在一段时间后被尘构分解无效化。</description>
        <hediffClass>Hediff_High</hediffClass>
        <maxSeverity>1</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-1</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="CelesFeature.Celes_HediffCompProperties_Jumper">
                <targetHediff>HeartAttack</targetHediff>
                <chanceToJump>0.6</chanceToJump>
                <minToJump>true</minToJump>
            </li>
        </comps>
        <stages>
            <li>
                <painFactor>0.5</painFactor>
                <totalBleedFactor>0.5</totalBleedFactor>
                <socialFightChanceFactor>5.0</socialFightChanceFactor>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>0.25</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.25</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.45</offset>
                    </li>
                    <li>
                        <capacity>BloodPumping</capacity>
                        <offset>0.25</offset>
                    </li>
                    <li>
                        <capacity>Breathing</capacity>
                        <offset>0.25</offset>
                    </li>
                </capMods>
                <statOffsets>
                    <WorkSpeedGlobal>-0.50</WorkSpeedGlobal>
                    <ShootingAccuracyPawn>10.0</ShootingAccuracyPawn>
                    <MeleeHitChance>10.0</MeleeHitChance>
                </statOffsets>
                <statFactors>
                    <AimingDelayFactor>0.66</AimingDelayFactor>
                    <MeleeDPS>2.0</MeleeDPS>
                </statFactors>
            </li>
        </stages>
    </HediffDef>
    
    <HediffDef ParentName="DiseaseBase">
        <defName>Celes_RS1Stun</defName>
        <label>应激性休克</label>
        <description>不稳定的路西法合剂导致使用者的身体进入了无害的保护性休克状态，这会花费至少一天来恢复。</description>
        <descriptionHyperlinks>
            <ThingDef>Celes_RS1M</ThingDef>
            <HediffDef>Celes_RS1_High</HediffDef>
        </descriptionHyperlinks>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000~150000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <vomitMtbDays>0.3</vomitMtbDays>
                <painFactor>0.8</painFactor>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.15</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
    
</Defs>