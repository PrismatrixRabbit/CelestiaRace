<?xml version="1.0" encoding="utf-8"?>
<Defs>
    
    <ThingDef ParentName="Celes_MakeableDrugBase">
        <defName>Celes_CPS1M</defName>
        <label>CPS-1作战灵能强化剂</label>
        <description>一种合成尘构制剂，用于提高使用者的灵能作战能力并直接增加精神力。CPS-1继承了星铃作战药物一贯的细胞活性过载，其后效有一定致命性。\n\n通过过度活跃神经，使用者会更容易感到疼痛，但也能更快的耗散心灵熵并凝聚精神力。作为某种＂副作用＂，使用者也会在战斗中更加专注……但过度专注和敏感的神经反而拖慢了日常工作的速度。</description>
        <descriptionHyperlinks>
            <HediffDef>Celes_CPS1_HighSample</HediffDef>
            <HediffDef>Celes_CPS1_After</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Celes/Drugs/CPS1</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <rotatable>false</rotatable>
        <statBases>
            <WorkToMake>900</WorkToMake>
            <MarketValue>160</MarketValue>
            <Mass>0.05</Mass>
        </statBases>
        <techLevel>Industrial</techLevel>
        <ingestible>
            <foodType>Processed, Fluid</foodType>
            <joyKind>Chemical</joyKind>
            <joy>0.30</joy>
            <baseIngestTicks>40</baseIngestTicks>
            <nurseable>true</nurseable>
            <drugCategory>Medical</drugCategory>
            <ingestSound>Ingest_Inject</ingestSound>
            <ingestHoldOffsetStanding>
                <northDefault>
                    <offset>(0.18, 0, 0)</offset>
                </northDefault>
            </ingestHoldOffsetStanding>
            <ingestCommandString>注射{0}</ingestCommandString>
            <ingestReportString>正在注射{0}</ingestReportString>
            <useEatingSpeedStat>false</useEatingSpeedStat>
            <chairSearchRadius>0</chairSearchRadius>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>Celes_CPS1_High</hediffDef>
                    <severity>0.33</severity>
                </li>
                <li Class="IngestionOutcomeDoer_OffsetPsyfocus">
                    <offset>0.8</offset>
                </li>
            </outcomeDoers>
        </ingestible>
        <recipeMaker>
            <label>编织指令：CPS-1</label>
            <researchPrerequisite>Celes_Bio_III</researchPrerequisite>
            <displayPriority>1545</displayPriority>
        </recipeMaker>
        <costList>
            <Neutroamine>2</Neutroamine>
            <Celes_BioGel>2</Celes_BioGel>
            <Celes_NanoMachine>2</Celes_NanoMachine>
            <PsychoidLeaves>8</PsychoidLeaves>
        </costList>
        <comps>
            <li Class="CompProperties_Drug">
                <isCombatEnhancingDrug>false</isCombatEnhancingDrug>
                <overdoseSeverityOffset>0.18~0.35</overdoseSeverityOffset>
            </li>
        </comps>
        <tradeTags Inherit="false">
            <li>Celes_DrugsDanger</li>
        </tradeTags>
    </ThingDef>

    <HediffDef>
        <defName>Celes_CPS1_HighSample</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>CPS-1作战灵能强化剂</label>
        <labelNoun>CPS-1效果</labelNoun>
        <description>流淌在血液中的CPS-1尘构物质正在提高使用者的灵能作战能力。</description>
        <defaultLabelColor>(1, 1, 1)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <maxSeverity>0.002</maxSeverity>
        <isBad>false</isBad>
        <stages>
            <li>
                <painFactor>1.3</painFactor>
                <restFallFactor>0.5</restFallFactor>
                <statOffsets>
                    <WorkSpeedGlobal>-0.10</WorkSpeedGlobal>
                    <ShootingAccuracyPawn>5.0</ShootingAccuracyPawn>
                    <MeleeHitChance>2.5</MeleeHitChance>
                </statOffsets>
                <statFactors>
                    <PsychicEntropyGain MayRequire="Ludeon.RimWorld.Royalty">0.8</PsychicEntropyGain>
                    <PsychicEntropyMax MayRequire="Ludeon.RimWorld.Royalty">1.5</PsychicEntropyMax>
                    <MeditationFocusGain MayRequire="Ludeon.RimWorld.Royalty">2</MeditationFocusGain>
                    <PsychicSensitivity>1.30</PsychicSensitivity>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

