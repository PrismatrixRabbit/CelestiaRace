<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- 发信器窗口正上子页内容 Def：欢迎页要闻 / 交易页 description（M0 测试） / 物流页状态模板。
         文案暂直接中文（D2 裁决，defInjected 留待 English 批次） -->
    <CelesFeature.CelesFD_SubPageDef>
        <defName>CelesFD_SubPageWelcome</defName>
        <subPageType>WelcomeNews</subPageType>
        <newsPool>
            <li>星铃外勤部开放了新的市场通道，欢迎关注交易页。</li>
            <li>信用额结算汇率保持稳定。</li>
            <li>近期运输航线拥堵，加急订单建议提前预约。</li>
            <li>外勤部提醒各殖民地定期维护信标站设备。</li>
            <li>新的物资需求清单已送达交易频道。</li>
        </newsPool>
    </CelesFeature.CelesFD_SubPageDef>

    <CelesFeature.CelesFD_SubPageDef>
        <defName>CelesFD_SubPageTrade</defName>
        <subPageType>TradeDescription</subPageType>
        <tradeDescription>这是 M0 阶段的订单描述测试文本。正式订单描述将在 M5b 接入订单数据，插值渲染随 M5d。</tradeDescription>
    </CelesFeature.CelesFD_SubPageDef>

    <CelesFeature.CelesFD_SubPageDef>
        <defName>CelesFD_SubPageLogistics</defName>
        <subPageType>LogisticsStatus</subPageType>
        <logisticsTemplate>当前对接信标站：{station}\n\n信标站详情：{position}\n运行状态：{status}</logisticsTemplate>
    </CelesFeature.CelesFD_SubPageDef>
</Defs>
