<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- M1 数据层测试基架（v4.5：形态轴/内容合规无校验，纯 XML 填写自由；测试重点 = ThingFilter 解析/匹配 + 计价/等级数据完整性校验）。
         FD-G29（2026-09-02）：T7 计价互斥坏用例已随 v2 重构移除（原注释残留）；全部 Def 加载应无红字（保底 isLockable 组合预期 Log.Warning） -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_OpenBulkBuy</defName>
        <title>测试：开放批发收购</title>
        <category>Open</category>
        <form>Bulk</form>
        <isBuy>true</isBuy>
        <fameReward>10</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <thingAmount>500~2000</thingAmount>
                <thingPriceCredit>1</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- T2'（v2 2026-08-15）：类别模式演示——Weapons 类别任意武器收购（filter 单 categories；label=类别名；icon=类别内 defName 字母序首物；交付任意武器混合累计） -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_WeaponCategoryBuy</defName>
        <title>测试：武器类别收购</title>
        <category>Internal</category>
        <form>Scattered</form>
        <isBuy>true</isBuy>
        <fameReward>15</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <categories>
                        <li>Weapons</li>
                    </categories>
                </filter>
                <thingAmount>1~3</thingAmount>
                <thingPriceCredit>20</thingPriceCredit>
                <thingExtraFameFactor>2</thingExtraFameFactor>
                <label>任意武器</label>
                <description>星铃外勤部急需一批武器（{thingLabel}，任意种类均可，共 {amount} 件）。交付的武器将按合同统一计价，谢绝破损货品。</description>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- T3'（v2 2026-08-15；批 2.5 修复 2026-09-24）：布料材质出售——物品源 categories=Apparel（候选=全部衣物）；
         stuffCategoriesToAllow=Fabric 迁至 entry 层（原在 filter 内会污染 allowedDefs——ResolveReferences :421 把 Fabric 材质 def 塞进候选集）；
         StuffCategoryDef 名称为 Fabric（v4.6 实证修正——'Cloth' 仅为 ThingDef 布料物品，非材质类别） -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_ClothStuff</defName>
        <title>测试：布料材质出售</title>
        <category>Open</category>
        <form>Scattered</form>
        <isBuy>false</isBuy>
        <fameReward>5</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <categories>
                        <li>Apparel</li>
                    </categories>
                </filter>
                <stuffCategoriesToAllow>
                    <li>Fabric</li>
                </stuffCategoriesToAllow>
                <thingAmount>1~50</thingAmount>
                <thingPriceCredit>2</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_FoodsBuy</defName>
        <title>测试：食物批发收购</title>
        <category>Open</category>
        <form>Bulk</form>
        <isBuy>true</isBuy>
        <fameReward>10</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <categories>
                        <li>Foods</li>
                    </categories>
                </filter>
                <thingAmount>300~6000</thingAmount>
                <thingPriceCredit>0.5</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- T5'（v2 2026-08-15）：类别模式——PlantFoodRaw（植物生食）类别限定（"纯食物/生食/素食限定"演示；黑白名单已作废——v2 约束禁用 disallowedThingDefs） -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_PlantFood</defName>
        <title>测试：植物生食类别收购</title>
        <category>Internal</category>
        <form>Bulk</form>
        <isBuy>true</isBuy>
        <fameReward>10</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <categories>
                        <li>PlantFoodRaw</li>
                    </categories>
                </filter>
                <thingAmount>300~6000</thingAmount>
                <thingPriceCredit>0.8</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- 仅耐久 >50% 的任意服装+武器：allowedHitPointsPercents 为匹配条件（装填侧校验），AllowedThingDefs 展开 = 全部服装+武器 -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_HpApparelWeapons</defName>
        <title>测试：耐久服装武器出售</title>
        <category>Open</category>
        <form>Scattered</form>
        <isBuy>false</isBuy>
        <fameReward>5</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <categories>
                        <li>Apparel</li>
                    </categories>
                    <allowedHitPointsPercents>0.5~1</allowedHitPointsPercents>
                </filter>
                <thingAmount>1~50</thingAmount>
                <thingPriceCredit>1</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- 保底：validLevel 显式填写（保底亦可留空=全等级豁免，见 MarketGenerator.ValidForLevel）；双 entry 供抽样 2~3 份独立订单；isLockable 忽略 → 预期 Log.Warning -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_Guaranteed</defName>
        <title>测试：保底订单</title>
        <category>Open</category>
        <form>Scattered</form>
        <isBuy>true</isBuy>
        <isGuaranteed>true</isGuaranteed>
        <isLockable>false</isLockable>
        <guaranteedItemCount>2~3</guaranteedItemCount>
        <fameReward>3</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <thingAmount>1~50</thingAmount>
                <thingPriceCredit>1</thingPriceCredit>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <thingAmount>1~50</thingAmount>
                <thingPriceCredit>2</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- 彩蛋测试：前置条件 Credit >= 500（dev 改值触发）+ FD-G35 入池概率（占位 0.15，实测定稿）；v4.11 起并入 Open 池 + letter -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_EasterEgg</defName>
        <title>测试：彩蛋订单</title>
        <category>EasterEgg</category>
        <form>Scattered</form>
        <isBuy>false</isBuy>
        <fameReward>50</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <prerequisiteConditions>
            <li>
                <varName>Credit</varName>
                <Gte>500</Gte>
            </li>
        </prerequisiteConditions>
        <easterEggChance>0.15</easterEggChance>
        <orderDurationInQuadrums>1</orderDurationInQuadrums>
        <includeThings>
            <li>
                <filter>
                    <thingDefs>
                        <li>Chocolate</li>
                    </thingDefs>
                </filter>
                <thingAmount>1~5</thingAmount>
                <thingPriceCredit>10</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- T9 M6-6 突发测试：紧急钢铁收购（叙事者 SingleMTB 随机触发 → 生成即已接取，期限 2 天；介入后逾期按突发倍率 1.0 违约） -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_UrgentBuy</defName>
        <title>测试：紧急钢铁采购</title>
        <category>Urgent</category>
        <form>Bulk</form>
        <isBuy>true</isBuy>
        <fameReward>200</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <thingAmount>600~1200</thingAmount>
                <thingPriceCredit>2</thingPriceCredit>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <!-- ═══ A8 测试资产（2026-09-02）：收购侧品质/材质装填校验——filter 附加约束走装填/结算侧 Allows(Thing) 校验
         （类别模式生成不分配品质快照，展开 = 类别全量候选；allowedQualities 格式 "min~max"（QualityRange.FromString 实证）；
          布材质 StuffCategoryDef 名 = Fabric（v4.6 实证）） ═══ -->
    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_WeaponGoodQualityBuy</defName>
        <title>测试：良好以上武器收购</title>
        <category>Internal</category>
        <form>Scattered</form>
        <isBuy>true</isBuy>
        <fameReward>15</fameReward>
        <validLevel>
            <li>CelesFD_Level_L0</li>
            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <categories>
                        <li>Weapons</li>
                    </categories>
                    <allowedQualities>Good~Legendary</allowedQualities>
                </filter>
                <thingAmount>1~3</thingAmount>
                <thingPriceCredit>25</thingPriceCredit>
                <label>良好以上武器</label>
                <description>星铃外勤部收购品质良好的武器（{thingLabel}，任意种类均可，共 {amount} 件，品质良好及以上）。谢绝劣质货品。</description>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

    <CelesFeature.CelesFD_MarketClassDef>
        <defName>CelesFD_Test_FabricApparelBuy</defName>
        <title>测试：布材质衣物收购</title>
