            <li>CelesFD_Level_L1</li>
        </validLevel>
        <includeThings>
            <li>
                <filter>
                    <categories>
                        <li>Apparel</li>
                    </categories>
                    <stuffCategoriesToAllow>
                        <li>Fabric</li>
                    </stuffCategoriesToAllow>
                </filter>
                <thingAmount>1~30</thingAmount>
                <thingPriceCredit>3</thingPriceCredit>
                <label>布材质衣物</label>
                <description>星铃外勤部收购布制衣物（{thingLabel}，任意种类均可，共 {amount} 件，须为布料材质）。谢绝皮革与金属制品。</description>
            </li>
        </includeThings>
    </CelesFeature.CelesFD_MarketClassDef>

</Defs>
