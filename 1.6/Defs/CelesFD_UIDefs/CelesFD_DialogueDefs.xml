<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- ═══ 测试选项A树（2026-08-25：isRoot 改 false——开局任务链彩蛋树取代默认根树；测试节点保留备用） ═══ -->
    <CelesFeature.CelesFD_DialogueTreeDef>
        <defName>RootTree_TestA</defName>
        <startNode>N_RootA</startNode>
        <isRoot>false</isRoot>
    </CelesFeature.CelesFD_DialogueTreeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_RootA</defName>
        <nodeText>The field department communication system is ready. Communication system log initialization complete. Nothing's written here yet, so you can play this little game.</nodeText>
        <options>
            <li>
                <label>What little game?</label>
                <next>N_RootA_Relay</next>   <!-- 循环回自身 -->
            </li>
            <li>
                <label>Test Dialogue: Little Game</label>
                <recordText>Enter test dialogue</recordText>
                <enterTree>GameTree_Station</enterTree>
            </li>
            <li>
                <label>Debug: Check Status</label>
                <next>N_DebugInspect</next>
            </li>
            <li>
                <label>F2 Test: Resource Comp</label>
                <next>N_F2Test_Menu</next>
            </li>
            <li>
                <label>信标站管理</label>
                <next>N_Beacon_Main</next>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <!-- ═══ F2 测试节点（Resource Comp 验证，验证后可删） ═══ -->
    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_F2Test_Menu</defName>
        <nodeText>F2 Resource Comp 测试菜单。信用额随操作变化。建议先用"设为 10"再测支付。</nodeText>
        <options>
            <li>
                <label>设为 10 信用额（Set 路径）</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_Resource">
                        <resource>Credit</resource>
                        <Set>10</Set>
                    </li>
                </comps>
                <next>N_F2Test_OK</next>
                <failNode>N_F2Test_NoCredit</failNode>
            </li>
            <li>
                <label>获得 10 信用额（测试）</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_Resource">
                        <resource>Credit</resource>
                        <Add>10</Add>
                    </li>
                </comps>
                <next>N_F2Test_OK</next>
                <failNode>N_F2Test_NoCredit</failNode>
            </li>
            <li>
                <label>支付 5 信用额（Add 负值 + checkNeed）</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_Resource">
                        <resource>Credit</resource>
                        <checkNeed>5</checkNeed>
                        <Add>-5</Add>
                    </li>
                </comps>
                <next>N_F2Test_OK</next>
                <failNode>N_F2Test_NoCredit</failNode>
            </li>
            <li>
                <label>动态选项测试（插值 + 注入）</label>
                <next>N_F2Test_Dynamic</next>
            </li>
            <li>
                <label>返回根树</label>
                <next>N_RootA</next>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <!-- ═══ P0b 测试节点：nodeText 插值 + 动态选项注入（验证后可删） ═══ -->
    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_F2Test_Dynamic</defName>
        <nodeText>动态选项测试：当前 {beaconCount}/3 个信标站。下方为动态注入的站列表。</nodeText>
        <entryComps>
            <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_TestList" />
        </entryComps>
        <options>
            <li><label>返回测试菜单</label><next>N_F2Test_Menu</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_F2Test_OK</defName>
        <nodeText>操作成功，信用额已更新。</nodeText>
        <options>
            <li><label>返回测试菜单</label><next>N_F2Test_Menu</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_F2Test_NoCredit</defName>
        <nodeText>信用额不足，操作被拒绝。</nodeText>
        <options>
            <li><label>返回测试菜单</label><next>N_F2Test_Menu</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_RootA_Relay</defName>
        <nodeText>This little game!</nodeText>
        <options>
            <li>
                <label>What little game?</label>
                <next>N_RootA_Relay</next>   <!-- 循环回自身 -->
            </li>
            <li>
                <label>Test Dialogue: Little Game</label>
                <recordText>Enter test dialogue</recordText>
                <enterTree>GameTree_Station</enterTree>
            </li>
            <li>
                <label>Debug: F*** you!</label>
                <next>N_RootA_02</next>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_RootA_02</defName>
        <nodeText>Why are you so mean?</nodeText>
        <options>
            <li>
                <label>Continue</label>
                <next>N_RootA</next>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <!-- ═══ 调试预留节点：进入时 dev message（D3/D4/D6 实现） ═══ -->
    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_DebugInspect</defName>
        <nodeText>Debug state inspection.</nodeText>
        <options>
            <li>
                <label>Return</label>
                <next>N_RootA</next>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <!-- ═══ 信标站管理树（P1：查看/申请/放弃） ═══ -->
    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_Main</defName>
        <nodeText>信标站管理。您可以查看现有信标站或申请新信标站。</nodeText>
        <options>
            <li>
                <label>查看信标站 / 申请放弃</label>
                <next>N_Beacon_List</next>
            </li>
            <li>
                <label>申请新信标站（5 信用额）</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconRequest">
                        <creditCost>5</creditCost>
                    </li>
                </comps>
                <next>N_Beacon_RequestOK</next>
                <failNode>N_Beacon_RequestFail</failNode>
            </li>
            <li>
                <!-- 2026-08-25：返回主树选项层（原指向 N_RootA 测试树——测试树禁用后脱节） -->
                <label>返回主菜单</label>
                <next>N_Main_Options</next>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_List</defName>
        <nodeText>当前 {beaconCount}/3 个信标站。本清单列出所有信标站，选中特定信标站申请放弃。</nodeText>
        <entryComps>
            <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconList" />
        </entryComps>
        <options>
            <li><label>返回主菜单</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_Confirm</defName>
        <nodeText>确认放弃 {beaconTargetName}？</nodeText>
        <entryComps>
            <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconConfirmEntry" />
        </entryComps>
        <options>
            <li>
                <label>确认放弃</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconAbandon" />
                </comps>
                <next>N_Beacon_AbandonOK</next>
                <failNode>N_Beacon_List</failNode>
            </li>
            <li><label>返回清单</label><next>N_Beacon_List</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_RequestOK</defName>
        <nodeText>申请成功，星铃外勤部已在远处建立新信标站。</nodeText>
        <options>
            <li><label>返回主菜单</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_RequestFail</defName>
        <nodeText>申请被拒绝：信用额不足、名额已满或无法找到合适位置。</nodeText>
        <options>
            <li><label>返回主菜单</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_AbandonOK</defName>
        <nodeText>信标站已被放弃。</nodeText>
        <options>
            <li><label>返回主菜单</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>
</Defs>