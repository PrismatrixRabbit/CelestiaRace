        <nodeText>{RULEPACK:CelesFD_IntroTree:r_main_secret}</nodeText>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Main_HangUp</defName>
        <nodeText>……通讯已挂断……</nodeText>
        <options>
            <li>
                <label>登出</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_CloseWindow" />
                </comps>
                <next>N_Main_HangUp</next>
                <failNode>N_Main_HangUp</failNode>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <!-- ========== 信标站管理对话树 ========== -->

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_Main</defName>
        <nodeText>【系统消息】这里是信标站管理。您可以查看现有信标站或申请新信标站。</nodeText>
        <options>
            <li>
                <label>查看信标站 / 申请放弃</label>
                <next>N_Beacon_List</next>
            </li>
            <li>
                <label>申请新信标站（5 信用额）</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconRequest">
                        <creditCost>5</creditCost>
                    </li>
                </comps>
                <next>N_Beacon_RequestOK</next>
                <failNode>N_Beacon_RequestFail</failNode>
            </li>
            <li>
                <label>返回通讯</label>
                <next>N_Main_Options</next>
            </li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_List</defName>
        <nodeText>【系统消息】当前 {beaconCount}/3 个信标站。本清单列出所有信标站，选中特定信标站申请放弃。</nodeText>
        <entryComps>
            <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconList" />
        </entryComps>
        <options>
            <li><label>返回上级</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_Confirm</defName>
        <nodeText>【系统消息】确认放弃 {beaconTargetName}？</nodeText>
        <entryComps>
            <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconConfirmEntry" />
        </entryComps>
        <options>
            <li>
                <label>确认放弃</label>
                <comps>
                    <li Class="CelesFeature.CelesFD_DialogueActionCompProperties_BeaconAbandon" />
                </comps>
                <next>N_Beacon_AbandonOK</next>
                <failNode>N_Beacon_List</failNode>
            </li>
            <li><label>返回上级</label><next>N_Beacon_List</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_RequestOK</defName>
        <nodeText>【系统消息】申请成功，星铃外勤部已在远处建立新信标站。</nodeText>
        <options>
            <li><label>返回上级</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_RequestFail</defName>
        <nodeText>【系统消息】申请被拒绝：信用额不足、名额已满或无法找到合适位置。</nodeText>
        <options>
            <li><label>返回上级</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>

    <CelesFeature.CelesFD_DialogueNodeDef>
        <defName>N_Beacon_AbandonOK</defName>
        <nodeText>【系统消息】信标站已被放弃。</nodeText>
        <options>
            <li><label>返回上级</label><next>N_Beacon_Main</next></li>
        </options>
    </CelesFeature.CelesFD_DialogueNodeDef>
    
</Defs>
