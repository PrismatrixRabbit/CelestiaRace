<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StorytellerDef[@Name="BaseStoryteller"]/comps</xpath>
        <value>
            <!-- 2026-08-25 开局任务链：信标站第 7 天 SingleMTB 移除——改由"首建发信器"监听触发（GameComponent.TryCheckFirstAntenna → def.Worker.TryExecute） -->
            <li Class="StorytellerCompProperties_SingleMTB">
                <!-- 开局任务链事件 1：轨道晶体坠落——mtbDays≈0 每 interval 必触发候选；"第 7 天后"由 IncidentDef.earliestDay 控制；
                 "全局一次"由 Worker 执行体自查 GameComponent.CrystalEventTriggered 控制（2026-09-20 修正：minRefireDays 按地图
                 记录且 forced 派发不写——玩家环境叙事者倍率 mod 连发实证；mtb 必中设计下单靠 CanFireNow 闸不免疫 forced） -->
                <mtbDays>0.001</mtbDays>
                <incident>CelesFD_InitialCrystalOrbitDrop</incident>
                <allowedTargetTags>
                    <li>Map_PlayerHome</li>
                </allowedTargetTags>
            </li>
            <li Class="StorytellerCompProperties_SingleMTB">
                <!-- M6-6 突发订单：mtbDays=20 时间随机触发（天然兼容 dev 快进；Worker 内防重复/上限判定；mtbDays 建议值可调）。
                     FD-G33 修正版（2026-09-02）：allowedTargetTags 同步 World→Map_PlayerHome（与 IncidentDef targetTags
                     配对，晶体坠落同款模式；Def 侧 World 标签违反独占约束已移除） -->
                <mtbDays>20</mtbDays>
                <incident>CelesFD_UrgentOrderSignal</incident>
                <allowedTargetTags>
                    <li>Map_PlayerHome</li>
                </allowedTargetTags>
            </li>
        </value>
    </Operation>
</Patch>
