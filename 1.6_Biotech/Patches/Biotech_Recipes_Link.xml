<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- b 模型配方→建筑 recipes 条件链接：
         本文件位于条件目录（LoadFolders IfModActive=Biotech）——
         Biotech 未激活时本 patch 不加载＝锻炉 recipes 无悬空引用；
         激活时给三座纳米锻炉的 recipes 追加 b 两配方（测试配方，随测试资产清除作业移除）。 -->
    <Operation Class="PatchOperationAdd">
        <xpath>//ThingDef[defName="Celes_NanoForgeShaper" or defName="Celes_NanoForgeForger" or defName="Celes_NanoForgeConstructor"]/recipes</xpath>
        <value>
            <li>Celes_AutoRecipe_MakeMechTest</li>
            <li>Celes_AutoRecipe_MakeMechCleaner</li>
        </value>
    </Operation>
</Patch>
