<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ═══ 批 5 U2：机械体 body（2026-10-01）═══
         Celes_MechCleaner_Body = Biotech Mech_Light 拓扑拷贝（无臂轻机械——操作能力由
         ThoraxCanManipulate 承担；腿位换自建驱动/履带机构两件，其余 part 全引 Core）
         Celes_MechTest_Body = Core Lancer 拓扑拷贝（人形双臂；三目=3×SightSensor 同 def
         以 customLabel 区分——实例级标签先例 Bodies_Mechanoid.xml left sight sensor）-->
    <BodyDef>
        <defName>Celes_MechCleaner_Body</defName>
        <label>Celes_MechCleaner_Body</label>
        <corePart>
            <def>MechanicalThoraxCanManipulate</def>
            <height>Middle</height>
            <depth>Outside</depth>
            <groups>
                <li>Torso</li>
            </groups>
            <parts>
                <li>
                    <def>MechanicalNeck</def>
                    <coverage>0.10</coverage>
                    <height>Top</height>
                    <parts>
                        <li>
                            <def>MechanicalHead</def>
                            <coverage>0.80</coverage>
                            <groups>
                                <li>HeadAttackTool</li>
                            </groups>
                            <parts>
                                <li>
                                    <def>ArtificialBrain</def>
                                    <coverage>0.10</coverage>
                                    <depth>Inside</depth>
                                </li>
                                <li>
                                    <def>SightSensor</def>
                                    <coverage>0.13</coverage>
                                </li>
                                <li>
                                    <def>HearingSensor</def>
                                    <coverage>0.10</coverage>
                                </li>
                                <li>
                                    <def>SmellSensor</def>
                                    <coverage>0.10</coverage>
                                </li>
                            </parts>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>Celes_MechanicalDriveUnit</def>
                    <customLabel>左驱动机构</customLabel>
                    <coverage>0.2</coverage>
                    <height>Bottom</height>
                    <parts>
                        <li>
                            <def>Celes_MechanicalTrackUnit</def>
                            <customLabel>左履带机构</customLabel>
                            <coverage>0.2</coverage>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>Celes_MechanicalDriveUnit</def>
                    <customLabel>右驱动机构</customLabel>
                    <coverage>0.2</coverage>
                    <height>Bottom</height>
                    <parts>
                        <li>
                            <def>Celes_MechanicalTrackUnit</def>
                            <customLabel>右履带机构</customLabel>
                            <coverage>0.2</coverage>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>Reactor</def>
                    <coverage>0.06</coverage>
                    <depth>Inside</depth>
                </li>
                <li>
                    <def>FluidReprocessor</def>
                    <coverage>0.04</coverage>
                    <depth>Inside</depth>
                </li>
            </parts>
        </corePart>
    </BodyDef>

    <BodyDef>
        <defName>Celes_MechTest_Body</defName>
        <label>Celes_MechTest_Body</label>
        <corePart>
            <def>MechanicalThorax</def>
            <height>Middle</height>
            <depth>Outside</depth>
            <parts>
                <li>
                    <def>MechanicalNeck</def>
                    <coverage>0.10</coverage>
                    <height>Top</height>
                    <parts>
                        <li>
                            <def>MechanicalHead</def>
                            <coverage>0.80</coverage>
                            <groups>
                                <li>HeadAttackTool</li>
                            </groups>
                            <parts>
                                <li>
                                    <def>ArtificialBrain</def>
                                    <coverage>0.10</coverage>
                                    <depth>Inside</depth>
                                </li>
                                <li>
                                    <def>SightSensor</def>
                                    <customLabel>主视觉传感器</customLabel>
                                    <coverage>0.13</coverage>
                                </li>
                                <li>
                                    <def>SightSensor</def>
                                    <customLabel>左副视觉传感器</customLabel>
                                    <coverage>0.13</coverage>
                                </li>
                                <li>
                                    <def>SightSensor</def>
                                    <customLabel>右副视觉传感器</customLabel>
                                    <coverage>0.13</coverage>
                                </li>
                                <li>
                                    <def>HearingSensor</def>
                                    <customLabel>左听觉传感器</customLabel>
                                    <coverage>0.10</coverage>
                                </li>
                                <li>
                                    <def>HearingSensor</def>
                                    <customLabel>右听觉传感器</customLabel>
                                    <coverage>0.10</coverage>
                                </li>
                                <li>
                                    <def>SmellSensor</def>
                                    <coverage>0.10</coverage>
                                </li>
                            </parts>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>MechanicalShoulder</def>
                    <customLabel>左机械肩</customLabel>
                    <coverage>0.17</coverage>
                    <parts>
                        <li>
                            <def>MechanicalArm</def>
                            <customLabel>左臂</customLabel>
                            <coverage>0.85</coverage>
                            <parts>
                                <li>
                                    <def>MechanicalHand</def>
                                    <customLabel>左手</customLabel>
                                    <coverage>0.2</coverage>
                                    <height>Bottom</height>
                                    <parts>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>左小指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>LeftHand</li>
                                            </groups>
                                        </li>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>左中指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>LeftHand</li>
                                                <li>MiddleFingers</li>
                                            </groups>
                                        </li>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>左食指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>LeftHand</li>
                                            </groups>
                                        </li>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>左拇指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>LeftHand</li>
                                            </groups>
                                        </li>
                                    </parts>
                                </li>
                            </parts>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>MechanicalShoulder</def>
                    <customLabel>右机械肩</customLabel>
                    <coverage>0.17</coverage>
                    <parts>
                        <li>
                            <def>MechanicalArm</def>
                            <customLabel>右臂</customLabel>
                            <coverage>0.85</coverage>
                            <parts>
                                <li>
                                    <def>MechanicalHand</def>
                                    <customLabel>右手</customLabel>
                                    <coverage>0.2</coverage>
                                    <height>Bottom</height>
                                    <parts>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>右小指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>RightHand</li>
                                            </groups>
                                        </li>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>右中指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>RightHand</li>
                                                <li>MiddleFingers</li>
                                            </groups>
                                        </li>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>右食指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>RightHand</li>
                                            </groups>
                                        </li>
                                        <li>
                                            <def>MechanicalFinger</def>
                                            <customLabel>右拇指</customLabel>
                                            <coverage>0.15</coverage>
                                            <groups>
                                                <li>RightHand</li>
                                            </groups>
                                        </li>
                                    </parts>
                                </li>
                            </parts>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>MechanicalLeg</def>
                    <customLabel>左腿</customLabel>
                    <coverage>0.2</coverage>
                    <height>Bottom</height>
                    <parts>
                        <li>
                            <def>MechanicalFoot</def>
                            <customLabel>左脚</customLabel>
                            <coverage>0.2</coverage>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>MechanicalLeg</def>
                    <customLabel>右腿</customLabel>
                    <coverage>0.2</coverage>
                    <height>Bottom</height>
                    <parts>
                        <li>
                            <def>MechanicalFoot</def>
                            <customLabel>右脚</customLabel>
                            <coverage>0.2</coverage>
                        </li>
                    </parts>
                </li>
                <li>
                    <def>Reactor</def>
                    <coverage>0.06</coverage>
                    <depth>Inside</depth>
                </li>
                <li>
                    <def>FluidReprocessor</def>
                    <coverage>0.04</coverage>
                    <depth>Inside</depth>
                </li>
            </parts>
        </corePart>
    </BodyDef>
</Defs>
